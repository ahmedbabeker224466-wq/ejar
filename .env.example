# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
# Port the Express server listens on (cPanel usually sets this for you).
PORT=3000
# Public base URL of the site, without a trailing slash, e.g. https://aqdi.sa
APP_URL=
# "production" on the live server, "development" locally.
NODE_ENV=development

# --- MySQL ---
# Database host, usually localhost on cPanel.
DB_HOST=localhost
# Database port, usually 3306.
DB_PORT=3306
# Database user created in cPanel > MySQL Databases.
DB_USER=
# Password for that database user.
DB_PASSWORD=
# Database name created in cPanel > MySQL Databases.
DB_NAME=

# --- Security ---
# Long random string used to sign login tokens (JWT). 64+ random characters.
JWT_SECRET=
# 32-byte key (64 hex characters) used to encrypt secrets stored in the database.
SECRET_BOX_KEY=
# Shared secret that cron-triggered URLs must send, so outsiders cannot run jobs.
CRON_SECRET=
# Saudi mobile number of the platform admin, e.g. +9665XXXXXXXX.
PLATFORM_ADMIN_PHONE=

# --- SMS (login codes and reminders) ---
# Name of the SMS provider in use.
SMS_PROVIDER=
# API key for that SMS provider.
SMS_API_KEY=
# Registered sender name shown on the recipient's phone.
SMS_SENDER=

# --- Email (SMTP) ---
# SMTP server host, e.g. mail.yourdomain.sa
SMTP_HOST=
# SMTP port, usually 465 (SSL) or 587 (STARTTLS).
SMTP_PORT=465
# SMTP login user.
SMTP_USER=
# SMTP login password.
SMTP_PASSWORD=
# From address shown on emails, e.g. "عقدي <no-reply@yourdomain.sa>"
SMTP_FROM=

# --- WhatsApp Business (Meta Cloud API) ---
# Permanent access token for the WhatsApp Business account.
WHATSAPP_TOKEN=
# Phone number ID of the sending WhatsApp number.
WHATSAPP_PHONE_ID=

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Moyasar (subscription payments) ---
# Secret key, used on the server only.
MOYASAR_SECRET_KEY=
# Publishable key, safe to use in the payment form.
MOYASAR_PUBLISHABLE_KEY=

# --- Claude API (reads dates and amounts from uploaded contracts) ---
# API key from the Anthropic Console.
CLAUDE_API_KEY=
# Model used to read contracts, e.g. claude-sonnet-5
CLAUDE_MODEL=

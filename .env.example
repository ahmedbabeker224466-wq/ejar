# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
# Port the Express server listens on (cPanel usually sets this for you).
PORT=3000
# Public base URL of the site, without a trailing slash, e.g. https://aqdi.sa
APP_URL=
# "production" on the live server, "development" locally.
NODE_ENV=development

# --- MySQL ---
# Database host, usually localhost on cPanel.
DB_HOST=localhost
# Database port, usually 3306.
DB_PORT=3306
# Database user created in cPanel > MySQL Databases.
DB_USER=
# Password for that database user.
DB_PASSWORD=
# Database name created in cPanel > MySQL Databases.
DB_NAME=
# Optional, local development only: a separate, empty database used by
# `npm test` for database tests. Leave empty on the server; never point it at
# the real database.
TEST_DB_NAME=

# --- Security ---
# Long random string used to sign login tokens (JWT). 64+ random characters.
JWT_SECRET=
# 32-byte key (64 hex characters) used to encrypt secrets stored in the database.
SECRET_BOX_KEY=
# Shared secret that cron-triggered URLs must send (header X-Cron-Secret), so
# outsiders cannot run jobs: POST /cron/run/<job>. Long random string.
CRON_SECRET=
# "false" turns the built-in scheduler off in this process (use it when cPanel
# Cron Jobs call /cron/run instead). Empty or anything else: scheduler on.
RUN_CRON=
# Saudi mobile number of the platform admin, e.g. 05XXXXXXXX. Signing in with
# this number gives the platform_admin role (and requires 2FA setup).
PLATFORM_ADMIN_PHONE=
# TESTING ONLY, never set in production. "false" lets platform_admin sign in
# with the phone code alone (no authenticator app) when NODE_ENV is not
# production. Defaults to "true". In production "false" is ignored and the
# startup self-check logs an error.
REQUIRE_ADMIN_2FA=true

# --- Uploaded photos (maintenance requests) ---
# Folder where re-encoded photos are stored. MUST be outside the public folder
# and writable by the app. Empty = <app folder>/storage/uploads.
UPLOAD_DIR=

# --- SMS (login codes and reminders) ---
# console | unifonic | msegat. "console" prints each message (with the code)
# to the app log instead of sending it: for testing only. Left empty, it is
# used automatically in development and nothing is sent in production.
SMS_PROVIDER=
# API key: the AppSid for Unifonic, the API key for Msegat.
SMS_API_KEY=
# Registered sender name shown on the recipient's phone.
SMS_SENDER=
# Msegat only: the account user name.
SMS_USERNAME=

# --- Email reminders (SMTP) ---
# Leave SMTP_HOST or MAIL_FROM empty to turn email off (emails are skipped).
# SMTP server host, e.g. mail.yourdomain.sa
SMTP_HOST=
# SMTP port, usually 465 (SSL) or 587 (STARTTLS).
SMTP_PORT=465
# SMTP login user.
SMTP_USER=
# SMTP login password. (The older name SMTP_PASSWORD also works.)
SMTP_PASS=
# From address shown on emails, e.g. "عقدي <no-reply@yourdomain.sa>".
# (The older name SMTP_FROM also works.)
MAIL_FROM=

# --- WhatsApp and Telegram ---
# Not set here: each office enters its own WhatsApp Cloud API and Telegram bot
# settings in the app (Office > Settings > Reminders); they are stored
# encrypted with SECRET_BOX_KEY.

# --- Moyasar (subscription payments, TEST MODE ONLY for now) ---
# Use Moyasar TEST keys (sk_test_... / pk_test_...). Live keys (sk_live_...)
# are refused unless MOYASAR_ALLOW_LIVE=1; do not set that before the invoicing
# entity is decided. With the keys missing the payment page says "الدفع
# الإلكتروني غير مفعّل" and bank transfer still works.
# Secret key, used on the server only. Never printed, logged or sent to the browser.
MOYASAR_SECRET_KEY=
# Publishable key, sent to the browser for Moyasar's hosted payment form.
MOYASAR_PUBLISHABLE_KEY=
# A long random value. Put the same value in Moyasar's webhook settings as the
# secret token; the webhook URL is <APP_URL>/webhooks/moyasar. Empty = webhook off.
MOYASAR_WEBHOOK_SECRET=

# --- Claude API (reads ONLY dates and amounts from an uploaded contract) ---
# API key from the Anthropic Console. Leave empty to turn AI reading off; the
# app then shows a message and contracts are entered by hand.
CLAUDE_API_KEY=
# Model used to read contracts. Empty means claude-sonnet-4-5.
CLAUDE_MODEL=

# --- Backups and monitoring ---
# Folder for the encrypted daily database backups (aqdi-YYYYMMDD-HHmm.sql.gz.enc).
# MUST be outside the public folder; the app creates it with mode 0700.
# Empty = ./backups next to the app (kept out of git by .gitignore).
BACKUP_DIR=
# Optional: https URL that receives a small JSON { ok, size, sha256, filename, at }
# after every backup (never the file) so an outside monitor can watch it.
BACKUP_WEBHOOK_URL=
# Optional: https URL of an uptime monitor ("heartbeat"); fetched after every
# healthy 15-minute health check.
HEALTHCHECK_PING_URL=
# The SMS balance (units) below which the platform admin is warned, once a day.
# Empty = 100. Only providers that report a balance are checked.
SMS_BALANCE_WARN=

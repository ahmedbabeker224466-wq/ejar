<div class="page-head"><h1><%= __(lead ? __('بيانات العميل') : __('عميل جديد')) %></h1><a class="btn btn--secondary btn--small" href="/office/leads"><%= dir === 'rtl' ? '→' : '←' %> <%= __("العملاء المحتملون") %></a></div>
<% if (locals.message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>
<% if (lead) { %>
  <section class="card">
    <p><%= __("المرحلة الحالية:") %> <strong><%= __(lead.stageLabel) %></strong></p>
    <div class="ld-stages">
      <% Object.entries(stages).forEach(function ([key, label]) { if (key === lead.stage) return; %>
        <form method="post" action="/office/leads/<%= __(lead.id) %>/stage"><input type="hidden" name="stage" value="<%= __(key) %>"><input type="hidden" name="back" value="lead"><button type="submit" class="btn btn--small <%= __(key === 'won' ? 'btn--success' : key === 'lost' ? 'btn--danger' : 'btn--secondary') %>"><%= __(label) %></button></form>
      <% }) %>
    </div>
    <% if (lead.stage === 'awaiting_ejar' || lead.stage === 'won') { %><p class="muted"><%= __("بعد توثيق العقد في منصة إيجار، أضفه من") %> <a href="/office/contracts/new"><%= __("عقد جديد") %></a>.</p><% } %>
  </section>
<% } %>
<form class="card form-card" method="post" action="<%= __(action) %>" novalidate>
  <div class="field"><label for="label"><%= __("ماذا يبحث عنه؟") %></label><input id="label" name="label" class="input" maxlength="<%= __(limits.label) %>" value="<%= __(values.label) %>" placeholder="<%= __("شقة 3 غرف في حي الملقا") %>" required><% if (errors.label) { %><p class="field-error"><%= __(errors.label) %></p><% } %></div>
  <div class="form-grid">
    <div class="field"><label for="contact_label"><%= __("الاسم أو اللقب (اختياري)") %></label><input id="contact_label" name="contact_label" class="input" maxlength="<%= __(limits.contact) %>" value="<%= __(values.contact_label) %>"><% if (errors.contact_label) { %><p class="field-error"><%= __(errors.contact_label) %></p><% } %></div>
    <div class="field"><label for="phone"><%= __("الجوال (اختياري)") %></label><input id="phone" name="phone" class="input" type="tel" inputmode="tel" dir="ltr" maxlength="20" value="<%= __(values.phone) %>"><% if (errors.phone) { %><p class="field-error"><%= __(errors.phone) %></p><% } %></div>
    <div class="field"><label for="source"><%= __("المصدر") %></label><select id="source" name="source" class="select"><% Object.entries(sources).forEach(function ([k, v]) { %><option value="<%= __(k) %>" <%= __(values.source === k ? 'selected' : '') %>><%= __(v) %></option><% }) %></select></div>
    <div class="field"><label for="budget"><%= __("الميزانية السنوية (ريال، اختياري)") %></label><input id="budget" name="budget" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.budget) %>"><% if (errors.budget) { %><p class="field-error"><%= __(errors.budget) %></p><% } %></div>
    <div class="field"><label for="next_date"><%= __("موعد المتابعة القادم") %></label><input id="next_date" name="next_date" class="input" type="date" value="<%= __(values.next_date) %>"><% if (errors.next_date) { %><p class="field-error"><%= __(errors.next_date) %></p><% } %></div>
    <div class="field"><label for="assignee"><%= __("المسؤول") %></label><select id="assignee" name="assignee" class="select"><option value=""><%= __("بلا مسؤول") %></option><% members.forEach(function (m) { %><option value="<%= __(m.user_id) %>" <%= __(String(values.assignee) === String(m.user_id) ? 'selected' : '') %>><%= __(m.display) %></option><% }) %></select><% if (errors.assignee) { %><p class="field-error"><%= __(errors.assignee) %></p><% } %></div>
  </div>
  <div class="field"><label for="unit_id"><%= __("الوحدة المقترحة (اختياري)") %></label><select id="unit_id" name="unit_id" class="select"><option value=""><%= __("بلا وحدة") %></option><% units.forEach(function (u) { %><option value="<%= __(u.id) %>" <%= __(String(values.unit_id) === String(u.id) ? 'selected' : '') %>><%= __(u.label) %><%= __(u.status === 'vacant' ? __(' (شاغرة)') : '') %></option><% }) %></select><% if (errors.unit_id) { %><p class="field-error"><%= __(errors.unit_id) %></p><% } %></div>
  <div class="field"><label for="note"><%= __("ملاحظات (اختياري)") %></label><textarea id="note" name="note" class="textarea" rows="3" maxlength="<%= __(limits.note) %>"><%= __(values.note) %></textarea><p class="muted ac-hint"><%= __("لا تكتب رقم الهوية أو أرقام الحسابات.") %></p><% if (errors.note) { %><p class="field-error"><%= __(errors.note) %></p><% } %></div>
  <button type="submit" class="btn btn--primary btn--block"><%= __(lead ? __('حفظ التعديلات') : __('إضافة العميل')) %></button>
</form>

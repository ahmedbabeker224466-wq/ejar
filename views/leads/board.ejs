<div class="page-head ac-head">
  <div><h1>العملاء المحتملون</h1><p class="muted">من أول استفسار حتى توثيق العقد في منصة إيجار.</p></div>
  <div class="ac-actions"><a class="btn btn--primary" href="/office/leads/new">+ عميل جديد</a></div>
</div>
<% if (message) { %><div class="flash flash--success" role="status"><%= message %></div><% } %>
<p class="button-row ld-filters">
  <a class="btn btn--secondary btn--small" href="/office/leads<%= mine ? '' : '?mine=1' %>"><%= mine ? 'كل العملاء' : 'عملائي فقط' %></a>
  <a class="btn btn--secondary btn--small" href="/office/leads<%= showLost ? '' : '?lost=1' %>"><%= showLost ? 'إخفاء غير المكتملة' : `غير المكتملة (${lostCount})` %></a>
</p>
<div class="ld-board">
  <% shownStages.forEach(function (stage) { const items = columns[stage]; %>
    <section class="ld-col ld-col--<%= stage %>" aria-labelledby="col-<%= stage %>">
      <h2 id="col-<%= stage %>"><%= stages[stage] %> <span><%= items.length %></span></h2>
      <% if (items.length === 0) { %><p class="ld-empty">لا يوجد</p><% } %>
      <% items.forEach(function (l) { %>
        <article class="ld-card">
          <a class="ld-card__title" href="/office/leads/<%= l.id %>"><%= l.label %></a>
          <p class="ld-card__meta"><%= l.sourceLabel %><% if (l.contactLabel) { %> · <%= l.contactLabel %><% } %></p>
          <div class="ld-card__row">
            <% if (l.next) { %><span class="<%= l.due ? 'ld-due' : 'muted' %>">المتابعة <span dir="ltr"><%= l.next %></span></span><% } else { %><span class="muted"><%= l.assigneeLabel || 'بلا مسؤول' %></span><% } %>
            <% if (l.budget) { %><strong class="ac-num"><%= fmt(l.budget) %></strong><% } %>
          </div>
          <% const order = ['new', 'contacted', 'viewing', 'awaiting_ejar', 'won']; const i = order.indexOf(stage); %>
          <% if (i >= 0 && i < 4) { %>
            <form method="post" action="/office/leads/<%= l.id %>/stage" class="ld-move">
              <input type="hidden" name="stage" value="<%= order[i + 1] %>">
              <button type="submit" class="btn btn--secondary btn--small">نقل إلى: <%= stages[order[i + 1]] %> ←</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% }) %>
</div>

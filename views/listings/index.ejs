<div class="page-head"><h1><%= __("الإعلانات العامة") %></h1><a href="/office/listings/new" class="btn btn--primary btn--small"><%= __("إعلان جديد") %></a></div>
<p class="muted"><%= __("الإعلان صفحة عامة يراها أي زائر: النوع والمدينة والحي والمواصفات والإيجار والصور فقط. لا يظهر رقم جوال ولا اسم ولا عنوان؛ يتواصل الزائر معك من خلال نموذج الاستفسار.") %></p>
<nav class="tabs" aria-label="<%= __("التصفية") %>">
  <a href="/office/listings" <%- status === '' ? 'aria-current="page"' : '' %>><%= __("الكل") %></a>
  <% ['draft', 'published', 'hidden', 'rented'].forEach(function (s) { %>
    <a href="/office/listings?status=<%= __(s) %>" <%- status === s ? 'aria-current="page"' : '' %>><%= __(statusLabels[s]) %></a>
  <% }) %>
</nav>
<ul class="item-list">
  <% rows.forEach(function (l) { %>
    <li class="item">
      <div class="item__title"><a href="/office/listings/<%= __(l.id) %>"><strong><%= __(l.title) %></strong></a>
        <span class="badge badge--listing-<%= __(l.status) %>"><%= __(statusLabels[l.status]) %></span>
        <% if (l.adminHidden) { %><span class="badge badge--bill-danger"><%= __("أخفته الإدارة") %></span><% } %></div>
      <div class="item__meta"><%= __(fmt(l.price)) %> <%= __("ريال سنوياً") %> · <%= __("صور") %> <%= __(l.photoCount) %> · <%= __("استفسارات") %> <%= __(l.inquiryCount) %>
        <% if (l.status === 'published') { %> · <%= __("ينتهي") %> <span dir="ltr"><%= __(stamp(l.expiresAt)) %></span><% } %></div>
    </li>
  <% }) %>
</ul>
<% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد إعلانات بعد. اختر وحدة شاغرة وأنشئ إعلاناً.") %></p><% } %>

<p class="back-link"><a href="/office/listings"><%= dir === 'rtl' ? '→' : '←' %> <%= __("الإعلانات") %></a></p>
<div class="page-head"><h1><%= __(listing.title) %></h1>
  <span class="badge badge--listing-<%= __(listing.status) %>"><%= __(statusLabels[listing.status]) %></span></div>
<% if (notice) { %><div class="flash flash--<%= __(notice[0]) %>" role="status"><%= __(notice[1]) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>
<% if (listing.adminHidden) { %><div class="flash flash--danger" role="alert"><%= __("أخفت إدارة المنصة هذا الإعلان") %><%= __(listing.adminHiddenReason ? ': ' + listing.adminHiddenReason : '') %>. <%= __("لا يمكن نشره مرة أخرى.") %></div><% } %>
<% if (listing.status === 'rented') { %><div class="flash flash--info"><%= __("الوحدة مؤجرة، فالإعلان مخفي. يعود مسودة عندما تُصبح الوحدة شاغرة.") %></div><% } %>

<section class="card detail-card">
  <h2><%= __("الحالة") %></h2>
  <% if (listing.status === 'published') { %>
    <p><%= __("منشور حتى") %> <strong dir="ltr"><%= __(stamp(listing.expiresAt)) %></strong> (<%= __("يُخفى تلقائياً بعد") %> <%= __(days) %> <%= __("يوماً ما لم تجدده).") %></p>
    <p><a href="<%= __(publicPath) %>" target="_blank" rel="noopener noreferrer"><%= __("عرض الصفحة العامة") %></a></p>
  <% } %>
  <div class="button-row">
    <% if (listing.status === 'draft' || listing.status === 'hidden') { %>
      <form method="post" action="/office/listings/<%= __(listing.id) %>/publish"><button type="submit" class="btn btn--primary"><%= __(listing.status === 'hidden' ? __('نشر مرة أخرى') : __('نشر الإعلان')) %></button></form>
    <% } %>
    <% if (listing.status === 'published') { %>
      <form method="post" action="/office/listings/<%= __(listing.id) %>/renew"><button type="submit" class="btn btn--primary"><%= __("تجديد") %> <%= __(days) %> <%= __("يوماً") %></button></form>
      <form method="post" action="/office/listings/<%= __(listing.id) %>/hide"><button type="submit" class="btn btn--secondary"><%= __("إخفاء") %></button></form>
    <% } %>
  </div>
  <p class="muted"><%= __("للنشر: الإيجار والحي ووصف قصير وصورة واحدة على الأقل، والوحدة شاغرة.") %></p>
</section>

<% if (listing.status !== 'rented') { %>
<form method="post" action="/office/listings/<%= __(listing.id) %>" class="form-card" novalidate>
  <h2><%= __("بيانات الإعلان (تظهر للعموم)") %></h2>
  <div class="form-grid">
    <div class="field"><label for="unit_type"><%= __("نوع العقار") %></label>
      <select id="unit_type" name="unit_type" class="select">
        <% Object.keys(types).forEach(function (t) { %><option value="<%= __(t) %>" <%= __(values.unit_type === t ? 'selected' : '') %>><%= __(types[t]) %></option><% }) %>
      </select><% if (errors.unit_type) { %><p class="field-error"><%= __(errors.unit_type) %></p><% } %></div>
    <div class="field"><label for="city"><%= __("المدينة") %></label>
      <select id="city" name="city" class="select" data-hood-city>
        <% cities.forEach(function (c) { %><option value="<%= __(c) %>" <%= __(values.city === c ? 'selected' : '') %>><%= __(c) %></option><% }) %>
      </select><% if (errors.city) { %><p class="field-error"><%= __(errors.city) %></p><% } %></div>
    <div class="field"><label for="neighborhood"><%= __("الحي") %></label>
      <select id="neighborhood" name="neighborhood" class="select" data-hood-select>
        <option value=""><%= __("اختر الحي") %></option>
        <% cities.forEach(function (c) { var list = (byCity[c] || []).concat([other]); %>
          <optgroup label="<%= __(c) %>" data-city="<%= __(c) %>">
            <% list.forEach(function (n) { %><option value="<%= __(n) %>" <%= __(values.city === c && values.neighborhood === n ? 'selected' : '') %>><%= __(n) %></option><% }) %>
          </optgroup>
        <% }) %>
      </select><% if (errors.neighborhood) { %><p class="field-error"><%= __(errors.neighborhood) %></p><% } %></div>
    <div class="field"><label for="price"><%= __("الإيجار السنوي (ريال)") %></label>
      <input id="price" name="price" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.price) %>">
      <% if (errors.price) { %><p class="field-error"><%= __(errors.price) %></p><% } %></div>
    <div class="field"><label for="rooms"><%= __("الغرف") %></label><input id="rooms" name="rooms" class="input" inputmode="numeric" dir="ltr" maxlength="2" value="<%= __(values.rooms) %>">
      <% if (errors.rooms) { %><p class="field-error"><%= __(errors.rooms) %></p><% } %></div>
    <div class="field"><label for="bathrooms"><%= __("دورات المياه") %></label><input id="bathrooms" name="bathrooms" class="input" inputmode="numeric" dir="ltr" maxlength="2" value="<%= __(values.bathrooms) %>">
      <% if (errors.bathrooms) { %><p class="field-error"><%= __(errors.bathrooms) %></p><% } %></div>
    <div class="field"><label for="area_sqm"><%= __("المساحة (م") %>²)</label><input id="area_sqm" name="area_sqm" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.area_sqm) %>">
      <% if (errors.area_sqm) { %><p class="field-error"><%= __(errors.area_sqm) %></p><% } %></div>
  </div>
  <fieldset class="checks"><legend><%= __("المزايا") %></legend>
    <div class="checks__grid">
      <% Object.keys(featureLabels).forEach(function (f) { %><label class="check"><input type="checkbox" name="features" value="<%= __(f) %>" <%= __(values.features.indexOf(f) >= 0 ? 'checked' : '') %>> <%= __(featureLabels[f]) %></label><% }) %>
    </div>
    <% if (errors.features) { %><p class="field-error"><%= __(errors.features) %></p><% } %></fieldset>
  <div class="field"><label for="description"><%= __("وصف قصير (حتى 800 حرف)") %></label>
    <textarea id="description" name="description" class="textarea" rows="5" maxlength="800"><%= __(values.description) %></textarea>
    <p class="field-hint"><%= __("لا تكتب أرقام هواتف أو روابط أو حسابات؛ سيصلك الاستفسار من نموذج التواصل.") %></p>
    <% if (errors.description) { %><p class="field-error"><%= __(errors.description) %></p><% } %></div>
  <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("حفظ") %></button>
</form>

<section class="card detail-card" id="photos">
  <h2><%= __("الصور") %> (<%= __(photos.length) %> <%= __("من") %> <%= __(maxPhotos) %>)</h2>
  <p class="muted"><%= __("تُحفظ الصور بعد حذف بيانات الموقع والكاميرا منها، وبحجم لا يتجاوز 1600 بكسل. الحد 5 ميجابايت للصورة.") %></p>
  <% if (photos.length) { %>
    <ul class="photo-manager">
      <% photos.forEach(function (p, i) { %>
        <li class="photo-manager__item">
          <img src="/office/listings/<%= __(listing.id) %>/photos/<%= __(p.id) %>/thumb" alt="<%= __("صورة") %> <%= __(i + 1) %>" width="160" height="120" loading="lazy">
          <div class="button-row">
            <% if (p.isCover) { %><span class="badge badge--bill-success"><%= __("الغلاف") %></span><% } else { %>
              <form method="post" action="/office/listings/<%= __(listing.id) %>/photos/<%= __(p.id) %>/cover"><button type="submit" class="btn btn--secondary btn--small"><%= __("اجعلها الغلاف") %></button></form><% } %>
            <% if (i > 0) { %><form method="post" action="/office/listings/<%= __(listing.id) %>/photos/<%= __(p.id) %>/up"><button type="submit" class="btn btn--secondary btn--small" aria-label="<%= __("تقديم") %>">↑</button></form><% } %>
            <% if (i < photos.length - 1) { %><form method="post" action="/office/listings/<%= __(listing.id) %>/photos/<%= __(p.id) %>/down"><button type="submit" class="btn btn--secondary btn--small" aria-label="<%= __("تأخير") %>">↓</button></form><% } %>
            <form method="post" action="/office/listings/<%= __(listing.id) %>/photos/<%= __(p.id) %>/delete"><button type="submit" class="btn btn--danger btn--small"><%= __("حذف") %></button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% if (photos.length < maxPhotos) { %>
    <form method="post" action="/office/listings/<%= __(listing.id) %>/photos" enctype="multipart/form-data" novalidate>
      <div class="field"><label for="photos-input"><%= __("إضافة صور") %></label>
        <input id="photos-input" name="photos" class="input input--file" type="file" multiple accept="image/jpeg,image/png,image/webp"></div>
      <button type="submit" class="btn btn--primary"><%= __("رفع") %></button>
    </form>
  <% } %>
</section>

<section class="card detail-card" id="inquiries">
  <h2><%= __("الاستفسارات") %> (<%= __(inquiries.length) %>)</h2>
  <p class="muted"><%= __("بيانات الزائر له وحده، وتُحذف تلقائياً بعد 90 يوماً.") %></p>
  <ul class="item-list">
    <% inquiries.forEach(function (q) { %>
      <li class="item">
        <div class="item__title"><strong><%= __(q.name || __('زائر')) %></strong> <span class="badge badge--role"><%= __(inquiryStatuses[q.status]) %></span></div>
        <div class="item__meta"><% if (q.phone) { %><span dir="ltr"><%= __(q.phone) %></span><% } %> <% if (q.email) { %><span dir="ltr"><%= __(q.email) %></span><% } %> · <span dir="ltr"><%= __(stamp(q.created_at)) %></span></div>
        <% if (q.message) { %><p class="pre-line"><%= __(q.message) %></p><% } %>
        <form method="post" action="/office/listings/<%= __(listing.id) %>/inquiries/<%= __(q.id) %>/status" class="inline-form">
          <label class="visually-hidden" for="st-<%= __(q.id) %>"><%= __("الحالة") %></label>
          <select id="st-<%= __(q.id) %>" name="status" class="select">
            <% Object.keys(inquiryStatuses).forEach(function (s) { %><option value="<%= __(s) %>" <%= __(q.status === s ? 'selected' : '') %>><%= __(inquiryStatuses[s]) %></option><% }) %>
          </select>
          <button type="submit" class="btn btn--secondary btn--small"><%= __("تحديث") %></button>
        </form>
        <% if (can('leads')) { %><form method="post" action="/office/leads/from-inquiry/<%= __(q.id) %>" class="inline-form"><button type="submit" class="btn btn--secondary btn--small"><%= __("إضافة إلى العملاء المحتملين") %></button></form><% } %>
      </li>
    <% }) %>
  </ul>
  <% if (!inquiries.length) { %><p class="empty-state"><%= __("لا توجد استفسارات بعد.") %></p><% } %>
</section>
<% } %>

<section class="card detail-card">
  <details class="danger-zone"><summary><%= __("حذف الإعلان") %></summary>
    <form method="post" action="/office/listings/<%= __(listing.id) %>/delete"><p class="muted"><%= __("يُحذف الإعلان وصوره واستفساراته نهائياً.") %></p><button type="submit" class="btn btn--danger"><%= __("حذف") %></button></form></details>
</section>
<script src="<%= assetUrl('/js/listingForm.js') %>" defer></script>

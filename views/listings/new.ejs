<p class="back-link"><a href="/office/listings"><%= dir === 'rtl' ? '→' : '←' %> <%= __("الإعلانات") %></a></p>
<div class="page-head"><h1><%= __("إعلان جديد") %></h1></div>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>
<% if (units.length) { %>
  <form method="post" action="/office/listings" class="form-card" novalidate>
    <div class="field">
      <label for="unit_id"><%= __("الوحدة الشاغرة") %></label>
      <select id="unit_id" name="unit_id" class="select" required>
        <option value=""><%= __("اختر الوحدة") %></option>
        <% units.forEach(function (u) { %><option value="<%= __(u.id) %>" <%= __(String(u.id) === unitId ? 'selected' : '') %>><%= __(u.label) %> — <%= __(types[u.unit_type] || __('عقار')) %> — <%= __(u.city) %></option><% }) %>
      </select>
      <p class="field-hint"><%= __("اسم الوحدة يظهر لك فقط ولا يظهر في الإعلان العام.") %></p>
    </div>
    <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("إنشاء مسودة") %></button>
  </form>
<% } else { %>
  <p class="empty-state"><%= __("لا توجد وحدات شاغرة بدون إعلان. أضف وحدة من") %> <a href="/office/units/new"><%= __("العقارات والوحدات") %></a>.</p>
<% } %>

<p class="back-link"><a href="/notifications<%= locals.areaAs ? '?as=' + areaAs : '' %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("الإشعارات") %></a></p>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>
<% if (errors.contact) { %><div class="flash flash--danger" role="alert"><%= __(errors.contact) %></div><% } %>

<section class="card form-card">
  <h1><%= __("إعدادات الإشعارات") %></h1>
  <p class="muted"><%= __("تصلك التذكيرات دائماً هنا في الموقع. اختر القنوات الأخرى التي تريدها.") %></p>
  <form method="post" action="/settings/notifications<%= locals.areaAs ? '?as=' + areaAs : '' %>" novalidate>
    <fieldset class="field">
      <legend><%= __("القنوات") %></legend>
      <label class="check"><input type="checkbox" checked disabled> <%= __("الموقع (دائماً)") %></label>
      <label class="check"><input type="checkbox" name="email" value="1" <%= __(values.channels.email ? 'checked' : '') %>> <%= __("البريد الإلكتروني") %></label>
      <label class="check"><input type="checkbox" name="whatsapp" value="1" <%= __(values.channels.whatsapp ? 'checked' : '') %>> <%= __("واتساب") %></label>
      <label class="check"><input type="checkbox" name="telegram" value="1" <%= __(values.channels.telegram ? 'checked' : '') %>> <%= __("تيليجرام") %></label>
    </fieldset>
    <div class="field">
      <label for="email"><%= __("البريد الإلكتروني (اختياري)") %></label>
      <input id="email" name="email" class="input" type="email" dir="ltr" maxlength="190" value="<%= __(values.email) %>" <%= __(errors.email ? 'aria-invalid=true' : '') %>>
      <% if (errors.email) { %><p class="field-error"><%= __(errors.email) %></p><% } %>
    </div>
    <fieldset class="field">
      <legend><%= __("أوقات الهدوء (بتوقيت الرياض)") %></legend>
      <p class="field-hint"><%= __("لا نرسل رسائل غير عاجلة في هذه الأوقات، وتصلك عند انتهائها.") %></p>
      <div class="form-grid">
        <div class="field">
          <label for="quiet_start"><%= __("من") %></label>
          <select id="quiet_start" name="quiet_start" class="select" dir="ltr">
            <% hours.forEach(function (h) { %><option value="<%= __(h) %>" <%= __(values.quietStart === h ? 'selected' : '') %>><%= __(h) %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="quiet_end"><%= __("إلى") %></label>
          <select id="quiet_end" name="quiet_end" class="select" dir="ltr">
            <% hours.forEach(function (h) { %><option value="<%= __(h) %>" <%= __(values.quietEnd === h ? 'selected' : '') %>><%= __(h) %></option><% }) %>
          </select>
        </div>
      </div>
      <% if (errors.quiet) { %><p class="field-error"><%= __(errors.quiet) %></p><% } %>
    </fieldset>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("حفظ") %></button>
  </form>
</section>

<section class="card form-card" id="whatsapp">
  <h2><%= __("رقم واتساب") %></h2>
  <% if (errors.whatsapp) { %><div class="flash flash--danger" role="alert"><%= __(errors.whatsapp) %></div><% } %>
  <% if (contacts.whatsapp) { %>
    <p><%= __("الرقم المؤكد:") %> <strong dir="ltr"><%= __(contacts.whatsapp) %></strong> <span class="badge badge--link-joined"><%= __("مؤكد") %> ✓</span></p>
    <form method="post" action="/settings/notifications/whatsapp/remove<%= locals.areaAs ? '?as=' + areaAs : '' %>"><button type="submit" class="btn btn--secondary btn--block"><%= __("حذف الرقم") %></button></form>
  <% } else { %>
    <% if (contacts.loginPhone) { %>
      <p><%= __("رقم دخولك:") %> <strong dir="ltr"><%= __(contacts.loginPhone) %></strong></p>
      <form method="post" action="/settings/notifications/whatsapp/login-phone<%= locals.areaAs ? '?as=' + areaAs : '' %>"><button type="submit" class="btn btn--primary btn--block"><%= __("استخدم رقم الدخول لواتساب") %></button></form>
    <% } else { %>
      <p class="muted"><%= __("لا يوجد رقم جوال في حسابك. أضف رقم واتساب من «استخدام رقم آخر».") %></p>
    <% } %>
  <% } %>
  <% if (whatsappStep) { %>
    <form method="post" action="/settings/notifications/whatsapp/verify<%= locals.areaAs ? '?as=' + areaAs : '' %>" novalidate>
      <div class="field">
        <label for="wa-code"><%= __("رمز التأكيد المرسل إلى") %> <span dir="ltr"><%= __(contacts.whatsappPending) %></span></label>
        <input id="wa-code" name="code" class="input input--code" type="text" inputmode="numeric" dir="ltr" maxlength="6" autocomplete="one-time-code" autofocus>
      </div>
      <button type="submit" class="btn btn--primary btn--block"><%= __("تأكيد الرقم") %></button>
    </form>
  <% } else { %>
    <details class="payment__edit">
      <summary><%= __("استخدام رقم آخر") %></summary>
      <form method="post" action="/settings/notifications/whatsapp/change<%= locals.areaAs ? '?as=' + areaAs : '' %>" novalidate>
        <div class="field">
          <label for="wa-phone"><%= __("رقم الجوال") %></label>
          <input id="wa-phone" name="phone" class="input" type="tel" inputmode="numeric" dir="ltr" maxlength="14" placeholder="05XXXXXXXX">
          <p class="field-hint"><%= __("نرسل رمز تأكيد برسالة نصية إلى هذا الرقم.") %></p>
        </div>
        <button type="submit" class="btn btn--secondary btn--block"><%= __("أرسل رمز التأكيد") %></button>
      </form>
    </details>
  <% } %>
</section>

<section class="card form-card" id="telegram">
  <h2><%= __("تيليجرام") %></h2>
  <% if (contacts.telegramLinked) { %>
    <p><span class="badge badge--link-joined"><%= __("مربوط") %> ✓</span></p>
    <form method="post" action="/settings/notifications/telegram/unlink<%= locals.areaAs ? '?as=' + areaAs : '' %>"><button type="submit" class="btn btn--secondary btn--block"><%= __("إلغاء الربط") %></button></form>
  <% } else if (telegramCode) { %>
    <p><%= __("رمز الربط (صالح لمدة") %> <%= __(codeMinutes) %> <%= __("دقيقة):") %></p>
    <div class="invite-code"><output id="tg-code" dir="ltr"><%= __(telegramCode) %></output></div>
    <ol class="channel-steps">
      <li><%= __("افتح بوت مكتبك في تيليجرام") %><% if (bots.length) { %>: <% bots.forEach(function (b, i) { %><a href="https://t.me/<%= __(b) %>?start=<%= __(telegramCode) %>" dir="ltr" target="_blank" rel="noopener noreferrer">@<%= __(b) %></a><%= __(i < bots.length - 1 ? __('، ') : '') %><% }) %><% } %>.</li>
      <li><%= __("اضغط «ابدأ» (Start). إذا فتحت الرابط أعلاه يُرسل الرمز تلقائياً، وإلا فأرسل الرمز في المحادثة كما هو.") %></li>
      <li><%= __("يرد البوت: «تم ربط حسابك». ثم حدّث هذه الصفحة لترى «مربوط") %> ✓».</li>
    </ol>
  <% } else { %>
    <p><%= __("الحالة:") %> <span class="badge badge--link-not_invited"><%= __("غير مربوط") %></span></p>
    <% if (!bots.length) { %>
      <p class="muted"><%= __("لم يضبط مكتبك بوت تيليجرام بعد. يضبطه مالك المكتب أو المدير من «إعدادات التذكيرات».") %></p>
    <% } else { %>
      <p><%= __("بوت مكتبك:") %> <% bots.forEach(function (b, i) { %><a href="https://t.me/<%= __(b) %>" dir="ltr" target="_blank" rel="noopener noreferrer">@<%= __(b) %></a><%= __(i < bots.length - 1 ? __('، ') : '') %><% }) %></p>
      <ol class="channel-steps">
        <li><%= __("اضغط «أظهر رمز الربط» بالأسفل.") %></li>
        <li><%= __("افتح بوت المكتب واضغط «ابدأ» (Start)، ثم أرسل الرمز.") %></li>
        <li><%= __("حدّث هذه الصفحة بعد رد البوت.") %></li>
      </ol>
    <% } %>
    <form method="post" action="/settings/notifications/telegram/code<%= locals.areaAs ? '?as=' + areaAs : '' %>"><button type="submit" class="btn btn--primary btn--block"><%= __("أظهر رمز الربط") %></button></form>
  <% } %>
</section>

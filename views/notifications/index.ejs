<p class="back-link"><a href="<%= __(home) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("الرجوع") %></a></p>
<section class="card detail-card">
  <div class="page-head">
    <h1><%= __("الإشعارات") %></h1>
    <% if (!locals.base) { %><a href="/settings/notifications" class="btn btn--secondary btn--small"><%= __("الإعدادات") %></a><% } %>
  </div>

  <form method="get" action="<%= locals.base || '' %>/notifications" class="filter-bar">
    <label for="kind" class="visually-hidden"><%= __("نوع الإشعار") %></label>
    <select id="kind" name="kind" class="select">
      <option value=""><%= __("كل الأنواع") %></option>
      <% Object.entries(kindLabels).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(kind === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
    </select>
    <button type="submit" class="btn btn--secondary"><%= __("عرض") %></button>
  </form>

  <% if (rows.some(function (n) { return !n.read_at; })) { %>
    <form method="post" action="<%= locals.base || '' %>/notifications/read-all">
      <input type="hidden" name="back" value="<%= __(back) %>">
      <button type="submit" class="btn btn--secondary btn--block"><%= __("تعليم الكل كمقروء") %></button>
    </form>
  <% } %>

  <% if (rows.length) { %>
    <ul class="item-list">
      <% rows.forEach(function (n) { %>
        <li class="note<%= __(n.read_at ? '' : ' note--unread') %>" id="n-<%= __(n.id) %>">
          <p class="note__title"><%= __(n.title) %><% if (!n.read_at) { %> <span class="badge badge--soon"><%= __("جديد") %></span><% } %></p>
          <p class="note__body"><%= __(n.body) %></p>
          <div class="note__actions">
            <span class="muted" dir="ltr"><%= __(n.at) %></span>
            <% if (n.link) { %>
              <form method="post" action="<%= locals.base || '' %>/notifications/<%= __(n.id) %>/open"><button type="submit" class="btn btn--primary btn--small"><%= __("فتح") %></button></form>
            <% } %>
            <% if (!n.read_at) { %>
              <form method="post" action="<%= locals.base || '' %>/notifications/<%= __(n.id) %>/read">
                <input type="hidden" name="back" value="<%= __(back) %>">
                <button type="submit" class="btn btn--secondary btn--small"><%= __("تعليم كمقروء") %></button>
              </form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
    <% if (pages > 1) { %>
      <nav class="pager" aria-label="<%= __("الصفحات") %>">
        <% if (prevUrl) { %><a href="<%= __(prevUrl) %>" class="btn btn--secondary"><%= __("السابق") %></a><% } %>
        <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
        <% if (nextUrl) { %><a href="<%= __(nextUrl) %>" class="btn btn--secondary"><%= __("التالي") %></a><% } %>
      </nav>
    <% } %>
  <% } else { %>
    <p class="empty-state"><%= __(kind ? __('لا توجد إشعارات من هذا النوع.') : __('لا توجد إشعارات بعد. ستظهر هنا تذكيرات المواعيد والدفعات.')) %></p>
  <% } %>
</section>

<%- include('../partials/area-nav') %>
<p class="back-link"><a href="<%= __(listUrl) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("كل الطلبات") %></a></p>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card detail-card">
  <div class="page-head">
    <h1><%= __(request.unit_label || __('وحدة')) %> · <%= __(request.categoryLabel) %></h1>
    <span class="badge badge--maint-<%= __(request.status) %>"><%= __(request.statusLabel) %></span>
  </div>
  <% const steps = ['new', 'seen', 'in_progress', 'done']; const at = request.status === 'rejected' ? -1 : steps.indexOf(request.status); %>
  <% if (request.status === 'rejected') { %>
    <p class="flash flash--warning"><%= __("اعتذر المكتب عن تنفيذ هذا الطلب. يمكنك الاستفسار في الردود.") %></p>
  <% } else { %>
    <ol class="mt-steps" aria-label="<%= __("مراحل الطلب") %>">
      <% steps.forEach(function (st, i) { %>
        <li class="mt-steps__item<%= i < at ? ' is-done' : i === at ? ' is-current' : '' %>"><span class="mt-steps__dot" aria-hidden="true"><% if (i < at || (i === at && st === 'done')) { %><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg><% } else { %><%= i + 1 %><% } %></span><span class="mt-steps__label"><%= __({ new: 'استُلم الطلب', seen: 'اطّلع عليه المكتب', in_progress: 'قيد التنفيذ', done: 'تم الإنجاز' }[st]) %></span></li>
      <% }) %>
    </ol>
  <% } %>
  <% if (kind === 'tenant' && request.status === 'done') { %>
    <div class="mt-rate">
      <% if (request.tenant_rating) { %>
        <p class="mt-rate__done"><%= __("تقييمك للخدمة") %>: <span class="mt-rate__stars" aria-label="<%= __(request.tenant_rating) %> <%= __("من 5") %>"><%= '★'.repeat(request.tenant_rating) %><span class="mt-rate__off"><%= '★'.repeat(5 - request.tenant_rating) %></span></span></p>
      <% } else { %>
        <form method="post" action="<%= __(base) %>/rate" class="mt-rate__form">
          <p class="mt-rate__q"><%= __("كيف كانت خدمة الصيانة؟") %></p>
          <div class="mt-rate__btns">
            <% [5, 4, 3, 2, 1].forEach(function (n) { %><button type="submit" name="rating" value="<%= n %>" class="mt-rate__btn" title="<%= n %> <%= __("من 5") %>"><%= '★'.repeat(n) %></button><% }) %>
          </div>
        </form>
      <% } %>
    </div>
  <% } %>
  <dl class="details">
    <% if (request.building_name) { %><dt><%= __("المبنى") %></dt><dd><%= __(request.building_name) %></dd><% } %>
    <dt><%= __("الأولوية") %></dt><dd><%= __(request.priorityLabel) %></dd>
    <dt><%= __("تاريخ الطلب") %></dt><dd dir="ltr"><%= __(createdAt) %></dd>
    <% if (changedAt) { %><dt><%= __("آخر تغيير للحالة") %></dt><dd dir="ltr"><%= __(changedAt) %></dd><% } %>
    <% if (kind === 'office') { %><dt><%= __("المسؤول") %></dt><dd><%= __(request.assigneeLabel || __('غير محدد')) %></dd><% } %>
    <% if (kind === 'office' && request.vendor_name) { %><dt><%= __("الفني") %></dt><dd><%= __(request.vendor_name) %> · <%= __(tradeLabels[request.vendor_trade] || '') %> · <a href="tel:<%= vendorPhone %>" dir="ltr"><%= vendorPhone %></a></dd><% } %>
    <% if (kind !== 'office' && request.assigned_vendor_id) { %><dt><%= __("الفني") %></dt><dd><%= __("تم تعيين فني للطلب") %></dd><% } %>
    <% if (kind === 'office' && request.tenant_rating) { %><dt><%= __("تقييم المستأجر") %></dt><dd><%= request.tenant_rating %> <%= __("من 5") %></dd><% } %>
  </dl>
  <h2><%= __("الوصف") %></h2>
  <p class="pre-line"><%= __(request.description) %></p>
  <% if (photos.length) { %>
    <h2><%= __("الصور") %></h2>
    <ul class="photo-grid">
      <% photos.forEach(function (ph, i) { %>
        <li><a href="/maintenance/photos/<%= __(ph.id) %>" target="_blank" rel="noopener"><img src="/maintenance/photos/<%= __(ph.id) %>" alt="<%= __("صورة مرفقة") %> <%= __(i + 1) %>" loading="lazy" width="160" height="160"></a></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (kind === 'office') { %>
  <section class="card detail-card">
    <h2><%= __("إدارة الطلب") %></h2>
    <% if (nextStatuses.length) { %>
      <form method="post" action="<%= __(base) %>/status" class="button-row">
        <% nextStatuses.forEach(function (s) { %>
          <button type="submit" name="status" value="<%= __(s) %>" class="btn <%= __(s === 'rejected' ? 'btn--secondary' : 'btn--primary') %>"><%= __({ seen: __('تمت المشاهدة'), in_progress: __('بدء التنفيذ'), done: __('تم الإنجاز'), rejected: __('رفض الطلب') }[s]) %></button>
        <% }) %>
      </form>
    <% } else { %>
      <p class="muted"><%= __("أُغلق الطلب.") %></p>
    <% } %>
    <form method="post" action="<%= __(base) %>/assign">
      <div class="field">
        <label for="assignee"><%= __("إسناد إلى عضو من الفريق") %></label>
        <select id="assignee" name="assignee" class="select">
          <option value=""><%= __("بدون مسؤول") %></option>
          <% members.forEach(function (m) { %><option value="<%= __(m.user_id) %>" <%= __(Number(request.assigned_to) === m.user_id ? 'selected' : '') %>><%= __(m.display) %> (<%= __(m.roleLabel) %>)</option><% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn--secondary btn--block"><%= __("حفظ الإسناد") %></button>
    </form>
    <form method="post" action="<%= __(base) %>/vendor">
      <div class="field">
        <label for="vendor"><%= __("الفني المنفذ") %></label>
        <select id="vendor" name="vendor" class="select">
          <option value=""><%= __("بدون فني") %></option>
          <% vendorList.forEach(function (v) { %><option value="<%= __(v.id) %>" <%= __(Number(request.assigned_vendor_id) === Number(v.id) ? 'selected' : '') %>><%= __(v.name) %> (<%= __(v.tradeLabel) %>)</option><% }) %>
        </select>
        <p class="field-hint"><%= __("أضف الفنيين وأرقامهم من") %> <a href="/office/vendors"><%= __("صفحة الفنيين") %></a>. <%= __("رقم الفني لا يظهر للمستأجر أو المالك.") %></p>
      </div>
      <button type="submit" class="btn btn--secondary btn--block"><%= __("حفظ الفني") %></button>
    </form>
  </section>
<% } %>

<section class="card detail-card" id="thread">
  <h2><%= __("الردود") %></h2>
  <% if (messages.length) { %>
    <ul class="thread">
      <% messages.forEach(function (m) { %>
        <li class="thread__item thread__item--<%= __(m.visibility) %>">
          <p class="thread__head"><strong><%= __(m.author) %></strong> <span class="muted" dir="ltr"><%= __(m.at) %></span>
            <% if (m.visibility === 'internal') { %><span class="badge badge--soon"><%= __("داخلي") %></span><% } else if (m.visibility === 'landlord') { %><span class="badge badge--calm"><%= __("المالك والمكتب") %></span><% } %>
          </p>
          <p class="pre-line"><%= __(m.body) %></p>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="empty-state"><%= __("لا توجد ردود بعد.") %></p>
  <% } %>
  <form method="post" action="<%= __(base) %>/messages" novalidate>
    <div class="field">
      <label for="body"><%= __(kind === 'landlord' ? __('تعليق') : __('رد')) %></label>
      <textarea id="body" name="body" class="textarea" rows="3" maxlength="<%= __(limits.message) %>" required></textarea>
      <p class="field-hint"><%= __("حتى") %> <%= __(limits.message) %> <%= __("حرف، نص فقط.") %><%= __(kind === 'landlord' ? __(' يراه المكتب فقط.') : '') %></p>
    </div>
    <% if (kind === 'office') { %>
      <div class="field">
        <label for="visibility"><%= __("نوع الرد") %></label>
        <select id="visibility" name="visibility" class="select">
          <% Object.entries(visibility).forEach(function ([key, label]) { %><option value="<%= __(key) %>"><%= __(label) %></option><% }) %>
        </select>
      </div>
    <% } %>
    <button type="submit" class="btn btn--primary btn--block"><%= __("إرسال") %></button>
  </form>
</section>

<section class="auth card">
  <h1><%= __("تفعيل التحقق بخطوتين") %></h1>
  <p class="lead"><%= __("حساب إدارة المنصة يحتاج خطوة حماية إضافية. تستغرق دقيقتين مرة واحدة فقط.") %></p>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= __(error) %></div>
  <% } %>

  <ol class="steps">
    <li><%= __("ثبّت تطبيق مصادقة في جوالك، مثل Google Authenticator أو Microsoft Authenticator.") %></li>
    <li>
      <%= __("من نفس الجوال اضغط الزر التالي لإضافة الحساب إلى التطبيق:") %>
      <a href="<%= __(uri) %>" class="btn btn--secondary btn--block"><%= __("إضافة الحساب إلى تطبيق المصادقة") %></a>
    </li>
    <li>
      <%= __("أو أدخل هذا المفتاح يدوياً في التطبيق:") %>
      <code class="secret" dir="ltr"><%= __(secretGroups.join(' ')) %></code>
    </li>
    <li><%= __("اكتب الرمز المكوّن من 6 أرقام الظاهر في التطبيق:") %></li>
  </ol>

  <form method="post" action="/login/2fa/setup" novalidate>
    <div class="field">
      <label for="code"><%= __("الرمز من التطبيق") %></label>
      <input
        id="code"
        name="code"
        class="input input--code"
        type="text"
        dir="ltr"
        inputmode="numeric"
        autocomplete="one-time-code"
        maxlength="6"
        required
      >
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("تفعيل") %></button>
  </form>
</section>

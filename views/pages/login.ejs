<div class="auth-split">
<section class="auth card">
  <div class="auth__icon" aria-hidden="true">
    <%- include('../partials/brand-mark', { bid: 'a' }) %>
  </div>
  <h1><%= __(heading) %></h1>
  <p class="lead"><%= __(lead) %></p>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= __(error) %></div>
  <% } %>

  <form method="post" action="/login" novalidate>
    <input type="hidden" name="intent" value="<%= __(intent) %>">
    <% if (locals.next) { %><input type="hidden" name="next" value="<%= __(next) %>"><% } %>
    <div class="field">
      <label for="phone"><%= __("رقم الجوال") %></label>
      <div class="phone-field" dir="ltr">
        <span class="phone-field__prefix" aria-hidden="true">+966</span>
        <input
          id="phone"
          name="phone"
          class="phone-field__input"
          type="tel"
          inputmode="numeric"
          autocomplete="tel-national"
          maxlength="14"
          placeholder="5X XXX XXXX"
          value="<%= __(phone) %>"
          aria-describedby="phone-hint"
          <%= __(error ? 'aria-invalid=true' : '') %>
          autofocus
          required
        >
      </div>
      <p id="phone-hint" class="field-hint"><%= __("مثال: 512345678") %></p>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("أرسل رمز الدخول") %></button>
  </form>

  <div class="auth__divider"><span><%= __("أو") %></span></div>
  <% if (intent === 'register') { %>
    <a href="/login" class="btn btn--outline btn--block"><%= __("لديك حساب؟ سجّل الدخول") %></a>
  <% } else { %>
    <a href="/register" class="btn btn--outline btn--block"><%= __("مكتب عقار جديد؟ سجّل مكتبك") %></a>
  <% } %>
</section>
<%- include('../partials/auth-art') %>
</div>

<section class="auth card">
  <h1><%= heading %></h1>
  <p class="lead"><%= lead %></p>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/login" novalidate>
    <input type="hidden" name="intent" value="<%= intent %>">
    <div class="field">
      <label for="phone">رقم الجوال</label>
      <div class="phone-field" dir="ltr">
        <span class="phone-field__prefix" aria-hidden="true">+966</span>
        <input
          id="phone"
          name="phone"
          class="phone-field__input"
          type="tel"
          inputmode="numeric"
          autocomplete="tel-national"
          maxlength="14"
          placeholder="5X XXX XXXX"
          value="<%= phone %>"
          aria-describedby="phone-hint"
          <%= error ? 'aria-invalid=true' : '' %>
          autofocus
          required
        >
      </div>
      <p id="phone-hint" class="field-hint">مثال: 512345678</p>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large">أرسل رمز الدخول</button>
  </form>

  <p class="auth__link">
    <% if (intent === 'register') { %>
      لديك حساب؟ <a href="/login">سجّل الدخول</a>
    <% } else { %>
      مكتب عقار جديد؟ <a href="/register">سجّل مكتبك</a>
    <% } %>
  </p>
</section>

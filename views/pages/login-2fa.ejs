<section class="auth card">
  <h1><%= __("التحقق بخطوتين") %></h1>
  <p class="lead"><%= __("افتح تطبيق المصادقة في جوالك واكتب الرمز المكوّن من 6 أرقام.") %></p>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= __(error) %></div>
  <% } %>

  <form method="post" action="/login/2fa" novalidate>
    <div class="field">
      <label for="code"><%= __("الرمز") %></label>
      <input
        id="code"
        name="code"
        class="input input--code"
        type="text"
        dir="ltr"
        inputmode="numeric"
        autocomplete="one-time-code"
        maxlength="12"
        aria-describedby="code-hint"
        autofocus
        required
      >
      <p id="code-hint" class="field-hint"><%= __("لا تستطيع الوصول للتطبيق؟ اكتب أحد رموز الاحتياط بدلاً منه.") %></p>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("تأكيد") %></button>
  </form>

  <p class="auth__link"><a href="/login"><%= __("البدء من جديد") %></a></p>
</section>

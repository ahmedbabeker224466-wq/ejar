<section class="auth card">
  <h1><%= heading %></h1>
  <p class="lead"><%= lead %></p>
  <div class="flash flash--warning" role="note">هذه نسخة تجريبية: الدخول بالبريد الإلكتروني فقط وبدون رمز تحقق.</div>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/login/email" novalidate>
    <input type="hidden" name="intent" value="<%= intent %>">
    <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
    <div class="field">
      <label for="email">البريد الإلكتروني</label>
      <input
        id="email"
        name="email"
        class="input"
        type="email"
        dir="ltr"
        inputmode="email"
        autocomplete="email"
        maxlength="190"
        placeholder="name@example.com"
        value="<%= email %>"
        aria-describedby="email-hint"
        <%= error ? 'aria-invalid=true' : '' %>
        autofocus
        required
      >
      <p id="email-hint" class="field-hint">مثال: name@example.com</p>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= button %></button>
  </form>

  <p class="auth__link">
    <% if (intent === 'register') { %>
      لديك حساب؟ <a href="/login">سجّل الدخول</a>
    <% } else { %>
      مكتب عقار جديد؟ <a href="/register">سجّل مكتبك</a>
    <% } %>
  </p>
  <% if (intent === 'login') { %>
    <p class="auth__link muted"><a href="/login?method=phone">دخول مدير المنصة</a></p>
  <% } %>
</section>

<section class="auth card">
  <div class="auth__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m9 15 2 2 4-4"/></svg>
  </div>
  <h1><%= heading %></h1>
  <p class="lead"><%= lead %></p>
  <p class="auth__note" role="note">نسخة تجريبية: الدخول بالبريد الإلكتروني دون رمز تحقق.</p>

  <% if (error) { %>
    <div class="flash flash--danger" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/login/email" novalidate>
    <input type="hidden" name="intent" value="<%= intent %>">
    <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
    <div class="field">
      <label for="email">البريد الإلكتروني</label>
      <input
        id="email"
        name="email"
        class="input"
        type="email"
        dir="ltr"
        inputmode="email"
        autocomplete="email"
        maxlength="190"
        placeholder="name@example.com"
        value="<%= email %>"
        aria-describedby="email-hint"
        <%= error ? 'aria-invalid=true' : '' %>
        autofocus
        required
      >
      <p id="email-hint" class="field-hint">مثال: name@example.com</p>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= button %></button>
  </form>

  <div class="auth__divider"><span>أو</span></div>
  <% if (intent === 'register') { %>
    <a href="/login" class="btn btn--outline btn--block">لديك حساب؟ سجّل الدخول</a>
  <% } else { %>
    <a href="/register" class="btn btn--outline btn--block">مكتب عقار جديد؟ سجّل مكتبك</a>
  <% } %>
  <% if (intent === 'login') { %>
    <p class="auth__admin"><a href="/login?method=phone">دخول مدير المنصة</a></p>
  <% } %>
</section>

<div class="page-head"><h1><%= __("الفريق") %></h1></div>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card detail-card">
  <h2><%= __("الأعضاء") %></h2>
  <% if (usage.limit !== null) { %><p class="muted"><%= __("حد الباقة:") %> <%= __(usage.current) %> <%= __("من") %> <%= __(usage.limit) %> <%= __("عضو فعّال.") %></p><% } %>
  <ul class="item-list">
    <% members.forEach(function (m) { %>
      <li class="item<%= __(m.is_active ? '' : ' item--inactive') %>">
        <div class="item__title">
          <strong><%= __(m.display) %></strong>
          <span class="badge badge--role"><%= __(m.roleLabel) %></span>
          <% if (!m.is_active) { %><span class="badge badge--ended"><%= __("موقوف") %></span><% } %>
        </div>
        <% if (m.manageable) { %>
          <div class="button-row">
            <% if (m.is_active) { %>
              <% if (canChangeRoles) { %>
                <form method="post" action="/office/team/<%= __(m.member_id) %>/role" class="inline-form">
                  <label class="visually-hidden" for="role-<%= __(m.member_id) %>"><%= __("الدور") %></label>
                  <select id="role-<%= __(m.member_id) %>" name="role" class="select">
                    <% assignable.forEach(function (r) { %><option value="<%= __(r) %>" <%= __(m.role === r ? 'selected' : '') %>><%= __(roleLabels[r]) %></option><% }) %>
                  </select>
                  <button type="submit" class="btn btn--secondary btn--small"><%= __("تغيير الدور") %></button>
                </form>
              <% } %>
              <form method="post" action="/office/team/<%= __(m.member_id) %>/deactivate"><button type="submit" class="btn btn--danger btn--small"><%= __("إيقاف") %></button></form>
            <% } else { %>
              <form method="post" action="/office/team/<%= __(m.member_id) %>/activate"><button type="submit" class="btn btn--primary btn--small"><%= __("إعادة تفعيل") %></button></form>
            <% } %>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>

<section class="card detail-card" id="invites">
  <h2><%= __("دعوة عضو جديد") %></h2>
  <p class="muted"><%= __("اكتب رقم جوال الشخص أو بريده. نعطيك رمزاً يعمل لهذا الرقم أو البريد فقط؛ يدخل به من صفحة") %> "<%= __("الانضمام برمز") %>" <%= __("بعد تسجيل الدخول.") %></p>
  <form method="post" action="/office/team/invite" novalidate>
    <div class="form-grid">
      <div class="field">
        <label for="phone"><%= __("رقم الجوال أو البريد الإلكتروني") %></label>
        <input id="phone" name="phone" class="input" type="text" inputmode="email" autocomplete="off" dir="ltr" maxlength="190" placeholder="05XXXXXXXX / name@example.com" value="<%= values.phone %>" required>
      </div>
      <div class="field">
        <label for="role"><%= __("الدور") %></label>
        <select id="role" name="role" class="select">
          <% assignable.forEach(function (r) { %><option value="<%= __(r) %>" <%= __(values.role === r ? 'selected' : '') %>><%= __(roleLabels[r]) %></option><% }) %>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn--primary btn--block"><%= __("إنشاء رمز الدعوة") %></button>
  </form>

  <% if (pending.length) { %>
    <h3><%= __("دعوات بانتظار القبول") %></h3>
    <ul class="item-list">
      <% pending.forEach(function (i) { %>
        <li class="item">
          <div class="item__title"><span dir="ltr"><%= __(i.phoneLocal) %></span> <span class="badge badge--role"><%= __(i.roleLabel) %></span></div>
          <div class="invite-code"><output id="code-<%= __(i.id) %>" dir="ltr"><%= __(i.code) %></output><button type="button" class="btn btn--secondary" data-copy="#code-<%= __(i.id) %>" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ الرمز") %></button></div>
          <div class="button-row">
            <a href="<%= __(i.shareLink) %>" class="btn btn--primary btn--small" target="_blank" rel="noopener noreferrer"><%= __("إرسال عبر واتساب") %></a>
            <form method="post" action="/office/team/invites/<%= __(i.id) %>/revoke"><button type="submit" class="btn btn--secondary btn--small"><%= __("إلغاء الدعوة") %></button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<script src="<%= assetUrl('/js/copy.js') %>" defer></script>

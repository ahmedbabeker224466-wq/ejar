<%
  const globe = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>';
  const chevron = '<svg class="mk-dd__chev" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
  // Line icons for the menus (24px grid), shown on a pale blue tile.
  const ICONS = {
    office: '<path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16M16 9h3a2 2 0 0 1 2 2v10"/><path d="M9 7h3M9 11h3M9 15h3"/>',
    owner: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><circle cx="12" cy="13.5" r="2"/><path d="M8.5 20a3.5 3.5 0 0 1 7 0"/>',
    tenant: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
    contracts: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
    payments: '<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M7 15h3"/>',
    reminders: '<path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 20a2 2 0 0 0 4 0"/>',
    maint: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>',
    ads: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
    reports: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    faq: '<path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.6A8.5 8.5 0 1 1 21 12z"/><path d="M9.6 9.5a2.5 2.5 0 0 1 4.8.8c0 1.7-2.4 2.2-2.4 3.4M12 16.6h.01"/>',
    blog: '<path d="M4 19.5V5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-1.5z"/><path d="M8 7h6M8 11h6"/>',
    browse: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
    about: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
    contact: '<path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><path d="m3.5 6 8.5 7 8.5-7"/>',
    login: '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>',
    people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 9.2-9.2M17 6l3 3M14 9l2 2"/>',
  };
  const item = (href, icon, key) => '<a class="mk-dd__item" href="' + href + '"><span class="mk-dd__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + ICONS[icon] + '</svg></span><span><b>' + __(t(key)) + '</b><small>' + __(t(key + 'P')) + '</small></span></a>';
  const feat = (id) => L('/features') + '#' + id;
%>
<header class="mk-nav">
  <div class="mk-wrap mk-nav__inner">
    <a href="<%= L('/') %>" class="mk-logo" aria-label="<%= __(t('brand')) %>">
      <span class="mk-logo__mark" aria-hidden="true"><%- include('../partials/brand-mark', { bid: 'h', light: true }) %></span>
      <span class="brand-word" lang="en" dir="ltr">miaad</span>
    </a>
    <% if (locals.localized || locals.langSwitch) { %>
      <a href="<%= __(altLangHref) %>" class="mk-lang mk-lang--bar" hreflang="<%= __(lang === 'en' ? 'ar' : 'en') %>" lang="<%= __(lang === 'en' ? 'ar' : 'en') %>" aria-label="<%= __(t('lang.switchLabel')) %>"><%- globe %><span lang="<%= lang === 'en' ? 'ar' : 'en' %>"><%= lang === 'en' ? 'ع' : 'EN' %></span></a>
    <% } %>
    <input type="checkbox" id="mk-menu" class="mk-menu-toggle" aria-hidden="true" tabindex="-1">
    <label for="mk-menu" class="mk-menu-button" aria-label="<%= __(t('nav.menu')) %>">
      <svg class="mk-menu-button__open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="mk-menu-button__close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </label>
    <div class="mk-nav__panel">
      <nav class="mk-nav__links" aria-label="<%= __(t('nav.main')) %>">
        <details class="mk-dd mk-dd--wide">
          <summary><%= __(t('nav.solutions')) %><%- chevron %></summary>
          <div class="mk-dd__panel">
            <div class="mk-dd__col">
              <p class="mk-dd__head"><%= __(t('dd.byParty')) %></p>
              <%- item(feat('contracts'), 'office', 'dd.office') %>
              <%- item(feat('owners'), 'owner', 'dd.owner') %>
              <%- item(feat('reminders'), 'tenant', 'dd.tenant') %>
            </div>
            <div class="mk-dd__col">
              <p class="mk-dd__head"><%= __(t('dd.daily')) %></p>
              <%- item(feat('contracts'), 'contracts', 'dd.contracts') %>
              <%- item(feat('payments'), 'payments', 'dd.payments') %>
              <%- item(feat('reminders'), 'reminders', 'dd.reminders') %>
              <%- item(feat('maintenance'), 'maint', 'dd.maint') %>
            </div>
            <div class="mk-dd__col">
              <p class="mk-dd__head"><%= __(t('dd.grow')) %></p>
              <%- item(feat('listings'), 'ads', 'dd.ads') %>
              <%- item(feat('reports'), 'reports', 'dd.reports') %>
            </div>
          </div>
        </details>
        <a href="<%= L('/pricing') %>" class="mk-nav__link" <%- currentPath === '/pricing' ? 'aria-current="page"' : '' %>><%= __(t('nav.pricing')) %></a>
        <a href="/listings" class="mk-nav__link" <%- currentPath === '/listings' ? 'aria-current="page"' : '' %>><%= __(t('nav.listings')) %></a>
        <details class="mk-dd">
          <summary><%= __(t('nav.resources')) %><%- chevron %></summary>
          <div class="mk-dd__panel">
            <div class="mk-dd__col">
              <p class="mk-dd__head"><%= __(t('dd.learn')) %></p>
              <%- item(L('/') + '#faq', 'faq', 'dd.faq') %>
              <%- item(L('/about'), 'about', 'dd.about') %>
              <% if (locals.blogLive) { %><%- item('/blog', 'blog', 'dd.blog') %><% } %>
            </div>
            <div class="mk-dd__col">
              <p class="mk-dd__head"><%= __(t('dd.browse')) %></p>
              <%- item('/listings', 'browse', 'dd.listings') %>
              <%- item(L('/contact'), 'contact', 'dd.contact') %>
            </div>
          </div>
        </details>
      </nav>
      <div class="mk-nav__side">
        <% if (locals.localized || locals.langSwitch) { %>
          <a href="<%= __(altLangHref) %>" class="mk-lang mk-lang--panel" hreflang="<%= __(lang === 'en' ? 'ar' : 'en') %>" lang="<%= __(lang === 'en' ? 'ar' : 'en') %>" aria-label="<%= __(t('lang.switchLabel')) %>"><%- globe %><span lang="<%= lang === 'en' ? 'ar' : 'en' %>"><%= lang === 'en' ? 'ع' : 'EN' %></span></a>
        <% } %>
        <% if (currentUser) { %>
          <a href="/logout" class="mk-btn mk-btn--quiet"><%= __(t('nav.logout')) %></a>
          <a href="/login" class="mk-btn mk-btn--brand"><%= __(t('nav.dashboard')) %></a>
        <% } else { %>
          <details class="mk-dd mk-dd--end">
            <summary><%= __(t('nav.loginMenu')) %><%- chevron %></summary>
            <div class="mk-dd__panel">
              <div class="mk-dd__col">
                <%- item('/login', 'office', 'dd.officeLogin') %>
                <%- item('/login', 'people', 'dd.memberLogin') %>
                <%- item('/join', 'key', 'dd.join') %>
              </div>
            </div>
          </details>
          <a href="<%= L('/contact') %>" class="mk-nav__contact" <%- currentPath === '/contact' ? 'aria-current="page"' : '' %>><%= __(t('footer.contact')) %></a>
          <a href="/register" class="mk-btn mk-btn--accent"><%= __(t('nav.trial')) %></a>
        <% } %>
      </div>
    </div>
  </div>
</header>
<script src="<%= assetUrl('/js/siteNav.js') %>" defer></script>

<header class="mk-nav">
  <div class="mk-wrap mk-nav__inner">
    <a href="<%= L('/') %>" class="mk-logo" aria-label="<%= t('brand') %>">
      <span class="mk-logo__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m9 15 2 2 4-4"/></svg></span>
      <span><%= t('brand') %></span>
    </a>
    <input type="checkbox" id="mk-menu" class="mk-menu-toggle" aria-hidden="true" tabindex="-1">
    <label for="mk-menu" class="mk-menu-button" aria-label="<%= t('nav.menu') %>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></label>
    <nav class="mk-nav__links" aria-label="<%= t('nav.main') %>">
      <a href="<%= L('/') %>#features"><%= t('nav.features') %></a>
      <a href="<%= L('/') %>#how"><%= t('nav.how') %></a>
      <a href="<%= L('/pricing') %>" <%- currentPath === '/pricing' ? 'aria-current="page"' : '' %>><%= t('nav.pricing') %></a>
      <a href="/listings"><%= t('nav.listings') %></a>
      <% if (!currentUser) { %><a href="/login" class="mk-only-menu"><%= t('nav.login') %></a><a href="/register" class="mk-only-menu"><%= t('nav.trial') %></a><% } %>
    </nav>
    <div class="mk-nav__side">
      <% if (locals.localized) { %>
        <a href="<%= altLangHref %>" class="mk-lang" hreflang="<%= lang === 'en' ? 'ar' : 'en' %>" lang="<%= lang === 'en' ? 'ar' : 'en' %>" aria-label="<%= t('lang.switchLabel') %>">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg><%= t('lang.switch') %>
        </a>
      <% } %>
      <% if (currentUser) { %>
        <a href="/logout" class="mk-link"><%= t('nav.logout') %></a>
      <% } else { %>
        <a href="/login" class="mk-link mk-hide-sm"><%= t('nav.login') %></a>
        <a href="/register" class="mk-btn mk-btn--accent"><%= t('nav.trial') %></a>
      <% } %>
    </div>
  </div>
</header>

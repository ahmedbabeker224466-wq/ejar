<% const globe = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>'; %>
<% const navItem = (href, label, path) => '<a href="' + href + '"' + (path && currentPath === path ? ' aria-current="page"' : '') + '>' + label + '</a>'; %>
<header class="mk-nav">
  <div class="mk-wrap mk-nav__inner">
    <a href="<%= L('/') %>" class="mk-logo" aria-label="<%= t('brand') %>">
      <span class="mk-logo__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m9 15 2 2 4-4"/></svg></span>
      <span><%= t('brand') %></span>
    </a>
    <% if (locals.localized) { %>
      <a href="<%= altLangHref %>" class="mk-lang mk-lang--bar" hreflang="<%= lang === 'en' ? 'ar' : 'en' %>" lang="<%= lang === 'en' ? 'ar' : 'en' %>" aria-label="<%= t('lang.switchLabel') %>"><%- globe %><%= t('lang.switch') %></a>
    <% } %>
    <input type="checkbox" id="mk-menu" class="mk-menu-toggle" aria-hidden="true" tabindex="-1">
    <label for="mk-menu" class="mk-menu-button" aria-label="<%= t('nav.menu') %>">
      <svg class="mk-menu-button__open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="mk-menu-button__close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </label>
    <div class="mk-nav__panel">
      <nav class="mk-nav__links" aria-label="<%= t('nav.main') %>">
        <%- navItem(L('/features'), t('nav.features'), '/features') %>
        <%- navItem(L('/') + '#how', t('nav.how')) %>
        <%- navItem(L('/pricing'), t('nav.pricing'), '/pricing') %>
        <%- navItem('/listings', t('nav.listings'), '/listings') %>
        <% if (locals.blogLive) { %><%- navItem('/blog', t('footer.blog'), '/blog') %><% } %>
      </nav>
      <div class="mk-nav__side">
        <% if (locals.localized) { %>
          <a href="<%= altLangHref %>" class="mk-lang mk-lang--panel" hreflang="<%= lang === 'en' ? 'ar' : 'en' %>" lang="<%= lang === 'en' ? 'ar' : 'en' %>" aria-label="<%= t('lang.switchLabel') %>"><%- globe %><%= t('lang.switch') %></a>
        <% } %>
        <a href="<%= L('/contact') %>" class="mk-nav__contact" <%- currentPath === '/contact' ? 'aria-current="page"' : '' %>><%= t('footer.contact') %></a>
        <% if (currentUser) { %>
          <a href="/logout" class="mk-btn mk-btn--quiet"><%= t('nav.logout') %></a>
          <a href="/login" class="mk-btn mk-btn--brand"><%= t('nav.dashboard') %></a>
        <% } else { %>
          <a href="/login" class="mk-btn mk-btn--quiet"><%= t('nav.login') %></a>
          <a href="/register" class="mk-btn mk-btn--accent"><%= t('nav.trial') %></a>
        <% } %>
      </div>
    </div>
  </div>
</header>

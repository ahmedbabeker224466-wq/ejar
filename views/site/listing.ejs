<% const off = discountPercent(listing); %>
<% const hasHood = listing.neighborhood && listing.neighborhood !== 'أخرى'; const place = lang === 'en' ? (hasHood ? listing.neighborhood + ', ' : '') + __(listing.city) : (hasHood ? 'حي ' + listing.neighborhood + '، ' : '') + listing.city; const monthly = Math.round(listing.price / 12); %>
<article class="ld">
  <p class="ld__crumbs"><a href="/listings"><%= __("الإعلانات") %></a> <span aria-hidden="true">/</span> <a href="/listings?city=<%= encodeURIComponent(listing.city) %>"><%= __(listing.city) %></a></p>

  <header class="ld__head">
    <div>
      <h1><%= displayTitle(listing, lang, __) %></h1>
      <p class="ld__place"><%- icon('pin') %><%= place %></p>
    </div>
    <div class="ld__tools">
      <% if (listing.adLicense) { %><p class="ld__licence"><%- icon('shield') %><span><%= __("رقم ترخيص الإعلان") %></span> <bdi dir="ltr"><%= __(listing.adLicense) %></bdi></p><% } %>
      <button type="button" class="ld-tool" data-share data-title="<%= displayTitle(listing, lang, __) %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"/></svg><span data-share-label><%= __("مشاركة") %></span></button>
      <button type="button" class="ld-tool" data-fav="<%= listing.id %>" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.7 8 3.6 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.6 0 5.5 3.5 4.4 6.7-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg><span><%= __("حفظ") %></span></button>
    </div>
  </header>

  <% if (photos.length) { %>
    <section class="ld-gallery ld-gallery--<%= Math.min(photos.length, 5) %>" aria-label="<%= __("صور الإعلان") %>">
      <% photos.slice(0, 5).forEach(function (id, i) { %>
        <a href="#photo-<%= i + 1 %>" class="ld-gallery__item<%= i === 0 ? ' ld-gallery__item--main' : '' %>">
          <img src="/listings/photos/<%= __(id) %>/<%= i === 0 ? 'full' : 'thumb' %>" alt="<%= __("صورة") %> <%= i + 1 %> <%= __("من") %> <%= photos.length %>" <%= i === 0 ? '' : 'loading=lazy' %>>
        </a>
      <% }) %>
      <% if (photos.length > 1) { %><a href="#photo-1" class="ld-gallery__all"><%- icon('photos') %><%= __("عرض كل الصور") %> (<%= photos.length %>)</a><% } %>
    </section>
    <% photos.forEach(function (id, i) { %>
      <div class="lightbox" id="photo-<%= i + 1 %>" role="dialog" aria-label="<%= __("صورة") %> <%= i + 1 %> <%= __("من") %> <%= photos.length %>">
        <a href="#gallery-closed" class="lightbox__close" aria-label="<%= __("إغلاق") %>"><%- icon('close') %></a>
        <img src="/listings/photos/<%= __(id) %>/full" alt="" loading="lazy">
        <div class="lightbox__nav">
          <% if (i > 0) { %><a href="#photo-<%= i %>"><%= __("السابقة") %></a><% } else { %><span></span><% } %>
          <bdi dir="ltr"><%= i + 1 %> / <%= photos.length %></bdi>
          <% if (i < photos.length - 1) { %><a href="#photo-<%= i + 2 %>"><%= __("التالية") %></a><% } else { %><span></span><% } %>
        </div>
      </div>
    <% }) %>
  <% } %>

  <nav class="ld-tabs" aria-label="<%= __("أقسام الإعلان") %>">
    <a href="#ld-specs"><%= __("المواصفات والمزايا") %></a>
    <a href="#ld-location"><%= __("الموقع") %></a>
    <a href="#ld-office"><%= __("عن المكتب") %></a>
    <a href="#inquiry" class="ld-tabs__cta"><%= __("اطلب معاينة") %></a>
  </nav>
  <div class="ld__cols">
    <div class="ld__main">
      <div class="ld-assure">
        <span class="ld-assure__icon"><%- icon('shield') %></span>
        <div><b><%= __("من المكتب مباشرة، والمعاينة مجانية") %></b><span><%= __("ينشر الإعلان مكتب عقاري مسجّل في ميعاد، ولا يُطلب منك أي دفع داخل الموقع.") %></span></div>
      </div>
      <div id="ld-specs"></div>
      <ul class="ld-facts">
        <li><%- icon('home') %><span><%= __("النوع") %></span><strong><%= __(types[listing.unitType] || __('عقار')) %></strong></li>
        <% if (listing.rooms !== null) { %><li><%- icon('bed') %><span><%= __("الغرف") %></span><strong><%= __(listing.rooms) %></strong></li><% } %>
        <% if (listing.bathrooms !== null) { %><li><%- icon('bath') %><span><%= __("دورات المياه") %></span><strong><%= __(listing.bathrooms) %></strong></li><% } %>
        <% if (listing.area !== null) { %><li><%- icon('area') %><span><%= __("المساحة") %></span><strong><%= __(listing.area) %> <%= __("م²") %></strong></li><% } %>
      </ul>

      <% if (listing.description) { %>
        <section class="ld-sec">
          <h2><%= __("عن العقار") %></h2>
          <p class="pre-line"><%= listing.description %></p>
        </section>
      <% } %>

      <% if (listing.features.length) { %>
        <section class="ld-sec">
          <h2><%= __("المزايا") %></h2>
          <ul class="ld-features"><% listing.features.forEach(function (f) { %><li><%- icon(f) %><%= __(featureLabels[f]) %></li><% }) %></ul>
        </section>
      <% } %>

      <section class="ld-sec" id="ld-location">
        <h2><%= __("الموقع") %></h2>
        <p class="ld__place"><%- icon('pin') %><%= place %></p>
        <p class="muted"><%= __("يُرسل المكتب العنوان الدقيق بعد تأكيد موعد المعاينة.") %></p>
      </section>

      <section class="ld-sec" id="ld-office">
        <h2><%= __("عن المكتب") %></h2>
        <div class="ld-host">
          <span class="ld-host__avatar" aria-hidden="true"><%= String(listing.officeName || '').trim().charAt(0) %></span>
          <div class="ld-host__who">
            <strong><%= listing.officeName %></strong>
            <% if (listing.officeRatingCount) { %><span class="ld-host__rating"><%- icon('star') %><b><%= listing.officeRating %></b> <span>(<%= listing.officeRatingCount %> <%= __("تقييم") %>)</span></span><% } else { %><span class="muted"><%= __("لا توجد تقييمات بعد") %></span><% } %>
          </div>
          <% if (listing.officeSlug && !locals.isCustomHost) { %><a class="ld-host__btn" href="/<%= __(listing.officeSlug) %>"><%= __("صفحة المكتب وإعلاناته") %></a><% } %>
        </div>
      </section>
    </div>

    <aside class="ld__side" id="inquiry">
      <div class="ld-book">
        <% if (off) { %><p class="ld-book__deal"><s><%= fmt(listing.previousPrice).replace(/\.00$/, '') %> <%= __("ريال") %></s><span class="pcard__off"><%= __("خصم") %> <%= off %>%</span></p><% } %>
        <p class="ld-book__price"><strong><%= __(fmt(listing.price).replace(/\.00$/, '')) %></strong> <%= __("ريال سنوياً") %></p>
        <p class="muted ld-book__monthly"><%= __("ما يعادل") %> <%= __(fmt(monthly).replace(/\.00$/, '')) %> <%= __("ريال شهرياً") %></p>
        <% if (sent) { %>
          <div class="flash flash--success" role="status"><%= __("وصل طلب المعاينة إلى المكتب، وسيتصل بك لتأكيد الموعد.") %></div>
        <% } %>
        <h2 class="ld-book__title"><%- icon('cal') %><%= __("اطلب معاينة") %></h2>
        <form method="post" action="/listings/<%= __(listing.id) %>/inquiry" novalidate>
          <div class="field">
            <label for="q-day"><%= __("اليوم") %></label>
            <select id="q-day" name="visit_date" class="select" <%= __(errors.visit_date ? 'aria-invalid=true' : '') %>>
              <option value=""><%= __("اختر اليوم") %></option>
              <% visitDays.forEach(function (d) { %><option value="<%= __(d.value) %>" <%= __(values.visit_date === d.value ? 'selected' : '') %>><%= lang === 'en' ? d.weekdayEn : d.weekday %> <%= d.label.split(' ')[1] %></option><% }) %>
            </select>
            <% if (errors.visit_date) { %><p class="field-error"><%= __(errors.visit_date) %></p><% } %>
          </div>
          <fieldset class="field slot-chips">
            <legend><%= __("الوقت المناسب") %></legend>
            <% Object.keys(visitSlots).forEach(function (k) { %>
              <label class="slot-chip"><input type="radio" name="visit_slot" value="<%= __(k) %>" <%= __(values.visit_slot === k ? 'checked' : '') %>><span><%= __(visitSlots[k]) %></span></label>
            <% }) %>
            <% if (errors.visit_slot) { %><p class="field-error"><%= __(errors.visit_slot) %></p><% } %>
          </fieldset>
          <div class="field"><label for="q-name"><%= __("اسمك") %></label><input id="q-name" name="name" class="input" maxlength="60" value="<%= __(values.name || '') %>" autocomplete="name">
            <% if (errors.name) { %><p class="field-error"><%= __(errors.name) %></p><% } %></div>
          <div class="field"><label for="q-phone"><%= __("جوالك") %></label><input id="q-phone" name="phone" class="input" type="tel" inputmode="tel" dir="ltr" maxlength="30" placeholder="05xxxxxxxx" value="<%= __(values.phone || '') %>" autocomplete="tel">
            <% if (errors.phone) { %><p class="field-error"><%= __(errors.phone) %></p><% } %></div>
          <details class="ld-book__more" <%= __(values.message || values.email || errors.message || errors.email ? 'open' : '') %>>
            <summary><%= __("أضف بريدك أو تفاصيل أخرى") %></summary>
            <div class="field"><label for="q-email"><%= __("بريدك الإلكتروني (اختياري)") %></label><input id="q-email" name="email" class="input" type="email" dir="ltr" maxlength="190" value="<%= __(values.email || '') %>" autocomplete="email">
              <% if (errors.email) { %><p class="field-error"><%= __(errors.email) %></p><% } %></div>
            <div class="field"><label for="q-message"><%= __("رسالة للمكتب (اختياري)") %></label><textarea id="q-message" name="message" class="textarea" rows="3" maxlength="500"><%= __(values.message || '') %></textarea>
              <% if (errors.message) { %><p class="field-error"><%= __(errors.message) %></p><% } %></div>
          </details>
          <div class="hp" aria-hidden="true"><label for="q-website"><%= __("اترك هذا الحقل فارغاً") %></label><input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
          <button type="submit" class="btn btn--success btn--large btn--block"><%= __("اطلب المعاينة") %></button>
          <p class="field-hint"><%= __("لا يوجد أي دفع هنا. يرى المكتب طلبك فقط ويتصل بك لتأكيد الموعد، وتُحذف بياناتك بعد 90 يوماً.") %></p>
        </form>
      </div>
    </aside>
  </div>

  <% if (similar.length) { %>
    <section class="ld-similar">
      <h2><%= __("عقارات مشابهة في") %> <%= __(listing.city) %></h2>
      <ul class="pgrid"><% similar.forEach(function (l) { %><%- include('_pcard', { l: l }) %><% }) %></ul>
    </section>
  <% } %>

  <p class="muted ld__foot"><%= __("الإعلان من المكتب المذكور، وميعاد وسيط تقني فقط.") %> <a href="/listings/<%= __(listing.id) %>/report" rel="nofollow"><%= __("الإبلاغ عن هذا الإعلان") %></a></p>
</article>
<script src="<%= assetUrl('/js/favorites.js') %>" defer></script>
<script src="<%= assetUrl('/js/share.js') %>" defer></script>

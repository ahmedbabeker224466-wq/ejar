<article class="listing-detail">
  <p class="back-link"><a href="/listings"><%= dir === 'rtl' ? '→' : '←' %> <%= __("كل الإعلانات") %></a></p>
  <h1><%= __(listing.title) %></h1>
  <p class="listing-detail__price"><strong><%= __(fmt(listing.price)) %></strong> <%= __("ريال سنوياً") %></p>

  <% if (photos.length) { %>
    <section class="gallery" aria-label="<%= __("صور الإعلان") %>" data-gallery>
      <a href="/listings/photos/<%= __(photos[0]) %>/full" class="gallery__main-link" target="_blank" rel="noopener noreferrer">
        <img src="/listings/photos/<%= __(photos[0]) %>/full" alt="<%= __(listing.title) %>" width="1200" height="900" class="gallery__main" data-gallery-main>
      </a>
      <% if (photos.length > 1) { %>
        <ul class="gallery__thumbs">
          <% photos.forEach(function (id, i) { %>
            <li><a href="/listings/photos/<%= __(id) %>/full" target="_blank" rel="noopener noreferrer" data-gallery-thumb>
              <img src="/listings/photos/<%= __(id) %>/thumb" alt="<%= __("صورة") %> <%= __(i + 1) %> <%= __("من") %> <%= __(photos.length) %>" width="120" height="90" loading="lazy"></a></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% } %>

  <section class="card">
    <h2><%= __("المواصفات") %></h2>
    <dl class="details">
      <dt><%= __("النوع") %></dt><dd><%= __(types[listing.unitType] || __('عقار')) %></dd>
      <dt><%= __("المدينة") %></dt><dd><%= __(listing.city) %></dd>
      <% if (listing.neighborhood) { %><dt><%= __("الحي") %></dt><dd><%= __(listing.neighborhood) %></dd><% } %>
      <% if (listing.rooms !== null) { %><dt><%= __("الغرف") %></dt><dd><%= __(listing.rooms) %></dd><% } %>
      <% if (listing.bathrooms !== null) { %><dt><%= __("دورات المياه") %></dt><dd><%= __(listing.bathrooms) %></dd><% } %>
      <% if (listing.area !== null) { %><dt><%= __("المساحة") %></dt><dd><%= __(listing.area) %> م²</dd><% } %>
      <dt><%= __("الإيجار السنوي") %></dt><dd><%= __(fmt(listing.price)) %> <%= __("ريال") %></dd>
      <dt><%= __("المكتب") %></dt><dd><%= __(listing.officeName) %></dd>
    </dl>
    <% if (listing.features.length) { %>
      <h3><%= __("المزايا") %></h3>
      <ul class="tag-list"><% listing.features.forEach(function (f) { %><li><%= __(featureLabels[f]) %></li><% }) %></ul>
    <% } %>
    <% if (listing.description) { %><h3><%= __("الوصف") %></h3><p class="pre-line"><%= __(listing.description) %></p><% } %>
  </section>

  <section class="card" id="inquiry">
    <h2><%= __("تواصل مع المكتب") %></h2>
    <% if (sent) { %><div class="flash flash--success" role="status"><%= __("وصل استفسارك إلى المكتب وسيتواصل معك.") %></div><% } %>
    <form method="post" action="/listings/<%= __(listing.id) %>/inquiry" novalidate>
      <div class="field"><label for="q-name"><%= __("اسمك أو لقبك (اختياري)") %></label><input id="q-name" name="name" class="input" maxlength="60" value="<%= __(values.name || '') %>" autocomplete="nickname">
        <% if (errors.name) { %><p class="field-error"><%= __(errors.name) %></p><% } %></div>
      <div class="form-grid">
        <div class="field"><label for="q-phone"><%= __("جوالك") %></label><input id="q-phone" name="phone" class="input" type="tel" inputmode="tel" dir="ltr" maxlength="30" value="<%= __(values.phone || '') %>" autocomplete="tel">
          <% if (errors.phone) { %><p class="field-error"><%= __(errors.phone) %></p><% } %></div>
        <div class="field"><label for="q-email"><%= __("بريدك الإلكتروني") %></label><input id="q-email" name="email" class="input" type="email" dir="ltr" maxlength="190" value="<%= __(values.email || '') %>" autocomplete="email">
          <% if (errors.email) { %><p class="field-error"><%= __(errors.email) %></p><% } %></div>
      </div>
      <% if (errors.contact) { %><p class="field-error"><%= __(errors.contact) %></p><% } %>
      <p class="field-hint"><%= __("اكتب جوالك أو بريدك. لا نعرض بياناتك للعموم، ويراها المكتب فقط، وتُحذف بعد 90 يوماً.") %></p>
      <div class="field"><label for="q-message"><%= __("رسالتك (حتى 500 حرف)") %></label><textarea id="q-message" name="message" class="textarea" rows="4" maxlength="500"><%= __(values.message || '') %></textarea>
        <% if (errors.message) { %><p class="field-error"><%= __(errors.message) %></p><% } %></div>
      <div class="hp" aria-hidden="true"><label for="q-website"><%= __("اترك هذا الحقل فارغاً") %></label><input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("إرسال الاستفسار") %></button>
    </form>
  </section>
  <p class="muted"><%= __("الإعلان من المكتب أعلاه، وميعاد وسيط تقني فقط.") %> <a href="/listings/<%= __(listing.id) %>/report" rel="nofollow"><%= __("الإبلاغ عن هذا الإعلان") %></a></p>
</article>
<script src="<%= assetUrl('/js/gallery.js') %>" defer></script>

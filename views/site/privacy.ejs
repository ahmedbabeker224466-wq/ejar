<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap"><h1 id="page-title"><%= __(t('meta.privacyTitle')) %></h1></div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <article class="mk-panel mk-prose">
      <%- include('_legal-note') %>
      <p class="mk-meta"><%= __(t('legal.updated')) %></p>
      <% for (let i = 1; i <= Number(t('privacy.count')); i += 1) { %>
        <h2><%= __(t('privacy.s' + i + '.h')) %></h2>
        <p><%= __(t('privacy.s' + i + '.p')) %></p>
      <% } %>
      <p><a href="<%= L('/contact') %>"><%= __(t('contact.title')) %></a></p>
    </article>
  </div>
</section>

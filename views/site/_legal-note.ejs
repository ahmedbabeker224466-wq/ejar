<% if (!locals.legalReviewed) { %>
<p class="mk-alert mk-alert--warn" role="note"><strong><%= t('legal.reviewStrong') %></strong> <%= t('legal.reviewText') %></p>
<% } %>
<% if (seller.legal_name || seller.cr_number || seller.address) { %>
  <p class="mk-meta"><%= t('legal.operator') %> <% if (seller.legal_name) { %><strong><%= seller.legal_name %></strong><% } %><% if (seller.cr_number) { %> · <%= t('legal.crShort') %> <span dir="ltr"><%= seller.cr_number %></span><% } %><% if (seller.address) { %> · <%= seller.address %><% } %></p>
<% } else { %>
  <p class="mk-meta"><%= t('legal.operatorPending') %></p>
<% } %>

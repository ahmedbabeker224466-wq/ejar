<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap"><h1 id="page-title"><%= __(t('meta.disclaimerTitle')) %></h1></div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <article class="mk-panel mk-prose">
      <%- include('_legal-note') %>
      <p class="mk-alert mk-alert--info"><%= __(t('footer.disclaimer')) %></p>
      <% for (let i = 1; i <= Number(t('disc.count')); i += 1) { %><p><%= __(t('disc.s' + i)) %></p><% } %>
      <p class="mk-meta"><%= __(t('legal.updated')) %></p>
    </article>
  </div>
</section>

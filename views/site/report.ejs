<section class="card">
  <p class="back-link"><a href="/listings/<%= __(listing.id) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("العودة للإعلان") %></a></p>
  <h1><%= __("الإبلاغ عن إعلان") %></h1>
  <% if (done) { %>
    <div class="flash flash--success" role="status"><%= __("شكراً. وصل بلاغك وسنراجع الإعلان.") %></div>
  <% } else { %>
    <p class="muted"><%= __(listing.title) %></p>
    <form method="post" action="/listings/<%= __(listing.id) %>/report" novalidate>
      <div class="field"><label for="r-reason"><%= __("سبب البلاغ") %></label>
        <select id="r-reason" name="reason" class="select" required>
          <option value=""><%= __("اختر السبب") %></option>
          <% Object.keys(reasons).forEach(function (k) { %><option value="<%= __(k) %>" <%= __(values.reason === k ? 'selected' : '') %>><%= __(reasons[k]) %></option><% }) %>
        </select><% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %></div>
      <div class="field"><label for="r-note"><%= __("تفاصيل (اختياري، 300 حرف)") %></label><textarea id="r-note" name="note" class="textarea" rows="3" maxlength="300"><%= __(values.note || '') %></textarea></div>
      <div class="hp" aria-hidden="true"><label for="r-website"><%= __("اترك هذا الحقل فارغاً") %></label><input id="r-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <button type="submit" class="btn btn--primary btn--block"><%= __("إرسال البلاغ") %></button>
    </form>
  <% } %>
</section>

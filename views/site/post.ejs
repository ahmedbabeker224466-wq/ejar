<article class="card prose">
  <p class="back-link"><a href="/blog"><%= dir === 'rtl' ? '→' : '←' %> <%= __("المدونة") %></a></p>
  <h1><%= __(post.title) %></h1>
  <p class="muted"><time datetime="<%= __(new Date(post.publishedAt).toISOString()) %>"><%= __(new Date(post.publishedAt).toISOString().slice(0, 10)) %></time></p>
  <% if (cover) { %><img class="post-cover" src="/blog/<%= __(post.slug) %>/cover" alt="" width="800" height="450" loading="lazy"><% } %>
  <div class="post-body"><%- post.html %></div>
  <p class="muted"><%= __("معلومات عامة وليست استشارة قانونية. تحقق دائماً من المصدر الرسمي.") %></p>
</article>

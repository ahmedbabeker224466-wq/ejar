<section class="hero card" aria-labelledby="hero-title">
  <h1 id="hero-title"><%= __("تابع عقود الإيجار ومواعيدها بلا قلق") %></h1>
  <p class="lead"><%= __("ميعاد لمكاتب العقار: يحسب مواعيد التجديد وإشعار عدم التجديد، ويتتبع الدفعات والصيانة، ويذكّر الملاك والمستأجرين قبل كل موعد مهم.") %></p>
  <div class="actions">
    <a href="/register" class="btn btn--primary btn--block btn--large"><%= __("سجّل مكتبك وجرّب مجاناً") %></a>
    <a href="/listings" class="btn btn--secondary btn--block"><%= __("تصفح إعلانات العقارات") %></a>
  </div>
  <p class="muted"><%= __("تجربة مجانية") %> <%= __(trialDays) %> <%= __("يوماً، بدون بطاقة.") %></p>
</section>

<section class="section" aria-labelledby="how-title">
  <h2 id="how-title"><%= __("كيف يعمل؟") %></h2>
  <div class="cards-3">
    <article class="card"><h3><%= __("للمكتب") %></h3>
      <p><%= __("تنشئ العقد في منصة إيجار كما تفعل اليوم، ثم ترفع الملف لقراءة التواريخ والمبالغ فقط، أو تدخلها بنفسك. يبني ميعاد المواعيد والدفعات ويذكّرك.") %></p></article>
    <article class="card"><h3><%= __("للمالك") %></h3>
      <p><%= __("يدخل برمز دعوة مجاني من مكتبه، فيتابع عقاراته ومواعيد قراراته ويؤكد الدفعات ويكتب قراره بشأن التجديد.") %></p></article>
    <article class="card"><h3><%= __("للمستأجر") %></h3>
      <p><%= __("يدخل برمز العقد فيرى تواريخ عقده ودفعاته، ويبلّغ عن الدفع، ويرفع طلب صيانة بالصور، ويراسل المكتب.") %></p></article>
  </div>
</section>

<section class="section" aria-labelledby="features-title">
  <h2 id="features-title"><%= __("ماذا تحصل عليه؟") %></h2>
  <div class="cards-3">
    <article class="card"><h3><%= __("مواعيد دقيقة") %></h3><p><%= __("تنبيهات متدرجة قبل موعد القرار وموعد تعديل الإيجار ونهاية العقد، حسب القواعد المضبوطة في التطبيق.") %></p></article>
    <article class="card"><h3><%= __("أربع قنوات تذكير") %></h3><p><%= __("داخل التطبيق دائماً، ويمكن إضافة البريد وواتساب وتيليجرام مع ساعات هدوء ليلية.") %></p></article>
    <article class="card"><h3><%= __("تتبع الدفعات") %></h3><p><%= __("دفعات كاملة وجزئية وكشف يمكن طباعته. يتتبع التطبيق فقط ولا ينقل أي مال.") %></p></article>
    <article class="card"><h3><%= __("صيانة ورسائل") %></h3><p><%= __("طلبات صيانة بالصور وحالات واضحة، ومحادثة لكل عقد بين المكتب والمالك والمستأجر.") %></p></article>
    <article class="card"><h3><%= __("تقارير") %></h3><p><%= __("إشغال وعقود قريبة الانتهاء ومتأخرات وتحصيل مع تنزيل CSV.") %></p></article>
    <article class="card"><h3><%= __("إعلانات عامة") %></h3><p><%= __("انشر وحداتك الشاغرة بالصور والمواصفات دون إظهار رقم أو اسم أو عنوان تفصيلي.") %></p></article>
  </div>
  <p><a href="/features"><%= __("كل المزايا") %></a></p>
</section>

<section class="section card" aria-labelledby="privacy-title">
  <h2 id="privacy-title"><%= __("وعد الخصوصية") %></h2>
  <ul class="check-list">
    <li><%= __("لا نحفظ أسماء الأطراف ولا أرقام الهوية أو الإقامة ولا الآيبان ولا أرقام العدادات.") %></li>
    <li><%= __("لا نحتفظ بملف العقد المرفوع: يُقرأ في الذاكرة ثم يُتجاهل.") %></li>
    <li><%= __("الإعلانات العامة لا تعرض رقماً ولا اسماً ولا عنواناً تفصيلياً؛ الحي من قائمة ثابتة.") %></li>
    <li><%= __("صور الإعلانات تُنظَّف من بيانات الموقع والكاميرا قبل حفظها.") %></li>
    <li><%= __("كل مكتب يرى بياناته فقط، وكل العمليات المهمة تُسجَّل.") %></li>
  </ul>
</section>

<section class="section" aria-labelledby="pricing-title">
  <h2 id="pricing-title"><%= __("الأسعار") %></h2>
  <%- include('_plans') %>
  <p><a href="/pricing" class="btn btn--secondary"><%= __("تفاصيل الباقات") %></a></p>
</section>

<section class="section" aria-labelledby="faq-title">
  <h2 id="faq-title"><%= __("أسئلة شائعة") %></h2>
  <%- include('_faq') %>
</section>

<section class="section card hero" aria-labelledby="cta-title">
  <h2 id="cta-title"><%= __("ابدأ اليوم") %></h2>
  <p class="lead"><%= __("سجّل مكتبك في دقائق وأضف أول عقد.") %></p>
  <a href="/register" class="btn btn--primary btn--large btn--block"><%= __("سجّل مكتبك") %></a>
</section>

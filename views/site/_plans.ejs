<% if (plans.length) { %>
  <div class="pricing">
    <input type="radio" name="billing-period" id="period-monthly" class="period-toggle__input" checked>
    <input type="radio" name="billing-period" id="period-yearly" class="period-toggle__input">
    <div class="period-toggle" role="group" aria-label="<%= __("مدة الاشتراك") %>">
      <label for="period-monthly" class="period-toggle__option period-toggle__option--monthly"><%= __("شهري") %></label>
      <label for="period-yearly" class="period-toggle__option period-toggle__option--yearly"><%= __("سنوي") %></label>
    </div>
    <ul class="plan-grid">
      <% plans.forEach(function (p) { %>
        <li class="plan-card" id="plan-<%= __(p.code) %>">
          <h3><%= __(p.name) %></h3>
          <p class="plan-card__price price--monthly"><strong><%= __(fmt(p.monthly)) %></strong> <%= __("ريال / شهرياً") %></p>
          <p class="plan-card__price price--yearly"><strong><%= __(fmt(p.yearly)) %></strong> <%= __("ريال / سنوياً") %></p>
          <% if (p.paidMonths) { %><p class="muted price--yearly"><%= __("تدفع") %> <%= __(p.paidMonths) %> <%= __("أشهر وتشترك 12 شهراً.") %></p><% } %>
          <ul class="plan-card__limits">
            <% p.lines.forEach(function (line) { %><li>✓ <%= __(line) %></li><% }) %>
          </ul>
          <a href="/register" class="btn btn--primary btn--block"><%= __("ابدأ التجربة المجانية") %></a>
        </li>
      <% }) %>
      <li class="plan-card plan-card--custom" id="plan-custom">
        <h3><%= __("باقة مخصصة") %></h3>
        <p class="plan-card__price"><%= __("لأكثر من") %> <%= __(customFromUnits) %> <%= __("وحدة") %></p>
        <p class="muted"><%= __("نتفق معك على الحدود والسعر حسب حجم مكتبك.") %></p>
        <a href="/contact" class="btn btn--secondary btn--block"><%= __("تواصل معنا") %></a>
      </li>
    </ul>
  </div>
<% } else { %>
  <p class="empty-state"><%= __("لا توجد باقات منشورة حالياً.") %> <a href="/contact"><%= __("تواصل معنا") %></a>.</p>
<% } %>
<p class="muted"><%= __("الأسعار لا تشمل ضريبة القيمة المضافة") %> <%= __(vatPercent) %>%<%= __("، وتظهر كاملة قبل الدفع.") %></p>
<p class="muted"><%= __("التجربة المجانية") %> <%= __(trialDays) %> <%= __("يوماً بدون بطاقة، بحدود الباقة الاحترافية.") %></p>

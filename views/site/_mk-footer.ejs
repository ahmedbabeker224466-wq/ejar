<% const footerCta = !['/', '/pricing', '/login', '/register'].includes(currentPath) && !locals.currentUser; %>
<footer class="mk-footer<%= footerCta ? ' mk-footer--cta' : '' %>">
  <% if (footerCta) { %>
  <div class="mk-wrap">
    <div class="mk-footer__cta">
      <div><h2><%= t('footer.ctaTitle') %></h2><p><%= t('footer.ctaText') %></p></div>
      <a href="/register" class="mk-btn mk-btn--accent mk-btn--lg"><%= t('nav.trial') %></a>
    </div>
  </div>
  <% } %>
  <div class="mk-wrap">
    <div class="mk-footer__cols">
      <div class="mk-footer__brand">
        <a href="<%= L('/') %>" class="mk-logo"><span class="mk-logo__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m9 15 2 2 4-4"/></svg></span><span><%= t('brand') %></span></a>
        <p class="mk-footer__about"><%= t('footer.about') %></p>
        <% if (locals.localized) { %>
          <a href="<%= altLangHref %>" class="mk-footer__lang" hreflang="<%= lang === 'en' ? 'ar' : 'en' %>" lang="<%= lang === 'en' ? 'ar' : 'en' %>" aria-label="<%= t('lang.switchLabel') %>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg><%= t('lang.switch') %></a>
        <% } %>
      </div>
      <nav aria-label="<%= t('footer.product') %>"><h2><%= t('footer.product') %></h2>
        <a href="<%= L('/features') %>"><%= t('nav.features') %></a>
        <a href="<%= L('/pricing') %>"><%= t('nav.pricing') %></a>
        <a href="/listings"><%= t('nav.listings') %></a>
        <a href="/blog"><%= t('footer.blog') %></a>
      </nav>
      <nav aria-label="<%= t('footer.company') %>"><h2><%= t('footer.company') %></h2>
        <a href="<%= L('/about') %>"><%= t('footer.aboutUs') %></a>
        <a href="<%= L('/contact') %>"><%= t('footer.contact') %></a>
        <a href="/login"><%= t('nav.login') %></a>
        <a href="/register"><%= t('nav.trial') %></a>
      </nav>
      <nav aria-label="<%= t('footer.legal') %>"><h2><%= t('footer.legal') %></h2>
        <a href="<%= L('/privacy') %>"><%= t('footer.privacy') %></a>
        <a href="<%= L('/terms') %>"><%= t('footer.terms') %></a>
        <a href="<%= L('/disclaimer') %>"><%= t('footer.disclaimerLink') %></a>
      </nav>
    </div>
    <div class="mk-footer__base">
      <p class="disclaimer"><%= t('footer.disclaimer') %></p>
      <p>© <%= new Date().getFullYear() %> <%= t('brand') %>. <%= t('footer.rights') %></p>
    </div>
  </div>
</footer>

<section class="card"><h1><%= __("المدونة") %></h1><p class="lead"><%= __("مقالات قصيرة لمكاتب العقار. معلومات عامة وليست استشارة قانونية.") %></p></section>
<ul class="post-list">
  <% rows.forEach(function (p) { %>
    <li class="card">
      <h2><a href="/blog/<%= __(p.slug) %>"><%= __(p.title) %></a></h2>
      <p class="muted"><time datetime="<%= __(new Date(p.publishedAt).toISOString()) %>"><%= __(new Date(p.publishedAt).toISOString().slice(0, 10)) %></time></p>
      <% if (p.excerpt) { %><p><%= __(p.excerpt) %></p><% } %>
    </li>
  <% }) %>
</ul>
<% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد مقالات منشورة بعد.") %></p><% } %>
<% if (pages > 1) { %>
  <nav class="pager" aria-label="<%= __("الصفحات") %>">
    <% if (page > 1) { %><a href="/blog?page=<%= __(page - 1) %>"><%= __("السابق") %></a><% } %>
    <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
    <% if (page < pages) { %><a href="/blog?page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
  </nav>
<% } %>

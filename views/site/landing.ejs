<% const check = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>'; const li = (k) => t(k) ? '<li>' + check + __(t(k)) + '</li>' : ''; %>
<section class="mk-hero" aria-labelledby="hero-title">
  <div class="mk-wrap mk-hero__inner">
    <h1 id="hero-title"><%= __(t('hero.title')) %></h1>
    <p class="mk-hero__lead"><%= __(t('hero.lead')) %></p>
    <% if (locals.emailSignup) { %>
    <form class="mk-signup" method="post" action="/login/email">
      <input type="hidden" name="intent" value="register">
      <label class="mk-visually-hidden" for="hero-email"><%= __(t('hero.emailLabel')) %></label>
      <span class="mk-signup__field">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
        <input id="hero-email" name="email" type="email" inputmode="email" autocomplete="email" dir="ltr" required placeholder="<%= __(t('hero.emailPlaceholder')) %>">
      </span>
      <button type="submit" class="mk-btn mk-btn--accent mk-btn--lg"><%= __(t('hero.emailButton')) %></button>
    </form>
    <% } else { %>
    <div class="mk-hero__actions">
      <a href="/register" class="mk-btn mk-btn--accent mk-btn--lg"><%= __(t('hero.cta')) %></a>
      <a href="<%= L('/pricing') %>" class="mk-btn mk-btn--ghost mk-btn--lg"><%= __(t('hero.secondary')) %></a>
    </div>
    <% } %>
    <p class="mk-hero__note"><%= __(t('hero.trial', { days: trialDays })) %></p>

    <figure class="mk-mock">
      <div class="mk-mock__screen" aria-hidden="true">
        <div class="mk-mock__side">
          <div class="mk-mock__brand"><span class="mk-logo__mark"><%- include('../partials/brand-mark', { bid: 'mock' }) %></span><span class="brand-word" lang="en" dir="ltr">miaad</span></div>
          <span class="is-on"><%= __(t('mock.overview')) %></span>
          <span><%= __(t('mock.nav.contracts')) %></span><span><%= __(t('mock.nav.payments')) %></span><span><%= __(t('mock.nav.landlords')) %></span>
          <span><%= __(t('mock.nav.tenants')) %></span><span><%= __(t('mock.nav.maintenance')) %></span><span><%= __(t('mock.nav.listings')) %></span><span><%= __(t('mock.nav.team')) %></span>
        </div>
        <div class="mk-mock__main">
          <p class="mk-mock__title"><%= __(t('mock.overview')) %></p>
          <div class="mk-kpis">
            <div><b>37</b><span><%= __(t('mock.active')) %></span></div>
            <div class="is-warn"><b>5</b><span><%= __(t('mock.decide')) %></span></div>
            <div><b>2</b><span><%= __(t('mock.late')) %></span></div>
            <div><b>3</b><span><%= __(t('mock.vacant')) %></span></div>
          </div>
          <div class="mk-rows">
            <div class="mk-rows__head"><span><%= __(t('mock.unit')) %></span><span><%= __(t('mock.landlord')) %></span><span><%= __(t('mock.date')) %></span><span><%= __(t('mock.status')) %></span></div>
            <div><span><%= __(t('mock.r1.unit')) %></span><span><%= __(t('mock.r1.owner')) %></span><span><%= __(t('mock.r1.date')) %></span><span><em class="mk-pill mk-pill--red"><%= __(t('mock.renewal')) %></em></span></div>
            <div><span><%= __(t('mock.r2.unit')) %></span><span><%= __(t('mock.r2.owner')) %></span><span><%= __(t('mock.r2.date')) %></span><span><em class="mk-pill mk-pill--amber"><%= __(t('mock.payment')) %></em></span></div>
            <div><span><%= __(t('mock.r3.unit')) %></span><span><%= __(t('mock.r3.owner')) %></span><span><%= __(t('mock.r3.date')) %></span><span><em class="mk-pill mk-pill--green"><%= __(t('mock.reminded')) %></em></span></div>
          </div>
        </div>
      </div>
      <figcaption class="mk-mock__note"><%= __(t('mock.sample')) %></figcaption>
    </figure>
  </div>
</section>

<section class="mk-sec" id="features" aria-labelledby="features-title">
  <div class="mk-wrap">
    <div class="mk-head"><h2 id="features-title"><%= __(t('features.title')) %></h2><p><%= __(t('features.lead')) %></p></div>
    <div class="mk-feat">
      <article>
        <div class="mk-art mk-art--1" aria-hidden="true"><div class="mk-mini">
          <p class="mk-mini__t"><%= __(t('f1.card')) %></p>
          <p><span><%= __(t('f1.start')) %></span><b><%= __(t('f1.startV')) %></b></p>
          <p><span><%= __(t('f1.end')) %></span><b><%= __(t('f1.endV')) %></b></p>
          <p><span><%= __(t('f1.rent')) %></span><b><%= __(t('f1.rentV')) %></b></p>
          <p><span><%= __(t('f1.notice')) %></span><em class="mk-pill mk-pill--red"><%= __(t('mock.r1.date')) %></em></p>
        </div></div>
        <h3><%= __(t('f1.title')) %></h3><p><%= __(t('f1.text')) %></p>
        <ul class="mk-checks"><%- li('f1.a') %><%- li('f1.b') %><%- li('f1.c') %></ul>
      </article>
      <article>
        <div class="mk-art mk-art--2" aria-hidden="true"><div class="mk-mini">
          <p class="mk-mini__t"><%= __(t('f2.card')) %></p>
          <p><span><%= __(t('f2.collected')) %></span><b><%= __(t('f2.collectedV')) %></b></p>
          <span class="mk-bar"><i></i></span>
          <p><span><%= __(t('mock.r2.unit')) %></span><em class="mk-pill mk-pill--amber"><%= __(t('f2.due')) %></em></p>
          <p><span><%= __(t('f2.unit2')) %></span><em class="mk-pill mk-pill--green"><%= __(t('f2.collected')) %></em></p>
        </div></div>
        <h3><%= __(t('f2.title')) %></h3><p><%= __(t('f2.text')) %></p>
        <ul class="mk-checks"><%- li('f2.a') %><%- li('f2.b') %><%- li('f2.c') %></ul>
      </article>
      <article>
        <div class="mk-art mk-art--3" aria-hidden="true"><div class="mk-mini">
          <p class="mk-mini__t"><%= __(t('f3.card')) %></p>
          <p><span><%= __(t('mock.r1.owner')) %></span><b><%= __(t('f3.u6')) %></b></p>
          <p><span><%= __(t('mock.r3.owner')) %></span><b><%= __(t('f3.u3')) %></b></p>
          <p><span><%= __(t('mock.r2.owner')) %></span><b><%= __(t('f3.u11')) %></b></p>
          <p><span><%= __(t('f3.invite')) %></span><b class="mk-mini__link"><%= __(t('f3.send')) %></b></p>
        </div></div>
        <h3><%= __(t('f3.title')) %></h3><p><%= __(t('f3.text')) %></p>
        <ul class="mk-checks"><%- li('f3.a') %><%- li('f3.b') %><%- li('f3.c') %></ul>
      </article>
      <article>
        <div class="mk-art mk-art--4" aria-hidden="true"><div class="mk-mini">
          <p class="mk-mini__t"><%= __(t('f4.card')) %></p>
          <p><span><%= __(t('mock.unit')) %></span><b><%= __(t('mock.r1.unit')) %></b></p>
          <p><span><%= __(t('f4.issue')) %></span><b><%= __(t('f4.issueV')) %></b></p>
          <p><span><%= __(t('f4.owner')) %></span><b><%= __(t('f4.ownerV')) %></b></p>
          <p><span><%= __(t('mock.status')) %></span><em class="mk-pill mk-pill--amber"><%= __(t('f4.progress')) %></em></p>
        </div></div>
        <h3><%= __(t('f4.title')) %></h3><p><%= __(t('f4.text')) %></p>
        <ul class="mk-checks"><%- li('f4.a') %><%- li('f4.b') %><%- li('f4.c') %></ul>
      </article>
    </div>
  </div>
</section>

<section class="mk-sec mk-sec--alt" id="how" aria-labelledby="how-title">
  <div class="mk-wrap">
    <div class="mk-head mk-head--start"><h2 id="how-title"><%= __(t('tl.title')) %></h2><p><%= __(t('tl.lead')) %></p></div>
    <ol class="mk-tl">
      <li><span class="mk-tl__when"><%= __(t('tl.days', { n: rules.rentChangeDays })) %></span><h3><%= __(t('tl.rent')) %></h3><p><%= __(t('tl.rentWho')) %></p></li>
      <li class="is-key"><span class="mk-tl__when"><%= __(t('tl.days', { n: rules.noticeDays })) %></span><h3><%= __(t('tl.notice')) %></h3><p><%= __(t('tl.noticeWho')) %></p></li>
      <li><span class="mk-tl__when"><%= __(t('tl.pay')) %></span><h3><%= __(t('dd.payments')) %></h3><p><%= __(t('tl.payWho')) %></p></li>
      <li><span class="mk-tl__when"><%= __(t('tl.end')) %></span><h3><%= __(t('tl.end')) %></h3><p><%= __(t('tl.endWho')) %></p></li>
    </ol>
    <p class="mk-tl__note"><%= __(t('tl.note')) %></p>
  </div>
</section>

<% if (plans.length) { const price = (h) => String(fmt(h)).replace(/\.00$/, ''); %>
<section class="mk-sec" id="pricing" aria-labelledby="home-pricing-title">
  <div class="mk-wrap">
    <div class="mk-head"><h2 id="home-pricing-title"><%= __(t('home.pricingTitle')) %></h2><p><%= __(t('home.pricingLead')) %></p></div>
    <ul class="mk-mini-plans">
      <% plans.forEach(function (p) { const k = 'plan.name.' + p.code; const name = t(k) === k ? p.name : t(k); %>
        <li><h3><%= __(name) %></h3><p><strong><%= __(price(p.monthly)) %></strong> <span><%= __(t('pricing.perMonth')) %></span></p></li>
      <% }) %>
    </ul>
    <p class="mk-center"><a href="<%= L('/pricing') %>" class="mk-btn mk-btn--ghost"><%= __(t('home.pricingMore')) %></a></p>
  </div>
</section>
<% } %>

<% const faqList = lang === 'en' ? [1, 2, 3, 4].map((i) => ({ q: t('faq.q' + i), a: t('faq.a' + i, { days: trialDays }) })) : faqs; %>
<% if (faqList.length) { %>
<section class="mk-sec" id="faq" aria-labelledby="faq-title">
  <div class="mk-wrap">
    <div class="mk-head"><h2 id="faq-title"><%= __(t('home.faqTitle')) %></h2></div>
    <div class="mk-faq">
      <% faqList.forEach(function (f) { %><details class="faq__item"><summary><%= __(f.q) %></summary><p><%= __(f.a) %></p></details><% }) %>
      <p class="mk-privacy-line"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg><span><%= __(t('privacy.line')) %> <a href="<%= L('/privacy') %>"><%= __(t('privacy.more')) %></a></span></p>
    </div>
  </div>
</section>
<% } %>

<section class="mk-sec mk-sec--tight" aria-labelledby="cta-title">
  <div class="mk-wrap">
    <div class="mk-cta">
      <div><h2 id="cta-title"><%= __(t('cta.title')) %></h2><p><%= __(t('cta.text', { days: trialDays })) %></p></div>
      <a href="/register" class="mk-btn mk-btn--accent mk-btn--lg"><%= __(t('cta.button')) %></a>
    </div>
  </div>
</section>

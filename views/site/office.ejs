<section class="card">
  <h1><%= __(office.name) %></h1>
  <p class="muted"><%= __(office.city) %></p>
  <% if (office.description) { %><p class="office-page__about"><%= __(office.description) %></p><% } %>
  <p class="muted"><%= __("لطلب معاينة افتح الإعلان واختر اليوم والوقت المناسبين.") %></p>
</section>

<% if (total) { %>
  <p class="muted"><%= __(total) %> <%= __("إعلان") %></p>
  <ul class="lgrid">
    <% rows.forEach(function (l) { %>
      <%- include('_listing-card', { l, fmt, icon, types, displayTitle }) %>
    <% }) %>
  </ul>
  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%= __("الصفحات") %>">
      <% if (page > 1) { %><a href="<%= __(pageBase) %><%= __(page - 1 > 1 ? '?page=' + (page - 1) : '') %>"><%= __("السابق") %></a><% } %>
      <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
      <% if (page < pages) { %><a href="<%= __(pageBase) %>?page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
    </nav>
  <% } %>
<% } else { %>
  <p class="empty-state"><%= __("لا توجد إعلانات منشورة لهذا المكتب الآن.") %></p>
<% } %>


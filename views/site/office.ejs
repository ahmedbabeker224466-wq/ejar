<section class="card">
  <h1><%= __(office.name) %></h1>
  <p class="muted"><%= __(office.city) %></p>
  <% if (rating.count) { %><p class="stars-line"><span class="stars" aria-label="<%= rating.avg %> <%= __("من 5") %>"><% for (let i = 1; i <= 5; i++) { %><%- icon('star', i <= Math.round(rating.avg) ? 'li-icon star-on' : 'li-icon star-off') %><% } %></span> <b><%= rating.avg %></b> <span class="muted">(<%= rating.count %> <%= __("تقييم من مستأجرين وملّاك") %>)</span></p><% } %>
  <% if (office.description) { %><p class="office-page__about"><%= __(office.description) %></p><% } %>
  <p class="muted"><%= __("لطلب معاينة افتح الإعلان واختر اليوم والوقت المناسبين.") %></p>
</section>

<% if (comments.length) { %>
  <section class="card reviews-list">
    <h2><%= __("آراء العملاء") %></h2>
    <ul>
      <% comments.forEach(function (c) { %>
        <li>
          <span class="stars"><% for (let i = 1; i <= 5; i++) { %><%- icon('star', i <= c.rating ? 'li-icon star-on' : 'li-icon star-off') %><% } %></span>
          <p><%= c.comment %></p>
          <span class="muted"><%= __(roleLabels[c.role]) %> · <bdi dir="ltr"><%= c.month %></bdi></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (total) { %>
  <p class="muted"><%= __(total) %> <%= __("إعلان") %></p>
  <ul class="lgrid">
    <% rows.forEach(function (l) { %>
      <%- include('_listing-card', { l, fmt, icon, types, displayTitle }) %>
    <% }) %>
  </ul>
  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%= __("الصفحات") %>">
      <% if (page > 1) { %><a href="<%= __(pageBase) %><%= __(page - 1 > 1 ? '?page=' + (page - 1) : '') %>"><%= __("السابق") %></a><% } %>
      <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
      <% if (page < pages) { %><a href="<%= __(pageBase) %>?page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
    </nav>
  <% } %>
<% } else { %>
  <p class="empty-state"><%= __("لا توجد إعلانات منشورة لهذا المكتب الآن.") %></p>
<% } %>


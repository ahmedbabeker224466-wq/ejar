<section class="search-hero search-hero--rich">
  <h1><%= __("إعلانات العقارات للإيجار") %></h1>
  <p class="search-hero__lead"><%= __("شقق وفلل ومحلات للإيجار السنوي من مكاتب العقار، بالريال السعودي.") %></p>
  <form method="get" action="/listings" class="search-bar" novalidate>
    <div class="search-bar__main">
      <div class="search-bar__field"><label class="visually-hidden" for="f-city"><%= __("المدينة") %></label>
        <select id="f-city" name="city" class="select" data-hood-city>
          <option value=""><%= __("كل المدن") %></option>
          <%- include('../partials/city-options', { selected: filters.city }) %>
        </select></div>
      
      <div class="search-bar__field"><label class="visually-hidden" for="f-type"><%= __("النوع") %></label>
        <select id="f-type" name="type" class="select"><option value=""><%= __("كل الأنواع") %></option>
          <% Object.keys(types).forEach(function (t) { %><option value="<%= __(t) %>" <%= __(filters.type === t ? 'selected' : '') %>><%= __(types[t]) %></option><% }) %></select></div>
      <div class="search-bar__field"><label class="visually-hidden" for="f-rooms"><%= __("الغرف") %></label>
        <select id="f-rooms" name="rooms" class="select"><option value=""><%= __("كل الغرف") %></option>
          <% ['1', '2', '3', '4', '5+'].forEach(function (r) { %><option value="<%= __(r) %>" <%= __(rawFilters.rooms === r ? 'selected' : '') %>><%= __(r) %></option><% }) %></select></div>
        
        <div class="search-bar__field"><label class="visually-hidden" for="f-max"><%= __("أعلى إيجار سنوي") %></label><input id="f-max" name="max_price" class="input" inputmode="numeric" dir="ltr" maxlength="9" placeholder="<%= __("أعلى إيجار") %>" value="<%= __(rawFilters.max_price) %>"></div>
        
      <button type="submit" class="btn btn--primary search-bar__submit">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <%= __("بحث") %>
      </button>
      <details class="search-more" <%= (filters.neighborhood || rawFilters.min_price || (filters.sort && filters.sort !== 'rating')) ? 'open' : '' %>>
        <summary><%= __("خيارات أكثر") %></summary>
        <div class="search-more__fields">
          <div class="search-bar__field"><label class="visually-hidden" for="f-hood"><%= __("الحي") %></label>
          <select id="f-hood" name="neighborhood" class="select" data-hood-select>
            <option value=""><%= __("كل الأحياء") %></option>
            <% cities.forEach(function (c) { if (!(byCity[c] || []).length) return; var list = byCity[c].concat([other]); %>
              <optgroup label="<%= __(c) %>" data-city="<%= c %>">
                <% list.forEach(function (n) { %><option value="<%= n %>" <%= __(filters.neighborhood === n && (!filters.city || filters.city === c) ? 'selected' : '') %>><%= __(n) %></option><% }) %>
              </optgroup>
            <% }) %>
          </select></div>
          <div class="search-bar__field"><label class="visually-hidden" for="f-min"><%= __("أقل إيجار سنوي") %></label><input id="f-min" name="min_price" class="input" inputmode="numeric" dir="ltr" maxlength="9" placeholder="<%= __("أقل إيجار") %>" value="<%= __(rawFilters.min_price) %>"></div>
          <div class="search-bar__field"><label class="visually-hidden" for="f-sort"><%= __("الترتيب") %></label>
          <select id="f-sort" name="sort" class="select">
            <option value="rating" <%= __(filters.sort === 'rating' ? 'selected' : '') %>><%= __("الأعلى تقييماً") %></option>
            <option value="newest" <%= __(filters.sort === 'newest' ? 'selected' : '') %>><%= __("الأحدث") %></option>
            <option value="price_asc" <%= __(filters.sort === 'price_asc' ? 'selected' : '') %>><%= __("الأقل سعراً") %></option>
            <option value="price_desc" <%= __(filters.sort === 'price_desc' ? 'selected' : '') %>><%= __("الأعلى سعراً") %></option>
            <option value="area_desc" <%= __(filters.sort === 'area_desc' ? 'selected' : '') %>><%= __("الأكبر مساحة") %></option>
          </select></div>
        </div>
      </details>
      
    </div>
  </form>
</section>

<nav class="type-chips" aria-label="<%= __("نوع العقار") %>">
  <a href="/listings<%= __(filters.city ? '?city=' + encodeURIComponent(filters.city) : '') %>" class="type-chip<%= __(!filters.type ? ' is-on' : '') %>"><%= __("الكل") %></a>
  <% ['apartment', 'villa', 'shop', 'office', 'warehouse', 'land'].forEach(function (t) { %>
    <a href="/listings?type=<%= __(t) %><%= __(filters.city ? '&city=' + encodeURIComponent(filters.city) : '') %>" class="type-chip<%= __(filters.type === t ? ' is-on' : '') %>"><%= __(types[t]) %></a>
  <% }) %>
</nav>
<nav class="city-chips" aria-label="<%= __("المدن") %>">
  <% ['الرياض', 'جدة', 'مكة المكرمة', 'المدينة المنورة', 'الدمام', 'الخبر', 'أبها', 'الطائف'].forEach(function (c) { %><a href="/listings?city=<%= encodeURIComponent(c) %>" class="city-chip<%= filters.city === c ? ' is-on' : '' %>"><%= __(c) %></a><% }) %>
</nav>
<% if (locals.showcase) { %>
  <% if (showcase.total) { %>
    <p class="results-count"><strong><%= showcase.total %></strong> <%= __("إعلان متاح للإيجار السنوي") %></p>
    <% if (showcase.topRated.length) { %><%- include('_prow', { rowId: 'row-top', heading: __('الأعلى تقييماً'), rows: showcase.topRated, moreHref: '/listings?sort=rating&all=1' }) %><% } %>
    <% showcase.byCity.forEach(function (c, i) { %><%- include('_prow', { rowId: 'row-city-' + i, heading: (lang === 'en' ? 'In ' : 'في ') + __(c.city), rows: c.rows, moreHref: '/listings?city=' + encodeURIComponent(c.city) }) %><% }) %>
    <% if (showcase.newest.length) { %><%- include('_prow', { rowId: 'row-new', heading: __('أُضيفت حديثاً'), rows: showcase.newest, moreHref: '/listings?sort=newest' }) %><% } %>
  <% } else { %>
    <%- include('_listings-empty') %>
  <% } %>
<% } else { %>
  <p class="results-count"><strong><%= __(total) %></strong> <%= __("إعلان متاح للإيجار السنوي") %></p>
  <% if (rows.length) { %>
    <ul class="pgrid">
      <% rows.forEach(function (l) { %><%- include('_pcard', { l: l }) %><% }) %>
    </ul>
  <% } else { %>
    <%- include('_listings-empty') %>
  <% } %>
  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%= __("الصفحات") %>">
      <% if (page > 1) { %><a href="/listings?<%= __(qs) %><%= __(qs ? '&' : '') %>page=<%= __(page - 1) %>"><%= __("السابق") %></a><% } %>
      <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
      <% if (page < pages) { %><a href="/listings?<%= __(qs) %><%= __(qs ? '&' : '') %>page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
    </nav>
  <% } %>
<% } %>
<script src="<%= assetUrl('/js/carousel.js') %>" defer></script>
<script src="<%= assetUrl('/js/listingForm.js') %>" defer></script>

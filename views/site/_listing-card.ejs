<li class="listing-card card">
  <a href="/listings/<%= __(l.id) %>" class="listing-card__link">
    <% if (l.coverId) { %><img src="/listings/photos/<%= __(l.coverId) %>/thumb" alt="<%= __(l.title) %>" width="480" height="360" loading="lazy" class="listing-card__img">
    <% } else { %><div class="listing-card__img listing-card__img--empty" role="img" aria-label="<%= __("بدون صورة") %>"></div><% } %>
    <h2><%= __(l.title) %></h2>
    <p class="listing-card__price"><strong><%= __(fmt(l.price)) %></strong> <%= __("ريال / سنة") %></p>
    <p class="muted"><%= __(l.rooms !== null ? l.rooms + __(' غرف · ') : '') %><%= __(l.bathrooms !== null ? l.bathrooms + __(' دورات مياه · ') : '') %><%= __(l.area !== null ? l.area + __(' م²') : '') %></p>
    <p class="muted"><%= __(l.officeName) %></p>
  </a>
</li>

<li class="lcard">
  <a href="/listings/<%= __(l.id) %>" class="lcard__link">
    <span class="lcard__media">
      <% if (l.coverId) { %><img src="/listings/photos/<%= __(l.coverId) %>/thumb" alt="<%= displayTitle(l, lang, __) %>" width="480" height="360" loading="lazy">
      <% } else { %><span class="lcard__noimg" role="img" aria-label="<%= __("بدون صورة") %>"><%- icon('photos', 'lcard__noimg-icon') %></span><% } %>
      <span class="lcard__type"><%= __((locals.types && types[l.unitType]) || __('عقار')) %></span>
      <% if (l.photoCount > 1) { %><span class="lcard__count"><%- icon('photos') %><%= __(l.photoCount) %></span><% } %>
    </span>
    <span class="lcard__body">
      <span class="lcard__place"><%- icon('pin') %><% const hood = l.neighborhood && l.neighborhood !== 'أخرى'; %><%= lang === 'en' ? (hood ? l.neighborhood + ', ' : '') + __(l.city) : (hood ? 'حي ' + l.neighborhood + '، ' : '') + l.city %></span>
      <span class="lcard__facts">
        <% if (l.rooms !== null) { %><span><%- icon('bed') %><%= __(l.rooms) %> <%= __("غرف") %></span><% } %>
        <% if (l.bathrooms !== null) { %><span><%- icon('bath') %><%= __(l.bathrooms) %> <%= __("دورات مياه") %></span><% } %>
        <% if (l.area !== null) { %><span><%- icon('area') %><%= __(l.area) %> <%= __("م²") %></span><% } %>
      </span>
      <span class="lcard__price"><strong><%= __(fmt(l.price).replace(/\.00$/, '')) %></strong> <%= __("ريال سنوياً") %></span>
      <span class="lcard__office"><%- icon('office') %><span class="lcard__office-name"><%= l.officeName %></span><% if (l.officeRatingCount) { %><span class="stars-mini" title="<%= __("تقييم المكتب") %>"><%- icon('star', 'li-icon star-icon') %><b><%= l.officeRating %></b> <span>(<%= l.officeRatingCount %>)</span></span><% } %></span>
    </span>
  </a>
</li>

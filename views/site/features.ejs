<%
  const icon = (d) => '<span class="mk-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg></span>';
  const items = [
    ['contracts', '<rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/>'],
    ['owners', '<path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M10 21v-5h4v5"/>'],
    ['reminders', '<path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10 20a2 2 0 0 0 4 0"/>'],
    ['payments', '<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M7 15h3"/>'],
    ['maintenance', '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>'],
    ['team', '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5"/>'],
    ['reports', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'],
    ['listings', '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>'],
  ];
%>
<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap">
    <h1 id="page-title"><%= __(t('feat.title')) %></h1>
    <p><%= __(t('feat.lead')) %></p>
  </div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <div class="mk-cards">
      <% items.forEach(function (it) { %>
        <article class="mk-card"><%- icon(it[1]) %><h2><%= __(t('feat.' + it[0] + '.t')) %></h2><p><%= __(t('feat.' + it[0] + '.p')) %></p></article>
      <% }) %>
    </div>
  </div>
</section>

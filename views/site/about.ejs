<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap">
    <h1 id="page-title"><%= t('about.title') %></h1>
    <p><%= t('about.lead') %></p>
  </div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <div class="mk-panel mk-prose">
      <p class="mk-about-idea"><%= t('about.idea') %></p>
      <h2><%= t('about.operator') %></h2>
      <% if (seller.legal_name || seller.cr_number || seller.vat_number || seller.address) { %>
        <dl class="mk-dl">
          <% if (seller.legal_name) { %><dt><%= t('about.legalName') %></dt><dd><%= seller.legal_name %></dd><% } %>
          <% if (seller.cr_number) { %><dt><%= t('about.cr') %></dt><dd dir="ltr"><%= seller.cr_number %></dd><% } %>
          <% if (seller.vat_number) { %><dt><%= t('about.vat') %></dt><dd dir="ltr"><%= seller.vat_number %></dd><% } %>
          <% if (seller.address) { %><dt><%= t('about.address') %></dt><dd><%= seller.address %></dd><% } %>
        </dl>
      <% } else { %><p class="mk-meta"><%= t('about.pending') %></p><% } %>
      <p class="mk-page-cta"><a href="<%= L('/contact') %>" class="mk-btn mk-btn--brand mk-btn--lg"><%= t('contact.title') %></a></p>
    </div>
  </div>
</section>

<% const err = (k) => errors[k] ? (lang === 'en' ? t('contact.err.' + k) : errors[k]) : ''; %>
<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap">
    <h1 id="page-title"><%= t('contact.title') %></h1>
    <p><%= t('contact.lead') %></p>
  </div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <div class="mk-panel mk-panel--narrow">
      <% if (sent) { %><div class="mk-alert mk-alert--ok" role="status"><%= t('contact.sent') %></div><% } %>
      <% if (support.phone || support.email) { %>
        <p class="mk-meta"><%= t('contact.direct') %> <% if (support.phone) { %><span dir="ltr"><%= support.phone %></span> <% } %><% if (support.email) { %><span dir="ltr"><%= support.email %></span><% } %></p>
      <% } %>
      <form method="post" action="<%= L('/contact') %>" class="mk-form" novalidate>
        <div class="mk-field"><label for="name"><%= t('contact.name') %></label><input id="name" name="name" class="mk-input" maxlength="60" value="<%= values.name || '' %>" autocomplete="nickname">
          <% if (err('name')) { %><p class="mk-field__error"><%= err('name') %></p><% } %></div>
        <div class="mk-form__row">
          <div class="mk-field"><label for="phone"><%= t('contact.phone') %></label><input id="phone" name="phone" class="mk-input" type="tel" inputmode="tel" dir="ltr" maxlength="30" value="<%= values.phone || '' %>" autocomplete="tel">
            <% if (err('phone')) { %><p class="mk-field__error"><%= err('phone') %></p><% } %></div>
          <div class="mk-field"><label for="email"><%= t('contact.email') %></label><input id="email" name="email" class="mk-input" type="email" dir="ltr" maxlength="190" value="<%= values.email || '' %>" autocomplete="email">
            <% if (err('email')) { %><p class="mk-field__error"><%= err('email') %></p><% } %></div>
        </div>
        <% if (err('contact')) { %><p class="mk-field__error"><%= err('contact') %></p><% } %>
        <p class="mk-field__hint"><%= t('contact.hint') %></p>
        <div class="mk-field"><label for="message"><%= t('contact.message') %></label><textarea id="message" name="message" class="mk-input" rows="5" maxlength="1000" required><%= values.message || '' %></textarea>
          <% if (err('message')) { %><p class="mk-field__error"><%= err('message') %></p><% } %></div>
        <div class="mk-hp" aria-hidden="true"><label for="website"><%= t('contact.honeypot') %></label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        <button type="submit" class="mk-btn mk-btn--brand mk-btn--lg mk-btn--block"><%= t('contact.send') %></button>
      </form>
    </div>
  </div>
</section>

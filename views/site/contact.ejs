<% const err = (k) => errors[k] ? (lang === 'en' ? t('contact.err.' + k) : errors[k]) : ''; %>
<section class="mk-phero mk-phero--sm" aria-labelledby="page-title">
  <div class="mk-wrap">
    <h1 id="page-title"><%= __(t('contact.title')) %></h1>
    <p><%= __(t('contact.lead')) %></p>
  </div>
</section>
<section class="mk-lift">
  <div class="mk-wrap">
    <div class="mk-panel mk-panel--narrow">
      <% if (sent) { %><div class="mk-alert mk-alert--ok" role="status"><%= __(t('contact.sent')) %></div><% } %>
      <% if (support.phone || support.email) { %>
        <p class="mk-meta"><%= __(t('contact.direct')) %> <% if (support.phone) { %><span dir="ltr"><%= __(support.phone) %></span> <% } %><% if (support.email) { %><span dir="ltr"><%= __(support.email) %></span><% } %></p>
      <% } %>
      <form method="post" action="<%= L('/contact') %>" class="mk-form" novalidate>
        <div class="mk-field"><label for="name"><%= __(t('contact.name')) %></label><input id="name" name="name" class="mk-input" maxlength="60" value="<%= __(values.name || '') %>" autocomplete="nickname">
          <% if (err('name')) { %><p class="mk-field__error"><%= __(err('name')) %></p><% } %></div>
        <div class="mk-form__row">
          <div class="mk-field"><label for="phone"><%= __(t('contact.phone')) %></label><input id="phone" name="phone" class="mk-input" type="tel" inputmode="tel" dir="ltr" maxlength="30" value="<%= __(values.phone || '') %>" autocomplete="tel">
            <% if (err('phone')) { %><p class="mk-field__error"><%= __(err('phone')) %></p><% } %></div>
          <div class="mk-field"><label for="email"><%= __(t('contact.email')) %></label><input id="email" name="email" class="mk-input" type="email" dir="ltr" maxlength="190" value="<%= __(values.email || '') %>" autocomplete="email">
            <% if (err('email')) { %><p class="mk-field__error"><%= __(err('email')) %></p><% } %></div>
        </div>
        <% if (err('contact')) { %><p class="mk-field__error"><%= __(err('contact')) %></p><% } %>
        <p class="mk-field__hint"><%= __(t('contact.hint')) %></p>
        <div class="mk-field"><label for="message"><%= __(t('contact.message')) %></label><textarea id="message" name="message" class="mk-input" rows="5" maxlength="1000" required><%= __(values.message || '') %></textarea>
          <% if (err('message')) { %><p class="mk-field__error"><%= __(err('message')) %></p><% } %></div>
        <div class="mk-hp" aria-hidden="true"><label for="website"><%= __(t('contact.honeypot')) %></label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        <button type="submit" class="mk-btn mk-btn--brand mk-btn--lg mk-btn--block"><%= __(t('contact.send')) %></button>
      </form>
    </div>
  </div>
</section>

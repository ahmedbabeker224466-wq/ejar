<div class="page-head">
  <h1><%= __("الدفعات المتأخرة") %></h1>
  <a href="<%= __(csvUrl) %>" class="btn btn--secondary btn--small"><%= __("تصدير") %> CSV</a>
</div>

<form class="card filter-bar" method="get" action="/office/payments" role="search">
  <div class="field">
    <label for="q"><%= __("بحث باسم الوحدة") %></label>
    <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= __(filters.q) %>">
  </div>
  <div class="filter-grid">
    <div class="field">
      <label for="landlord"><%= __("المالك") %></label>
      <select id="landlord" name="landlord" class="select">
        <option value=""><%= __("الكل") %></option>
        <% landlords.forEach(function (l) { %><option value="<%= __(l.id) %>" <%= __(filters.landlordId === Number(l.id) ? 'selected' : '') %>><%= __(l.label) %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="days"><%= __("تأخر لا يقل عن") %></label>
      <select id="days" name="days" class="select">
        <option value=""><%= __("أي مدة") %></option>
        <% buckets.forEach(function (d) { %><option value="<%= __(d) %>" <%= __(filters.minDays === d ? 'selected' : '') %>><%= __(d) %> <%= __("يوم") %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="from"><%= __("استحقاق من") %></label>
      <input id="from" name="from" class="input" type="date" value="<%= __(filters.from) %>">
    </div>
    <div class="field">
      <label for="to"><%= __("استحقاق إلى") %></label>
      <input id="to" name="to" class="input" type="date" value="<%= __(filters.to) %>">
    </div>
  </div>
  <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
</form>

<section class="stats" aria-label="<%= __("ملخص المتأخرات") %>">
  <div class="stat card"><p class="stat__value"><%= __(total) %></p><p class="stat__label"><%= __("دفعات متأخرة") %></p></div>
  <div class="stat card"><p class="stat__value"><%= __(fmt(remainingHalalas)) %></p><p class="stat__label"><%= __("المتبقي (ريال)") %></p></div>
</section>

<% if (rows.length === 0) { %>
  <section class="card empty-card">
    <p class="lead"><%= __(filtered ? __('لا توجد دفعات متأخرة تطابق البحث.') : __('لا توجد دفعات متأخرة. ممتاز!')) %></p>
    <% if (filtered) { %><a href="/office/payments" class="btn btn--secondary"><%= __("عرض الكل") %></a><% } %>
  </section>
<% } else { %>
  <ul class="item-list">
    <% rows.forEach(function (r) { %>
      <li class="item">
        <div class="item__title">
          <a href="/office/contracts/<%= __(r.contract_id) %>#payments"><%= __(r.unit_label || __('وحدة')) %></a>
          <span class="badge badge--pay-late"><%= __("متأخرة") %> <%= __(r.daysOverdue) %> <%= __("يوم") %></span>
          <% if (r.status === 'tenant_reported') { %><span class="badge badge--pay-tenant_reported"><%= __("أبلغ المستأجر بالدفع") %></span><% } %>
        </div>
        <p class="item__meta"><%= __("المالك:") %> <%= __(r.landlord_label || '—') %> · <%= __("الاستحقاق") %> <span dir="ltr"><%= __(String(r.due_date).slice(0, 10)) %></span></p>
        <p class="item__meta"><%= __("المبلغ") %> <%= __(fmt(r.totalHalalas)) %> · <%= __("المدفوع") %> <%= __(fmt(r.paidHalalas)) %> · <strong><%= __("المتبقي") %> <%= __(fmt(r.remainingHalalas)) %> <%= __("ريال") %></strong></p>
      </li>
    <% }) %>
  </ul>
  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%= __("الصفحات") %>">
      <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= __(prevUrl) %>"><%= __("السابق") %></a><% } else { %><span></span><% } %>
      <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
      <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= __(nextUrl) %>"><%= __("التالي") %></a><% } else { %><span></span><% } %>
    </nav>
  <% } %>
<% } %>

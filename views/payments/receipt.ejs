<p class="back-link no-print"><a href="<%= __(backUrl) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع") %></a></p>
<section class="card detail-card receipt" id="receipt">
  <div class="page-head">
    <h1><%= __("كشف دفعات العقد") %></h1>
    <button type="button" class="btn btn--primary btn--small no-print" data-print><%= __("طباعة") %></button>
  </div>
  <dl class="details">
    <dt><%= __("المكتب") %></dt><dd><%= __(officeName) %></dd>
    <% if (unitLabel) { %><dt><%= __("الوحدة") %></dt><dd><%= __(unitLabel) %></dd><% } %>
    <dt><%= __("مدة العقد") %></dt><dd><span dir="ltr"><%= __(startDate) %></span> <%= __("إلى") %> <span dir="ltr"><%= __(endDate) %></span></dd>
    <dt><%= __("تاريخ الكشف") %></dt><dd dir="ltr"><%= __(today) %></dd>
  </dl>

  <% if (history.length) { %>
    <ul class="receipt-list">
      <% history.forEach(function (p, i) { %>
        <li class="receipt-row">
          <div class="receipt-row__head">
            <strong><%= __("دفعة") %> <%= __(i + 1) %> · <span dir="ltr"><%= __(String(p.due_date).slice(0, 10)) %></span></strong>
            <span class="badge badge--pay-<%= __(p.partial ? 'partial' : p.shownStatus) %>"><%= __(p.partial ? __('دفعة جزئية') : paymentLabels[p.shownStatus]) %></span>
          </div>
          <dl class="receipt-row__figures">
            <div><dt><%= __("المبلغ") %></dt><dd><%= __(fmt(p.totalHalalas)) %></dd></div>
            <div><dt><%= __("المدفوع") %></dt><dd><%= __(fmt(p.paidHalalas)) %></dd></div>
            <div><dt><%= __("المتبقي") %></dt><dd><%= __(fmt(p.remainingHalalas)) %></dd></div>
          </dl>
          <% p.entries.filter(function (e) { return !e.undone_at; }).forEach(function (e) { %>
            <p class="receipt__entry">↳ <%= __(fmt(e.halalas)) %> <%= __("ريال في") %> <span dir="ltr"><%= __(e.paidOn) %></span><%= __(e.method ? ` · ${methods[e.method] || ''}` : '') %><%= __(e.reference_code ? ` · مرجع: ${e.reference_code}` : '') %></p>
          <% }) %>
        </li>
      <% }) %>
    </ul>
    <dl class="receipt-total">
      <div><dt><%= __("مجموع الدفعات") %></dt><dd><%= __(fmt(totals.scheduled)) %></dd></div>
      <div><dt><%= __("المدفوع") %></dt><dd><%= __(fmt(totals.collected)) %></dd></div>
      <div><dt><%= __("المتبقي") %></dt><dd><%= __(fmt(totals.remaining)) %></dd></div>
    </dl>
    <p class="muted"><%= __("المبالغ بالريال السعودي. هذا الكشف للتتبع فقط ولا يُثبت سداداً رسمياً.") %></p>
  <% } else { %>
    <p class="empty-state"><%= __("لا توجد دفعات لهذا العقد.") %></p>
  <% } %>
</section>
<script src="<%= assetUrl('/js/print.js') %>" defer></script>

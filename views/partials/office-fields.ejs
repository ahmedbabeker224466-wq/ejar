<%# The office details form fields, shared by /office/new and /office/settings. %>
<div class="field">
  <label for="name"><%= __("اسم المكتب") %></label>
  <input id="name" name="name" class="input" type="text" maxlength="150" required
         value="<%= __(values.name) %>" <%- errors.name ? 'aria-invalid="true" aria-describedby="name-error"' : '' %>>
  <% if (errors.name) { %><p id="name-error" class="field-error"><%= __(errors.name) %></p><% } %>
</div>

<div class="field">
  <label for="city"><%= __("المدينة") %></label>
  <select id="city" name="city" class="select" required <%- errors.city ? 'aria-invalid="true" aria-describedby="city-error"' : '' %>>
    <%- include('city-options', { selected: values.city }) %>
  </select>
  <% if (errors.city) { %><p id="city-error" class="field-error"><%= __(errors.city) %></p><% } %>
</div>

<div class="field">
  <label for="phone"><%= __("هاتف المكتب") %></label>
  <input id="phone" name="phone" class="input" type="tel" inputmode="tel" dir="ltr" maxlength="20" required
         value="<%= __(values.phone) %>" <%- errors.phone ? 'aria-invalid="true" aria-describedby="phone-error"' : 'aria-describedby="phone-hint"' %>>
  <% if (errors.phone) { %><p id="phone-error" class="field-error"><%= __(errors.phone) %></p><% } else { %>
    <p id="phone-hint" class="field-hint"><%= __("جوال أو هاتف ثابت، مثال: 0512345678") %></p>
  <% } %>
</div>

<div class="field">
  <label for="email"><%= __("البريد الإلكتروني") %> <span class="muted">(<%= __("اختياري)") %></span></label>
  <input id="email" name="email" class="input" type="email" dir="ltr" maxlength="190"
         value="<%= __(values.email) %>" <%- errors.email ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>>
  <% if (errors.email) { %><p id="email-error" class="field-error"><%= __(errors.email) %></p><% } %>
</div>

<% const licReq = Boolean(locals.licenceRequired); const licLocked = Boolean(locals.licenceLocked); %>
<div class="field">
  <label for="rega_license"><%= __("رقم ترخيص فال من الهيئة العامة للعقار") %><% if (!licReq) { %> <span class="muted">(<%= __("اختياري)") %></span><% } %></label>
  <input id="rega_license" name="rega_license" class="input" type="text" inputmode="numeric" dir="ltr" maxlength="20" <%- licReq ? 'required' : '' %> <%- licLocked && values.rega_license ? 'readonly' : '' %>
         value="<%= values.rega_license %>" <%- errors.rega_license ? 'aria-invalid="true" aria-describedby="rega-error"' : 'aria-describedby="rega-hint"' %>>
  <% if (errors.rega_license) { %><p id="rega-error" class="field-error"><%= __(errors.rega_license) %></p><% } else if (licLocked && values.rega_license) { %>
    <p id="rega-hint" class="field-hint"><%= __("لتغيير هذا الرقم تواصل مع الدعم.") %></p>
  <% } else { %>
    <p id="rega-hint" class="field-hint"><%= __("الرقم المكتوب في رخصة فال للوساطة والتسويق العقاري للمنشأة.") %></p>
  <% } %>
</div>

<div class="field">
  <label for="cr_number"><%= __("رقم السجل التجاري") %><% if (!licReq) { %> <span class="muted">(<%= __("اختياري)") %></span><% } %></label>
  <input id="cr_number" name="cr_number" class="input" type="text" inputmode="numeric" dir="ltr" maxlength="20" <%- licReq ? 'required' : '' %> <%- licLocked && values.cr_number ? 'readonly' : '' %>
         value="<%= values.cr_number %>" <%- errors.cr_number ? 'aria-invalid="true" aria-describedby="cr-error"' : 'aria-describedby="cr-hint"' %>>
  <% if (errors.cr_number) { %><p id="cr-error" class="field-error"><%= __(errors.cr_number) %></p><% } else if (licLocked && values.cr_number) { %>
    <p id="cr-hint" class="field-hint"><%= __("لتغيير هذا الرقم تواصل مع الدعم.") %></p>
  <% } else { %>
    <p id="cr-hint" class="field-hint"><%= __("يتكون من 10 أرقام.") %></p>
  <% } %>
</div>

<% if (flash && flash.length) { %>
  <div class="flash-list">
    <% flash.forEach(function (item) { %>
      <div class="flash flash--<%= __(item.type || 'info') %>" role="<%= __(item.type === 'danger' ? 'alert' : 'status') %>">
        <%= __(item.message) %>
      </div>
    <% }) %>
  </div>
<% } %>

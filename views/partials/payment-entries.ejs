<%# One installment's payment entries, the record form and undo. Locals: p, base, canRecord, undoable(e), fmt, methods, roleLabels, today %>
<% if (p.entries.length) { %>
  <ul class="entries">
    <% p.entries.forEach(function (e) { %>
      <li class="entry<%= __(e.undone_at ? ' entry--undone' : '') %>">
        <span><strong><%= __(fmt(e.halalas)) %> <%= __("ريال") %></strong> · <span dir="ltr"><%= __(e.paidOn) %></span><%= __(e.method ? ` · ${methods[e.method] || ''}` : '') %> · <%= __(roleLabels[e.recorded_role] || '') %><%= __(e.reference_code ? ` · مرجع: ${e.reference_code}` : '') %></span>
        <% if (e.undone_at) { %>
          <span class="muted"><%= __("مُلغاة:") %> <%= __(e.undo_reason) %></span>
        <% } else if (undoable(e)) { %>
          <details class="payment__edit">
            <summary><%= __("تراجع عن هذه الدفعة") %></summary>
            <form method="post" action="<%= __(base) %>/entries/<%= __(e.id) %>/undo">
              <div class="field">
                <label for="reason-<%= __(e.id) %>"><%= __("سبب التراجع") %></label>
                <input id="reason-<%= __(e.id) %>" name="reason" class="input" type="text" maxlength="200" required>
                <p class="field-hint"><%= __("يمكن التراجع خلال 24 ساعة من التسجيل، ويُسجَّل في سجل التدقيق.") %></p>
              </div>
              <button type="submit" class="btn btn--secondary btn--block"><%= __("تأكيد التراجع") %></button>
            </form>
          </details>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>
<% if (p.partial) { %><p class="muted"><%= __("المدفوع") %> <%= __(fmt(p.paidHalalas)) %> <%= __("من") %> <%= __(fmt(p.totalHalalas)) %> <%= __("ريال، والمتبقي") %> <strong><%= __(fmt(p.remainingHalalas)) %> <%= __("ريال") %></strong>.</p><% } %>
<% if (canRecord && p.remainingHalalas > 0 && p.status !== 'waived') { %>
  <details class="payment__edit">
    <summary><%= __("تسجيل دفعة") %></summary>
    <form method="post" action="<%= __(base) %>/entries">
      <div class="form-grid">
        <div class="field">
          <label for="amount-<%= __(p.id) %>"><%= __("المبلغ (ريال)") %></label>
          <input id="amount-<%= __(p.id) %>" name="amount" class="input" type="text" inputmode="decimal" dir="ltr" value="<%= __((p.remainingHalalas / 100).toFixed(2)) %>">
          <p class="field-hint"><%= __("المتبقي") %> <%= __(fmt(p.remainingHalalas)) %>. <%= __("اكتب أقل منه لدفعة جزئية.") %></p>
        </div>
        <div class="field">
          <label for="paid-<%= __(p.id) %>"><%= __("تاريخ الدفع") %></label>
          <input id="paid-<%= __(p.id) %>" name="paid_on" class="input" type="date" max="<%= __(today) %>" value="<%= __(today) %>">
        </div>
        <div class="field">
          <label for="method-<%= __(p.id) %>"><%= __("الطريقة") %></label>
          <select id="method-<%= __(p.id) %>" name="method" class="select">
            <% Object.entries(methods).forEach(function ([key, label]) { %><option value="<%= __(key) %>"><%= __(label) %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="ref-<%= __(p.id) %>"><%= __("رمز المرجع (اختياري)") %></label>
          <input id="ref-<%= __(p.id) %>" name="reference" class="input" type="text" dir="ltr" maxlength="40" autocomplete="off">
          <p class="field-hint"><%= __("مثل رقم الإيصال. لا تكتب رقم حساب أو آيبان.") %></p>
        </div>
      </div>
      <button type="submit" class="btn btn--primary btn--block"><%= __("حفظ الدفعة") %></button>
    </form>
  </details>
<% } %>

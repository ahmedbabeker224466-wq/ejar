<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="ميعاد - الصفحة الرئيسية">
      <span class="logo__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m9 15 2 2 4-4"/></svg>
      </span>
      <span class="logo__text">ميعاد</span>
    </a>

    <input type="checkbox" id="site-menu-toggle" class="site-menu-toggle" aria-hidden="true" tabindex="-1">
    <label for="site-menu-toggle" class="site-menu-button" aria-label="القائمة">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </label>

    <nav class="site-nav" aria-label="القائمة الرئيسية">
      <a href="/" class="site-nav__home" <%- currentPath === '/' || currentPath.indexOf('/listings') === 0 ? 'aria-current="page"' : '' %>>الإعلانات</a>
      <a href="/offices" <%- currentPath === '/offices' ? 'aria-current="page"' : '' %>>لمكاتب العقار</a>
      <a href="/pricing" <%- currentPath === '/pricing' ? 'aria-current="page"' : '' %>>الأسعار</a>
      <a href="/blog" <%- currentPath.indexOf('/blog') === 0 ? 'aria-current="page"' : '' %>>المدونة</a>
      <% if (!currentUser) { %><a href="/register" class="site-nav__register">سجّل مكتبك</a><% } %>
    </nav>

    <div class="site-actions">
      <% if (currentUser) { %>
        <%- include('bell') %>
        <a href="/logout" class="btn btn--secondary btn--small">تسجيل الخروج</a>
      <% } else { %>
        <a href="/register" class="btn btn--ghost btn--small" <%- currentPath === '/register' ? 'aria-current="page"' : '' %>>سجّل مكتبك</a>
        <a href="/login" class="btn btn--primary btn--small" <%- currentPath === '/login' ? 'aria-current="page"' : '' %>>تسجيل الدخول</a>
      <% } %>
    </div>

    <% if (locals.areas && areas.length > 1) { %>
      <nav class="area-switch" aria-label="التبديل بين الصفحات">
        <% areas.forEach(function (a) { %>
          <a href="<%= a.href %>" class="btn btn--small <%= a.key === locals.currentArea ? 'btn--primary' : 'btn--secondary' %>" <%- a.key === locals.currentArea ? 'aria-current="page"' : '' %>><%= a.label %></a>
        <% }) %>
      </nav>
    <% } %>
  </div>
</header>

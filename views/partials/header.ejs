<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="<%= __("ميعاد - الصفحة الرئيسية") %>">
      <span class="logo__mark" aria-hidden="true">
        <%- include('../partials/brand-mark', { bid: 'p' }) %>
      </span>
      <span class="logo__text"><span class="brand-word" lang="en" dir="ltr">miaad</span></span>
    </a>

    <input type="checkbox" id="site-menu-toggle" class="site-menu-toggle" aria-hidden="true" tabindex="-1">
    <label for="site-menu-toggle" class="site-menu-button" aria-label="<%= __("القائمة") %>">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </label>

    <nav class="site-nav" aria-label="<%= __("القائمة الرئيسية") %>">
      <a href="/" class="site-nav__home"><%= __("الرئيسية") %></a>
      <a href="/listings" <%- currentPath.indexOf('/listings') === 0 ? 'aria-current="page"' : '' %>><%= __("الإعلانات") %></a>
      <a href="/pricing" <%- currentPath === '/pricing' ? 'aria-current="page"' : '' %>><%= __("الأسعار") %></a>
      <% if (locals.blogLive) { %><a href="/blog" <%- currentPath.indexOf('/blog') === 0 ? 'aria-current="page"' : '' %>><%= __("المدونة") %></a><% } %>
      <% if (!currentUser) { %><a href="/register" class="site-nav__register"><%= __("سجّل مكتبك") %></a><% } %>
      <% if (currentUser) { %><a href="/logout" class="site-nav__logout"><%= __("تسجيل الخروج") %></a><% } %>
    </nav>

    <div class="site-actions">
      <%- include('lang-switch') %>
      <% if (currentUser) { %>
        <%- include('bell') %>
        <a href="/logout" class="btn btn--secondary btn--small"><%= __("تسجيل الخروج") %></a>
      <% } else { %>
        <a href="/register" class="btn btn--ghost btn--small" <%- currentPath === '/register' ? 'aria-current="page"' : '' %>><%= __("سجّل مكتبك") %></a>
        <a href="/login" class="btn btn--primary btn--small" <%- currentPath === '/login' ? 'aria-current="page"' : '' %>><%= __("تسجيل الدخول") %></a>
      <% } %>
    </div>

    <% if (locals.areas && areas.length > 1) { %>
      <nav class="area-switch" aria-label="<%= __("التبديل بين الصفحات") %>">
        <% areas.forEach(function (a) { %>
          <a href="<%= __(a.href) %>" class="btn btn--small <%= __(a.key === locals.currentArea ? 'btn--primary' : 'btn--secondary') %>" <%- a.key === locals.currentArea ? 'aria-current="page"' : '' %>><%= __(a.label) %></a>
        <% }) %>
      </nav>
    <% } %>
  </div>
</header>

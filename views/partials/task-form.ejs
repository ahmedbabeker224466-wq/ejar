<%# Locals: action, values, errors, members, linkTypes, limits, submit %>
<form method="post" action="<%= action %>" novalidate>
  <div class="field">
    <label for="title">عنوان المهمة</label>
    <input id="title" name="title" class="input" type="text" maxlength="<%= limits.title %>" value="<%= values.title %>" required <%= errors.title ? 'aria-invalid=true' : '' %>>
    <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
  </div>
  <div class="field">
    <label for="description">الوصف (اختياري)</label>
    <textarea id="description" name="description" class="textarea" rows="3" maxlength="<%= limits.description %>"><%= values.description %></textarea>
    <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
  </div>
  <div class="form-grid">
    <div class="field">
      <label for="due_date">تاريخ الاستحقاق</label>
      <input id="due_date" name="due_date" class="input" type="date" value="<%= values.due_date %>">
      <% if (errors.due_date) { %><p class="field-error"><%= errors.due_date %></p><% } %>
    </div>
    <div class="field">
      <label for="assignee">المسؤول</label>
      <select id="assignee" name="assignee" class="select">
        <option value="">بدون مسؤول</option>
        <% members.forEach(function (m) { %><option value="<%= m.user_id %>" <%= String(values.assignee) === String(m.user_id) ? 'selected' : '' %>><%= m.display %> (<%= m.roleLabel %>)</option><% }) %>
      </select>
      <% if (errors.assignee) { %><p class="field-error"><%= errors.assignee %></p><% } %>
    </div>
    <div class="field">
      <label for="link_type">ربط بـ (اختياري)</label>
      <select id="link_type" name="link_type" class="select">
        <option value="">بدون ربط</option>
        <% Object.entries(linkTypes).forEach(function ([key, label]) { %><option value="<%= key %>" <%= values.link_type === key ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="link_id">رقم العنصر المرتبط</label>
      <input id="link_id" name="link_id" class="input" type="text" inputmode="numeric" dir="ltr" maxlength="12" value="<%= values.link_id %>">
      <p class="field-hint">الرقم الظاهر في رابط صفحة العقد أو الوحدة أو الطلب.</p>
      <% if (errors.link) { %><p class="field-error"><%= errors.link %></p><% } %>
    </div>
  </div>
  <button type="submit" class="btn btn--primary btn--block"><%= submit %></button>
</form>

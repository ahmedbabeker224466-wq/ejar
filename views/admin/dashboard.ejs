<div class="page-head"><h1><%= __("لوحة المنصة") %></h1></div>
<% if (data.pendingReview || data.pendingTransfers || data.suspiciousOrders) { %>
  <section class="card detail-card">
    <h2><%= __("يحتاج انتباهك") %></h2>
    <ul class="action-list">
      <% if (data.pendingReview) { %><li><a href="/admin/offices?status=review"><%= __("مكاتب جديدة بانتظار مراجعة الرخصة:") %> <strong><%= __(data.pendingReview) %></strong></a></li><% } %>
      <% if (data.pendingTransfers) { %><li><a href="/admin/transfers?status=pending"><%= __("حوالات بنكية بانتظار المراجعة:") %> <strong><%= __(data.pendingTransfers) %></strong></a></li><% } %>
      <% if (data.suspiciousOrders) { %><li><a href="/admin/orders?suspicious=1"><%= __("طلبات مشبوهة (مبلغ لا يطابق):") %> <strong><%= __(data.suspiciousOrders) %></strong></a></li><% } %>
    </ul>
  </section>
<% } %>

<div class="stats">
  <div class="stat card"><span class="stat__value"><%= __(data.totalOffices) %></span><span class="stat__label"><%= __("إجمالي المكاتب") %></span></div>
  <div class="stat card"><span class="stat__value"><%= __(fmt(data.mrr)) %></span><span class="stat__label"><%= __("الإيراد الشهري المتكرر (ريال، قبل الضريبة)") %></span></div>
  <div class="stat card"><span class="stat__value"><%= __(data.newOffices) %></span><span class="stat__label"><%= __("مكاتب جديدة هذا الشهر") %></span></div>
  <div class="stat card"><span class="stat__value"><%= __(data.contracts) %></span><span class="stat__label"><%= __("إجمالي العقود") %></span></div>
  <div class="stat card"><span class="stat__value"><%= __(data.aiReads) %></span><span class="stat__label"><%= __("قراءات الذكاء الاصطناعي هذا الشهر") %></span></div>
</div>

<section class="card detail-card">
  <h2><%= __("المكاتب حسب الحالة") %></h2>
  <% const labels = { trial: __('تجربة'), active: __('مشترك فعّال'), past_due: __('غير مسدَّد'), suspended: __('موقوف') }; %>
  <ul class="adm-bars">
    <% Object.keys(labels).forEach(function (key) { const n = Number(data.byStatus[key]) || 0; const pct = data.totalOffices ? Math.round((n / data.totalOffices) * 100) : 0; %>
      <li class="adm-bar adm-bar--<%= __(key) %>">
        <div class="adm-bar__head"><span><%= __(labels[key]) %></span><strong><%= __(n) %></strong></div>
        <div class="adm-bar__track"><span class="adm-bar__fill" data-w="<%= __(pct) %>"></span></div>
      </li>
    <% }) %>
  </ul>
  <p class="muted"><%= __("منها") %> <%= __(data.trialOver) %> <%= __("مكتب انتهت تجربته ولم يشترك.") %></p>
</section>

<section class="card detail-card">
  <h2><%= __("الإشعارات في آخر 7 أيام") %></h2>
  <div class="table-wrap">
    <table class="table">
      <tbody>
        <tr><th><%= __("إشعارات أُنشئت") %></th><td><%= __(data.notifications) %></td></tr>
        <tr><th><%= __("رسائل خارجية أُرسلت") %></th><td><%= __(data.deliveries.sent) %></td></tr>
        <tr><th><%= __("رسائل فشلت") %></th><td><%= __(data.deliveries.failed) %></td></tr>
        <tr><th><%= __("رسائل معلقة") %></th><td><%= __(data.deliveries.pending) %></td></tr>
        <tr><th><%= __("رسائل تُخطّيت (قناة غير مفعّلة)") %></th><td><%= __(data.deliveries.skipped) %></td></tr>
      </tbody>
    </table>
  </div>
</section>

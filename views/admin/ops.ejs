<div class="page-head"><h1><%= __("التشغيل والنسخ الاحتياطي") %></h1></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card">
  <h2><%= __("حالة النظام") %></h2>
  <% if (!snapshot) { %>
    <p class="muted"><%= __("لم يعمل الفحص الدوري بعد (كل 15 دقيقة).") %></p>
  <% } else { %>
    <p>
      <span class="badge badge--bill-<%= __(snapshot.ok ? 'success' : 'danger') %>"><%= __(snapshot.ok ? __('كل شيء سليم') : __('يوجد تنبيه')) %></span>
      <span class="muted"><%= __("آخر فحص:") %> <span dir="ltr"><%= __(ageText(snapshot.at)) %></span></span>
    </p>
    <% if (snapshot.issues && snapshot.issues.length) { %>
      <ul class="item-list">
        <% snapshot.issues.forEach(function (key) { %>
          <li class="item"><strong><%= __(labels[key] || key) %></strong><% if (snapshot.details && snapshot.details[key]) { %> <span class="muted"><%= __(snapshot.details[key]) %></span><% } %></li>
        <% }) %>
      </ul>
    <% } %>
    <% if (snapshot.checks && snapshot.checks.db !== false) { %>
      <ul class="item-list">
        <li class="item"><%= __("آخر تشغيل للمهام المجدولة:") %> <%= __(snapshot.checks.cronAgeMinutes === null ? '—' : __('قبل ') + snapshot.checks.cronAgeMinutes + __(' دقيقة')) %></li>
        <li class="item"><%= __("آخر نسخة ناجحة:") %> <%= __(snapshot.checks.backupAgeHours === null ? '—' : __('قبل ') + snapshot.checks.backupAgeHours + __(' ساعة')) %></li>
        <li class="item"><%= __("طابور الرسائل:") %> <%= __(snapshot.checks.queue ? snapshot.checks.queue.pending : 0) %> <%= __("رسالة معلقة") %></li>
        <li class="item"><%= __("رسائل فشلت في الساعة الماضية:") %> <%= __(snapshot.checks.failedLastHour) %></li>
        <li class="item"><%= __("دفعات مشبوهة:") %> <%= __(snapshot.checks.suspiciousOrders) %></li>
      </ul>
    <% } %>
  <% } %>
</section>

<section class="card">
  <h2><%= __("النسخ الاحتياطي") %></h2>
  <p class="muted"><%= __("كل يوم 02:00 بتوقيت الرياض، مشفّرة بمفتاح الخادم. لا يوجد تنزيل من هنا؛ حمّل الملفات من «مدير الملفات» في cPanel (مجلد النسخ الاحتياطي).") %></p>
  <form method="post" action="/admin/ops/backup" class="inline-form" novalidate>
    <label class="visually-hidden" for="backup-reason"><%= __("السبب") %></label>
    <input id="backup-reason" name="reason" class="input" maxlength="200" placeholder="<%= __("لماذا تشغّل نسخة الآن؟") %>" required>
    <button type="submit" class="btn btn--primary"><%= __("نسخة احتياطية الآن") %></button>
  </form>
  <ul class="item-list">
    <% backups.forEach(function (b) { %>
      <li class="item">
        <div class="item__title"><strong dir="ltr"><%= __(b.filename || '—') %></strong>
          <span class="badge badge--bill-<%= __(b.status === 'ok' ? 'success' : (b.status === 'running' ? 'warning' : 'danger')) %>"><%= __(b.status === 'ok' ? __('ناجحة') : (b.status === 'running' ? __('جارية') : __('فشلت'))) %></span>
          <span class="muted"><%= __(b.trigger_kind === 'manual' ? __('يدوية') : __('مجدولة')) %></span>
        </div>
        <div class="item__meta"><%= __(sizeText(b.size_bytes)) %> · <%= __(ageText(b.created_at)) %><% if (b.tables_count) { %> · <%= __(b.tables_count) %> <%= __("جدولاً") %><% } %><% if (b.error_code) { %> · <%= __("رمز الخطأ") %> <span dir="ltr"><%= __(b.error_code) %></span><% } %></div>
        <% if (b.sha256) { %><div class="item__meta" dir="ltr">sha256: <%= __(b.sha256) %></div><% } %>
      </li>
    <% }) %>
  </ul>
  <% if (!backups.length) { %><p class="empty-state"><%= __("لا توجد نسخ بعد.") %></p><% } %>
</section>

<section class="card">
  <h2><%= __("رصيد الرسائل") %></h2>
  <% if (!sms) { %><p class="muted"><%= __("لم يُفحص بعد (يومياً 10:00).") %></p>
  <% } else if (!sms.supported) { %><p class="muted"><%= __("مزوّد الرسائل الحالي لا يدعم قراءة الرصيد.") %></p>
  <% } else if (!sms.ok) { %><p><%= __("تعذّرت قراءة الرصيد") %> (<span dir="ltr"><%= __(sms.error) %></span>).</p>
  <% } else { %><p><%= __("الرصيد:") %> <strong dir="ltr"><%= __(sms.balance) %></strong> <span class="muted"><%= __(ageText(sms.at)) %></span></p><% } %>
</section>

<section class="card">
  <h2><%= __("التقارير الشهرية") %></h2>
  <ul class="item-list">
    <% reports.forEach(function (r) { %>
      <li class="item">
        <div class="item__title"><strong dir="ltr"><%= __(r.period) %></strong></div>
        <div class="item__meta"><%= __("مكاتب جديدة") %> <%= __(r.data.new_offices) %> · <%= __("اشتراكات نشطة") %> <%= __(r.data.active_subscriptions) %> · <%= __("الدخل الشهري") %> <span dir="ltr"><%= __(r.data.mrr_sar) %></span> <%= __("ريال") %> · <%= __("مغادرون") %> <%= __(r.data.churned_offices) %></div>
        <div class="item__meta"><%= __("إشعارات") %> <%= __(r.data.notifications_created) %> · <%= __("قراءات ذكاء") %> <%= __(r.data.ai_reads) %> · <%= __("نجاح النسخ") %> <%= __(r.data.backup_success_pct === null ? '—' : r.data.backup_success_pct + '%') %> · <%= __("رسائل تواصل") %> <%= __(r.data.support_contact_messages) %></div>
      </li>
    <% }) %>
  </ul>
  <% if (!reports.length) { %><p class="empty-state"><%= __("يصدر أول تقرير في أول يوم من الشهر القادم.") %></p><% } %>
</section>

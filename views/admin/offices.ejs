<div class="page-head"><h1><%= __("المكاتب") %></h1></div>
<form method="get" action="/admin/offices" class="filter-bar" novalidate>
  <div class="field"><label for="q"><%= __("بحث بالاسم أو الجوال") %></label><input id="q" name="q" class="input" value="<%= __(q) %>" maxlength="60"></div>
  <div class="field"><label for="status"><%= __("الحالة") %></label>
    <select id="status" name="status" class="select">
      <option value=""><%= __("الكل") %></option>
      <% statuses.forEach(function (s) { %><option value="<%= __(s) %>" <%= __(status === s ? 'selected' : '') %>><%= __({ trial: __('تجربة'), active: __('فعّال'), past_due: __('غير مسدَّد'), suspended: __('موقوف') }[s]) %></option><% }) %>
    </select></div>
  <button type="submit" class="btn btn--primary"><%= __("بحث") %></button>
</form>
<p class="muted"><%= __(total) %> <%= __("مكتب") %></p>
<ul class="item-list">
  <% rows.forEach(function (o) { %>
    <li class="item">
      <div class="item__title"><a href="/admin/offices/<%= __(o.id) %>"><strong><%= __(o.name) %></strong></a>
        <span class="badge badge--bill-<%= __(o.status === 'active' ? 'success' : o.status === 'trial' ? 'info' : 'danger') %>"><%= __({ trial: __('تجربة'), active: __('فعّال'), past_due: __('غير مسدَّد'), suspended: __('موقوف') }[o.status]) %></span></div>
      <div class="item__meta"><%= __(o.city) %> · <%= __("الباقة:") %> <%= __(o.plan_name || '—') %> · <%= __("وحدات") %> <%= __(o.units) %> · <%= __("عقود") %> <%= __(o.contracts) %> · <%= __("سُجّل") %> <span dir="ltr"><%= __(stamp(o.created_at)) %></span></div>
    </li>
  <% }) %>
</ul>
<% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد مكاتب مطابقة.") %></p><% } %>
<% if (pages > 1) { %>
  <nav class="pager" aria-label="<%= __("الصفحات") %>">
    <% if (page > 1) { %><a href="/admin/offices?q=<%= __(encodeURIComponent(q)) %>&amp;status=<%= __(status) %>&amp;page=<%= __(page - 1) %>"><%= __("السابق") %></a><% } %>
    <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
    <% if (page < pages) { %><a href="/admin/offices?q=<%= __(encodeURIComponent(q)) %>&amp;status=<%= __(status) %>&amp;page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
  </nav>
<% } %>

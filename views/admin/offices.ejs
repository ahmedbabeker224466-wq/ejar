<div class="page-head"><h1><%= __("المكاتب") %></h1></div>
<% const statusLabel = { trial: __('تجربة'), active: __('فعّال'), past_due: __('غير مسدَّد'), suspended: __('موقوف') }; %>
<form method="get" action="/admin/offices" class="adm-filters" novalidate>
  <div class="field"><label for="q"><%= __("بحث بالاسم أو الجوال") %></label><input id="q" name="q" class="input" value="<%= __(q) %>" maxlength="60"></div>
  <div class="field"><label for="status"><%= __("الحالة") %></label>
    <select id="status" name="status" class="select">
      <option value=""><%= __("الكل") %></option>
      <option value="review" <%= status === 'review' ? 'selected' : '' %>><%= __("بانتظار المراجعة") %></option>
      <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>><%= __("مرفوض") %></option>
      <% statuses.forEach(function (s) { %><option value="<%= __(s) %>" <%= __(status === s ? 'selected' : '') %>><%= __(statusLabel[s]) %></option><% }) %>
    </select></div>
  <button type="submit" class="btn btn--primary"><%= __("بحث") %></button>
</form>
<p class="adm-count"><%= countOf(total, 'مكتب', lang) %></p>
<% if (rows.length) { %>
<div class="table-wrap">
  <table class="table adm-table">
    <thead><tr><th><%= __("المكتب") %></th><th><%= __("الحالة") %></th><th><%= __("الباقة") %></th><th><%= __("وحدات") %></th><th><%= __("عقود") %></th><th><%= __("تاريخ التسجيل") %></th></tr></thead>
    <tbody>
      <% rows.forEach(function (o) { %>
        <tr>
          <td><a class="adm-strong" href="/admin/offices/<%= __(o.id) %>"><%= __(o.name) %></a><span class="adm-sub"><%= __(o.city) %></span></td>
          <td><% if (o.verification === 'pending') { %><span class="badge badge--bill-warning"><%= __("بانتظار المراجعة") %></span><% } else if (o.verification === 'rejected') { %><span class="badge badge--bill-danger"><%= __("مرفوض") %></span><% } else { %><span class="badge badge--bill-<%= __(o.status === 'active' ? 'success' : o.status === 'trial' ? 'info' : 'danger') %>"><%= __(statusLabel[o.status]) %></span><% } %></td>
          <td><%= __(o.plan_name || '—') %></td>
          <td><%= __(o.units) %></td>
          <td><%= __(o.contracts) %></td>
          <td dir="ltr"><%= __(stamp(o.created_at)) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else { %><p class="empty-state"><%= __("لا توجد مكاتب مطابقة.") %></p><% } %>
<% if (pages > 1) { %>
  <nav class="pager" aria-label="<%= __("الصفحات") %>">
    <% if (page > 1) { %><a href="/admin/offices?q=<%= __(encodeURIComponent(q)) %>&amp;status=<%= __(status) %>&amp;page=<%= __(page - 1) %>"><%= __("السابق") %></a><% } %>
    <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
    <% if (page < pages) { %><a href="/admin/offices?q=<%= __(encodeURIComponent(q)) %>&amp;status=<%= __(status) %>&amp;page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %>
  </nav>
<% } %>

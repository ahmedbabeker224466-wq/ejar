<p class="back-link"><a href="/admin/domains"><%= dir === 'rtl' ? '→' : '←' %> <%= __("طلبات الدومين") %></a></p>
<div class="page-head"><h1 dir="ltr"><%= __(request.domain) %></h1></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<div class="flash flash--warning" role="note"><%= __("بعد التفعيل يعرض التطبيق صفحة المكتب العامة على هذا الدومين بمجرد وصول طلباته إلى الخادم. ربط الدومين بالخادم (إضافته في cPanel، وسجلات DNS، وشهادة SSL) يتم يدوياً. راجع docs/DOMAINS.md.") %></div>

<% if (request.status === 'active') { %>
<section class="card detail-card" id="live">
  <h2><%= __("الدومين الفعّال") %></h2>
  <p><a href="https://<%= __(request.domain) %>/" dir="ltr" target="_blank" rel="noopener noreferrer">https://<%= __(request.domain) %>/</a></p>
  <% if (probe) { %>
    <dl class="details">
      <dt><%= __("سجل") %> A</dt><dd dir="ltr"><%= __(probe.a.ok ? probe.a.values.join(', ') || '—' : (lookupErrors[probe.a.error] || probe.a.error)) %></dd>
      <dt><%= __("سجل") %> CNAME</dt><dd dir="ltr"><%= __(probe.cname.ok ? probe.cname.values.join(', ') || '—' : (lookupErrors[probe.cname.error] || probe.cname.error)) %></dd>
      <dt>HTTPS</dt><dd dir="ltr"><%= __(probe.https.status ? 'HTTP ' + probe.https.status : (probe.https.error + (probe.https.message ? ': ' + probe.https.message : ''))) %></dd>
      <dt><%= __("يصل إلى ميعاد؟") %></dt><dd><% if (probe.isApp) { %><span class="badge badge--domain-active"><%= __("نعم، صفحة هذا المكتب") %> ✓</span><% } else { %><span class="badge badge--domain-rejected"><%= __("لا") %></span><% } %></dd>
    </dl>
    <% if (!probe.isApp) { %><p class="muted"><%= __("إذا كان الخطأ شهادة SSL فانتظر AutoSSL أو شغّله من cPanel. إذا لم يصل الطلب فراجع إضافة الدومين في cPanel وسجلات DNS.") %></p><% } %>
  <% } %>
  <form method="post" action="/admin/domains/<%= __(request.id) %>/probe"><button type="submit" class="btn btn--secondary"><%= __("فحص الدومين") %></button></form>
</section>
<% } %>

<section class="card detail-card">
  <h2><%= __("الطلب") %></h2>
  <dl class="details">
    <dt><%= __("المكتب") %></dt><dd><a href="/admin/offices/<%= __(request.office_id) %>"><%= __(request.office_name) %></a></dd>
    <dt><%= __("الحالة") %></dt><dd><span class="badge badge--domain-<%= __(request.status) %>"><%= __(request.statusLabel) %></span></dd>
    <dt><%= __("النوع") %></dt><dd><%= __(request.type === 'own' ? __('لدي دومين') : __('احجز لي دوميناً')) %></dd>
    <% if (request.type === 'own') { %><dt><%= __("طريقة الربط") %></dt><dd><%= __(request.connection_method === 'records' ? __('سجلات DNS (CNAME و A)') : 'Nameservers') %></dd><% } %>
    <% if (request.alt_domains.length) { %><dt><%= __("البدائل") %></dt><dd dir="ltr"><%= __(request.alt_domains.join(', ')) %></dd><% } %>
    <dt><%= __("الباقة الآن") %></dt><dd><%= __(request.plan_name || '—') %> (<%= __({ none: __('غير متاح'), addon: __('إضافة مدفوعة'), included: __('مشمول') }[request.current_plan_mode] || '—') %>)</dd>
    <dt><%= __("عند الطلب") %></dt><dd><%= __({ none: __('غير متاح'), addon: __('إضافة مدفوعة'), included: __('مشمول') }[request.plan_mode] || '—') %><% if (request.addon_monthly_halalas) { %> · <%= __("سعر الإضافة المعروض:") %> <%= __(fmt(request.addon_monthly_halalas)) %> <%= __("ريال شهرياً (لم يُخصم شيء)") %><% } %></dd>
    <dt><%= __("رسم الخدمة") %></dt><dd><%= __(fmt(request.service_fee_halalas)) %> <%= __("ريال") %></dd>
    <dt><%= __("نطاق المكتب الفعّال") %></dt><dd dir="ltr"><%= __(request.office_domain || '—') %></dd>
    <dt><%= __("تاريخ الطلب") %></dt><dd dir="ltr"><%= __(stamp(request.created_at)) %></dd>
    <dt><%= __("آخر تحديث") %></dt><dd dir="ltr"><%= __(stamp(request.updated_at)) %></dd>
    <% if (request.activated_at) { %><dt><%= __("تاريخ التفعيل") %></dt><dd dir="ltr"><%= __(stamp(request.activated_at)) %></dd><% } %>
  </dl>
</section>

<section class="card detail-card" id="propagation">
  <h2><%= __("فحص الانتشار (NS)") %></h2>
  <p class="muted"><%= __("استعلام DNS عادي عن سجلات NS للدومين. لا يغيّر شيئاً.") %></p>
  <% if (check) { %>
    <% if (check.ok) { %>
      <p><%= __("سجلات NS الحالية:") %></p>
      <ul dir="ltr" class="ns-list"><% check.ns.forEach(function (n) { %><li><%= __(n) %></li><% }) %></ul>
      <% if (check.matches === true) { %><p><span class="badge badge--domain-active"><%= __("مطابقة للقيم المسندة") %> ✓</span></p>
      <% } else if (check.matches === false) { %><p><span class="badge badge--domain-rejected"><%= __("غير مطابقة بعد") %></span> <%= __("المتوقع:") %> <span dir="ltr"><%= __(check.expected.join(', ')) %></span></p>
      <% } else { %><p class="muted"><%= __("لم تُسند قيم Nameservers بعد للمقارنة.") %></p><% } %>
    <% } else { %>
      <p class="field-error" role="alert"><%= __(lookupErrors[check.error] || __('تعذّر الاستعلام.')) %> <span dir="ltr">(<%= __(check.error) %>)</span></p>
    <% } %>
  <% } %>
  <form method="post" action="/admin/domains/<%= __(request.id) %>/check"><button type="submit" class="btn btn--secondary"><%= __("فحص الانتشار") %></button></form>
</section>

<section class="card form-card">
  <h2><%= __("تحديث الطلب (يحتاج سبباً ويُسجَّل)") %></h2>
  <form method="post" action="/admin/domains/<%= __(request.id) %>" novalidate>
    <div class="field">
      <label for="status"><%= __("الحالة") %></label>
      <select id="status" name="status" class="select" <%= __(next.length ? '' : 'disabled') %>>
        <option value="<%= __(request.status) %>"><%= __(labels[request.status]) %> (<%= __("الحالية)") %></option>
        <% next.forEach(function (s) { %><option value="<%= __(s) %>" <%= __(values.status === s ? 'selected' : '') %>><%= __(s === 'active' ? __('تفعيل: ') : '') %><%= __(labels[s]) %></option><% }) %>
      </select>
      <% if (errors.status) { %><p class="field-error" role="alert"><%= __(errors.status) %></p><% } %>
      <% if (!next.length) { %><p class="field-hint"><%= __("حالة نهائية.") %></p><% } %>
    </div>
    <div class="form-grid">
      <div class="field"><label for="ns1">Nameserver 1</label><input id="ns1" name="assigned_ns_1" class="input" dir="ltr" maxlength="253" value="<%= __(values.assigned_ns_1) %>" <%= __(errors.assigned_ns_1 ? 'aria-invalid=true' : '') %>>
        <% if (errors.assigned_ns_1) { %><p class="field-error"><%= __(errors.assigned_ns_1) %></p><% } %></div>
      <div class="field"><label for="ns2">Nameserver 2</label><input id="ns2" name="assigned_ns_2" class="input" dir="ltr" maxlength="253" value="<%= __(values.assigned_ns_2) %>" <%= __(errors.assigned_ns_2 ? 'aria-invalid=true' : '') %>>
        <% if (errors.assigned_ns_2) { %><p class="field-error"><%= __(errors.assigned_ns_2) %></p><% } %></div>
    </div>
    <div class="field"><label for="zone"><%= __("مرجع المنطقة") %> (dns_zone_ref)</label><input id="zone" name="dns_zone_ref" class="input" dir="ltr" maxlength="255" value="<%= __(values.dns_zone_ref) %>">
      <% if (errors.dns_zone_ref) { %><p class="field-error"><%= __(errors.dns_zone_ref) %></p><% } %></div>
    <div class="field"><label for="cost"><%= __("تكلفة الدومين بالريال (للحجز)") %></label><input id="cost" name="price_cost" class="input" inputmode="decimal" dir="ltr" maxlength="12" value="<%= __(values.price_cost) %>">
      <% if (errors.price_cost) { %><p class="field-error"><%= __(errors.price_cost) %></p><% } %></div>
    <div class="field"><label for="note"><%= __("ملاحظة خاصة (لا يراها المكتب)") %></label><textarea id="note" name="admin_note" class="input" rows="3" maxlength="500"><%= __(values.admin_note) %></textarea>
      <% if (errors.admin_note) { %><p class="field-error"><%= __(errors.admin_note) %></p><% } %></div>
    <div class="field"><label for="reason"><%= __("السبب") %></label><input id="reason" name="reason" class="input" maxlength="200" required></div>
    <button type="submit" class="btn btn--primary btn--block"><%= __("حفظ") %></button>
  </form>
</section>

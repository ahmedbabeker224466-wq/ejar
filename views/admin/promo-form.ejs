<p class="back-link"><a href="/admin/promos"><%= dir === 'rtl' ? '→' : '←' %> <%= __("أكواد الخصم") %></a></p>
<div class="page-head"><h1><%= __(row ? __('كود الخصم ') + row.code : __('كود خصم جديد')) %></h1></div>
<form method="post" action="<%= __(row ? '/admin/promos/' + row.id : '/admin/promos') %>" class="form-card" novalidate>
  <% if (!row) { %>
    <div class="field"><label for="code"><%= __("الرمز") %></label><input id="code" name="code" class="input" dir="ltr" maxlength="30" value="<%= __(values.code) %>" required>
      <% if (errors.code) { %><p class="field-error"><%= __(errors.code) %></p><% } %></div>
  <% } %>
  <div class="field"><label for="discount_type"><%= __("نوع الخصم") %></label>
    <select id="discount_type" name="discount_type" class="select">
      <option value="percent" <%= __(values.discount_type === 'percent' ? 'selected' : '') %>><%= __("نسبة مئوية") %></option>
      <option value="fixed" <%= __(values.discount_type === 'fixed' ? 'selected' : '') %>><%= __("مبلغ ثابت") %></option></select></div>
  <div class="form-grid">
    <div class="field"><label for="percent"><%= __("النسبة % (إن كان نسبة)") %></label><input id="percent" name="percent" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.percent) %>">
      <% if (errors.percent) { %><p class="field-error"><%= __(errors.percent) %></p><% } %></div>
    <div class="field"><label for="fixed"><%= __("المبلغ بالريال (إن كان ثابتاً)") %></label><input id="fixed" name="fixed" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.fixed) %>">
      <% if (errors.fixed) { %><p class="field-error"><%= __(errors.fixed) %></p><% } %></div>
    <div class="field"><label for="valid_from"><%= __("يبدأ في (اختياري)") %></label><input id="valid_from" name="valid_from" class="input" type="date" dir="ltr" value="<%= __(values.valid_from) %>">
      <% if (errors.valid_from) { %><p class="field-error"><%= __(errors.valid_from) %></p><% } %></div>
    <div class="field"><label for="valid_to"><%= __("ينتهي في (اختياري، يشمل اليوم)") %></label><input id="valid_to" name="valid_to" class="input" type="date" dir="ltr" value="<%= __(values.valid_to) %>">
      <% if (errors.valid_to) { %><p class="field-error"><%= __(errors.valid_to) %></p><% } %></div>
    <div class="field"><label for="max_redemptions"><%= __("أقصى عدد استخدامات (اختياري)") %></label><input id="max_redemptions" name="max_redemptions" class="input" inputmode="numeric" dir="ltr" value="<%= __(values.max_redemptions) %>">
      <% if (errors.max_redemptions) { %><p class="field-error"><%= __(errors.max_redemptions) %></p><% } %></div>
  </div>
  <fieldset class="checks"><legend><%= __("الباقات المشمولة (بدون اختيار") %> = <%= __("كل الباقات)") %></legend>
    <div class="checks__grid">
      <% allPlans.forEach(function (p) { %><label class="check"><input type="checkbox" name="plan_ids" value="<%= __(p.id) %>" <%= __(values.plan_ids.map(Number).includes(Number(p.id)) ? 'checked' : '') %>> <%= __(p.name_ar) %></label><% }) %>
    </div></fieldset>
  <label class="check"><input type="checkbox" name="is_active" value="1" <%= __(values.is_active ? 'checked' : '') %>> <%= __("مفعّل") %></label>
  <div class="field"><label for="note"><%= __("ملاحظة داخلية") %></label><input id="note" name="note" class="input" maxlength="200" value="<%= __(values.note) %>"></div>
  <p class="muted"><%= __("كل مكتب يستخدم الكود مرة واحدة فقط.") %></p>
  <div class="field"><label for="reason"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %></div>
  <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("حفظ") %></button>
</form>

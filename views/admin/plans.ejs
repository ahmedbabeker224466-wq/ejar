<div class="page-head"><h1><%= __("الباقات") %></h1><a href="/admin/plans/new" class="btn btn--primary btn--small"><%= __("باقة جديدة") %></a></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>
<p class="muted"><%= __("أي تعديل يسري فوراً على كل المشتركين في الباقة. الأسعار قبل الضريبة.") %></p>
<ul class="item-list">
  <% rows.forEach(function (p) { %>
    <li class="item">
      <div class="item__title"><a href="/admin/plans/<%= __(p.id) %>"><strong><%= __(p.name_ar) %></strong></a> <span dir="ltr">(<%= __(p.code) %>)</span>
        <span class="badge badge--bill-<%= __(Number(p.is_active) ? 'success' : 'danger') %>"><%= __(Number(p.is_active) ? __('مفعّلة') : __('موقوفة')) %></span>
        <% if (!Number(p.is_public)) { %><span class="badge badge--ended"><%= __("غير معروضة") %></span><% } %></div>
      <div class="item__meta"><%= __(fmtDec(p.price_monthly)) %> / <%= __("شهر") %> · <%= __(fmtDec(p.price_yearly)) %> / <%= __("سنة") %> ·
        <%= __("وحدات") %> <%= __(p.max_units === null ? '∞' : p.max_units) %> · <%= __("عقود") %> <%= __(p.max_contracts === null ? '∞' : p.max_contracts) %> · <%= __("فريق") %> <%= __(p.max_members === null ? '∞' : p.max_members) %></div>
      <details class="danger-zone"><summary><%= __("حذف الباقة") %></summary>
        <form method="post" action="/admin/plans/<%= __(p.id) %>/delete" novalidate>
          <div class="field"><label for="reason-<%= __(p.id) %>"><%= __("السبب") %></label><input id="reason-<%= __(p.id) %>" name="reason" class="input" maxlength="200" required></div>
          <button type="submit" class="btn btn--danger btn--small"><%= __("حذف") %></button>
        </form></details>
    </li>
  <% }) %>
</ul>

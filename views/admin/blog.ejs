<div class="page-head"><h1><%= __("المدونة") %></h1><a href="/admin/blog/new" class="btn btn--primary btn--small"><%= __("مقال جديد") %></a></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<ul class="item-list">
  <% rows.forEach(function (p) { %>
    <li class="item">
      <div class="item__title"><a href="/admin/blog/<%= __(p.id) %>"><strong><%= __(p.title) %></strong></a>
        <span class="badge badge--bill-<%= __(p.status === 'published' ? 'success' : 'info') %>"><%= __(p.status === 'published' ? __('منشور') : __('مسودة')) %></span>
        <% if (p.needsReview) { %><span class="badge badge--bill-warning"><%= __("يحتاج مراجعة قبل النشر") %></span><% } %></div>
      <div class="item__meta"><span dir="ltr">/blog/<%= __(p.slug) %></span> · <span dir="ltr"><%= __(stamp(p.publishedAt || p.createdAt)) %></span></div>
    </li>
  <% }) %>
</ul>
<% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد مقالات.") %></p><% } %>

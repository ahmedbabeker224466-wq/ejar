<p class="back-link"><a href="/admin/blog"><%= dir === 'rtl' ? '→' : '←' %> <%= __("المدونة") %></a></p>
<div class="page-head"><h1><%= __(post ? post.title : __('مقال جديد')) %></h1></div>
<form method="post" action="<%= __(post ? '/admin/blog/' + post.id : '/admin/blog') %>" enctype="multipart/form-data" class="form-card" novalidate>
  <% if (!post) { %>
    <div class="field"><label for="slug"><%= __("الرابط (إنجليزي)") %></label><input id="slug" name="slug" class="input" dir="ltr" maxlength="100" value="<%= __(values.slug) %>" required>
      <% if (errors.slug) { %><p class="field-error"><%= __(errors.slug) %></p><% } %></div>
  <% } %>
  <div class="field"><label for="title_ar"><%= __("عنوان المقال") %></label><input id="title_ar" name="title_ar" class="input" maxlength="200" value="<%= __(values.title_ar) %>" required>
    <% if (errors.title_ar) { %><p class="field-error"><%= __(errors.title_ar) %></p><% } %></div>
  <div class="field"><label for="excerpt_ar"><%= __("ملخص قصير") %></label><textarea id="excerpt_ar" name="excerpt_ar" class="textarea" rows="2" maxlength="500"><%= __(values.excerpt_ar) %></textarea>
    <% if (errors.excerpt_ar) { %><p class="field-error"><%= __(errors.excerpt_ar) %></p><% } %></div>
  <div class="field"><label for="body_ar"><%= __("النص (Markdown بسيط)") %></label>
    <textarea id="body_ar" name="body_ar" class="textarea" rows="16"><%= __(values.body_ar) %></textarea>
    <p class="field-hint"><%= __("المسموح:") %> ## <%= __("عنوان،") %> ### <%= __("عنوان فرعي،") %> **<%= __("غامق") %>**، *<%= __("مائل") %>*<%= __("، قوائم بـ - أو 1.،") %> > <%= __("اقتباس، --- فاصل،") %> [<%= __("نص") %>](https://…). <%= __("أي HTML يُعرض كنص عادي.") %></p>
    <% if (errors.body_ar) { %><p class="field-error"><%= __(errors.body_ar) %></p><% } %></div>
  <div class="form-grid">
    <div class="field"><label for="meta_title"><%= __("عنوان محركات البحث") %></label><input id="meta_title" name="meta_title" class="input" maxlength="160" value="<%= __(values.meta_title) %>">
      <% if (errors.meta_title) { %><p class="field-error"><%= __(errors.meta_title) %></p><% } %></div>
    <div class="field"><label for="meta_description"><%= __("وصف محركات البحث") %></label><input id="meta_description" name="meta_description" class="input" maxlength="300" value="<%= __(values.meta_description) %>">
      <% if (errors.meta_description) { %><p class="field-error"><%= __(errors.meta_description) %></p><% } %></div>
  </div>
  <div class="field"><label for="cover"><%= __("صورة الغلاف (اختياري)") %></label><input id="cover" name="cover" class="input input--file" type="file" accept="image/jpeg,image/png,image/webp">
    <% if (post && post.hasCover) { %><label class="check"><input type="checkbox" name="remove_cover" value="1"> <%= __("حذف الغلاف الحالي") %></label><% } %>
    <% if (errors.cover) { %><p class="field-error"><%= __(errors.cover) %></p><% } %></div>
  <div class="field"><label for="status"><%= __("الحالة") %></label>
    <select id="status" name="status" class="select">
      <option value="draft" <%= __(values.status === 'draft' ? 'selected' : '') %>><%= __("مسودة") %></option>
      <option value="published" <%= __(values.status === 'published' ? 'selected' : '') %>><%= __("منشور") %></option>
    </select></div>
  <label class="check"><input type="checkbox" name="needs_review" value="1" <%= __(values.needs_review ? 'checked' : '') %>> <%= __("يحتاج مراجعة قبل النشر") %></label>
  <div class="field"><label for="reason"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %></div>
  <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("حفظ") %></button>
</form>
<% if (post) { %>
  <section class="card detail-card">
    <details class="danger-zone"><summary><%= __("حذف المقال") %></summary>
      <form method="post" action="/admin/blog/<%= __(post.id) %>/delete" novalidate>
        <div class="field"><label for="reason-del"><%= __("السبب") %></label><input id="reason-del" name="reason" class="input" maxlength="200" required></div>
        <button type="submit" class="btn btn--danger"><%= __("حذف") %></button>
      </form></details>
  </section>
<% } %>

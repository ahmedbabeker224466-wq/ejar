<p class="back-link"><a href="/admin/plans"><%= dir === 'rtl' ? '→' : '←' %> <%= __("الباقات") %></a></p>
<div class="page-head"><h1><%= __(plan ? __('الباقة ') + plan.name_ar : __('باقة جديدة')) %></h1></div>
<form method="post" action="<%= __(plan ? '/admin/plans/' + plan.id : '/admin/plans') %>" class="form-card" novalidate>
  <% if (!plan) { %>
    <div class="field"><label for="code"><%= __("الرمز (إنجليزي صغير)") %></label><input id="code" name="code" class="input" dir="ltr" maxlength="30" value="<%= __(values.code) %>" required>
      <% if (errors.code) { %><p class="field-error"><%= __(errors.code) %></p><% } %></div>
  <% } %>
  <div class="field"><label for="name_ar"><%= __("اسم الباقة") %></label><input id="name_ar" name="name_ar" class="input" maxlength="80" value="<%= __(values.name_ar) %>" required>
    <% if (errors.name_ar) { %><p class="field-error"><%= __(errors.name_ar) %></p><% } %></div>
  <div class="form-grid">
    <div class="field"><label for="price_monthly"><%= __("السعر الشهري (ريال، قبل الضريبة)") %></label><input id="price_monthly" name="price_monthly" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.price_monthly) %>">
      <% if (errors.price_monthly) { %><p class="field-error"><%= __(errors.price_monthly) %></p><% } %></div>
    <div class="field"><label for="price_yearly"><%= __("السعر السنوي (ريال، قبل الضريبة)") %></label><input id="price_yearly" name="price_yearly" class="input" inputmode="decimal" dir="ltr" value="<%= __(values.price_yearly) %>">
      <% if (errors.price_yearly) { %><p class="field-error"><%= __(errors.price_yearly) %></p><% } %></div>
    <% limits.forEach(function (l) { %>
      <div class="field"><label for="<%= __(l.key) %>"><%= __(l.label) %> (<%= __("فارغ") %> = <%= __("بلا حد)") %></label><input id="<%= __(l.key) %>" name="<%= __(l.key) %>" class="input" inputmode="numeric" dir="ltr" value="<%= __(values[l.key]) %>">
        <% if (errors[l.key]) { %><p class="field-error"><%= __(errors[l.key]) %></p><% } %></div>
    <% }) %>
    <div class="field"><label for="sort_order"><%= __("الترتيب") %></label><input id="sort_order" name="sort_order" class="input" inputmode="numeric" dir="ltr" value="<%= __(values.sort_order) %>">
      <% if (errors.sort_order) { %><p class="field-error"><%= __(errors.sort_order) %></p><% } %></div>
  </div>
  <fieldset class="checks"><legend><%= __("المزايا") %></legend>
    <div class="checks__grid">
      <% Object.keys(flags).forEach(function (f) { %><label class="check"><input type="checkbox" name="feature_<%= __(f) %>" value="1" <%= __(values.features[f] ? 'checked' : '') %>> <%= __(flags[f]) %></label><% }) %>
    </div></fieldset>
  <label class="check"><input type="checkbox" name="is_public" value="1" <%= __(values.is_public ? 'checked' : '') %>> <%= __("تُعرض للمكاتب في صفحة الاشتراك") %></label>
  <label class="check"><input type="checkbox" name="is_active" value="1" <%= __(values.is_active ? 'checked' : '') %>> <%= __("مفعّلة") %></label>
  <div class="field"><label for="reason"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %></div>
  <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("حفظ") %></button>
</form>

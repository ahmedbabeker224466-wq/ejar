<div class="page-head"><h1><%= __("إعدادات المنصة") %></h1></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>

<nav class="adm-subnav" aria-label="<%= __("أقسام الإعدادات") %>">
  <a href="#seller"><%= __("بيانات الفواتير") %></a>
  <a href="#bank"><%= __("الحساب البنكي") %></a>
  <a href="#support"><%= __("التواصل مع الدعم") %></a>
  <a href="#switches"><%= __("مفاتيح الإيقاف") %></a>
  <a href="#ai"><%= __("الذكاء الاصطناعي") %></a>
  <a href="#analytics"><%= __("التحليلات") %></a>
</nav>
<form method="post" action="/admin/settings/details" class="form-card adm-settings" novalidate>
  <h2 id="seller"><%= __("بيانات البائع (تظهر في الفواتير)") %></h2>
  <p class="muted"><%= __("لم تُحدَّد الجهة المُصدِرة للفواتير بعد، لذلك كل الحقول اختيارية. تظهر الفاتورة باسم «فاتورة ضريبية مبسطة» فقط عند إدخال الرقم الضريبي، وإلا فهي «إيصال دفع». هذا النظام لا يدّعي الربط مع الفوترة الإلكترونية (زاتكا).") %></p>
  <div class="field"><label for="legal_name"><%= __("الاسم القانوني") %></label><input id="legal_name" name="legal_name" class="input" maxlength="150" value="<%= __(values.legal_name) %>"></div>
  <div class="form-grid">
    <div class="field"><label for="vat_number"><%= __("الرقم الضريبي (15 رقماً)") %></label><input id="vat_number" name="vat_number" class="input" dir="ltr" inputmode="numeric" maxlength="15" value="<%= __(values.vat_number) %>">
      <% if (errors.vat_number) { %><p class="field-error"><%= __(errors.vat_number) %></p><% } %></div>
    <div class="field"><label for="cr_number"><%= __("السجل التجاري (10 أرقام)") %></label><input id="cr_number" name="cr_number" class="input" dir="ltr" inputmode="numeric" maxlength="10" value="<%= __(values.cr_number) %>">
      <% if (errors.cr_number) { %><p class="field-error"><%= __(errors.cr_number) %></p><% } %></div>
  </div>
  <div class="field"><label for="address"><%= __("العنوان") %></label><input id="address" name="address" class="input" maxlength="250" value="<%= __(values.address) %>"></div>

  <h2 id="bank" class="adm-settings__sep"><%= __("الحساب البنكي للحوالات") %></h2>
  <div class="form-grid">
    <div class="field"><label for="bank_name"><%= __("اسم البنك") %></label><input id="bank_name" name="bank_name" class="input" maxlength="80" value="<%= __(values.bank_name) %>"></div>
    <div class="field"><label for="bank_account_name"><%= __("اسم صاحب الحساب") %></label><input id="bank_account_name" name="bank_account_name" class="input" maxlength="120" value="<%= __(values.bank_account_name) %>"></div>
    <div class="field"><label for="bank_iban"><%= __("الآيبان") %></label><input id="bank_iban" name="bank_iban" class="input" dir="ltr" maxlength="34" value="<%= __(values.bank_iban) %>">
      <% if (errors.bank_iban) { %><p class="field-error"><%= __(errors.bank_iban) %></p><% } %></div>
  </div>

  <h2 id="support" class="adm-settings__sep"><%= __("التواصل مع الدعم") %></h2>
  <div class="form-grid">
    <div class="field"><label for="support_phone"><%= __("جوال الدعم") %></label><input id="support_phone" name="support_phone" class="input" dir="ltr" maxlength="20" value="<%= __(values.support_phone) %>">
      <% if (errors.support_phone) { %><p class="field-error"><%= __(errors.support_phone) %></p><% } %></div>
    <div class="field"><label for="support_email"><%= __("بريد الدعم") %></label><input id="support_email" name="support_email" class="input" dir="ltr" maxlength="190" value="<%= __(values.support_email) %>">
      <% if (errors.support_email) { %><p class="field-error"><%= __(errors.support_email) %></p><% } %></div>
  </div>
  <div class="field adm-settings__sep"><label for="reason-details"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason-details" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %></div>
  <button type="submit" class="btn btn--success btn--large"><%= __("حفظ البيانات") %></button>
</form>

<form method="post" action="/admin/settings/switches" class="form-card adm-settings" id="switches" novalidate>
  <h2><%= __("مفاتيح الإيقاف") %></h2>
  <label class="check"><input type="checkbox" name="signups_disabled" value="1" <%= __(switches.signupsDisabled ? 'checked' : '') %>> <%= __("إيقاف التسجيل الجديد (من لديه حساب يدخل عادياً)") %></label>
  <label class="check"><input type="checkbox" name="ai_disabled" value="1" <%= __(switches.aiDisabled ? 'checked' : '') %>> <%= __("إيقاف قراءة العقود بالذكاء الاصطناعي (الإدخال اليدوي يعمل)") %></label>
  <div class="field"><label for="banner"><%= __("رسالة تظهر أعلى كل الصفحات (اتركها فارغة لإخفائها)") %></label><input id="banner" name="banner" class="input" maxlength="200" value="<%= __(switches.banner) %>"></div>
  <div class="field"><label for="reason-switches"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason-switches" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason_switches) { %><p class="field-error"><%= __(errors.reason_switches) %></p><% } %></div>
  <button type="submit" class="btn btn--success btn--large"><%= __("حفظ المفاتيح") %></button>
</form>

<form method="post" action="/admin/settings/ai" class="form-card adm-settings" id="ai" novalidate autocomplete="off">
  <h2><%= __("قراءة العقود بالذكاء الاصطناعي") %></h2>
  <p class="muted"><%= __("اختر الخدمة التي تقرأ ملف العقد المرفوع، والصق مفتاحها. يُحفظ المفتاح مشفراً ولا يظهر هنا مرة أخرى.") %></p>
  <p class="adm-status"><% if (ai.keySet) { %><span class="badge badge--bill-success"><%= __("مضبوط ✓") %></span> <%= __(aiProviders[ai.provider] ? aiProviders[ai.provider].label : '') %><% } else if (ai.envKey) { %><span class="badge badge--bill-info"><%= __("يعمل بمفتاح Claude من متغيرات البيئة") %></span><% } else { %><span class="badge badge--bill-warning"><%= __("غير مفعّل") %></span><% } %></p>
  <div class="form-grid">
    <div class="field"><label for="ai_provider"><%= __("الخدمة") %></label>
      <select id="ai_provider" name="ai_provider" class="select">
        <% Object.entries(aiProviders).forEach(function ([code, p]) { %><option value="<%= code %>" <%= aiValues.ai_provider === code ? 'selected' : '' %>><%= p.label %></option><% }) %>
      </select>
      <% if (errors.ai_provider) { %><p class="field-error"><%= __(errors.ai_provider) %></p><% } %></div>
    <div class="field"><label for="ai_model"><%= __("النموذج (اختياري)") %></label>
      <input id="ai_model" name="ai_model" class="input" dir="ltr" maxlength="80" value="<%= aiValues.ai_model || '' %>" placeholder="<%= aiProviders[aiValues.ai_provider || 'gemini'] ? aiProviders[aiValues.ai_provider || 'gemini'].defaultModel : '' %>">
      <% if (errors.ai_model) { %><p class="field-error"><%= __(errors.ai_model) %></p><% } else { %><p class="field-hint"><%= __("اتركه فارغاً لاستخدام النموذج الافتراضي.") %></p><% } %></div>
  </div>
  <div class="field"><label for="ai_key"><%= __("مفتاح الخدمة") %></label>
    <input id="ai_key" name="ai_key" class="input" type="password" dir="ltr" maxlength="300" autocomplete="new-password" placeholder="<%= ai.keySet ? __('اتركه فارغاً للإبقاء على المفتاح الحالي') : '' %>">
    <% if (errors.ai_key) { %><p class="field-error"><%= __(errors.ai_key) %></p><% } %></div>
  <% if (ai.keySet) { %><label class="adm-check"><input type="checkbox" name="ai_clear_key" value="1"> <%= __("احذف المفتاح المحفوظ") %></label><% } %>
  <div class="flash flash--warning adm-note"><%= __("تنبيه عن الخصوصية: ملف العقد يُرسَل كاملاً إلى الخدمة المختارة ليقرأ منه التواريخ والمبالغ، وفيه أسماء الأطراف وأرقام هوياتهم. شروط Google للخطة المجانية من Gemini تسمح لها باستخدام ما يُرسَل لتحسين خدماتها، بخلاف الخطة المدفوعة. استخدم الخطة المجانية للتجربة فقط، وفعّل الفوترة في حساب Google قبل استقبال عقود المكاتب الحقيقية.") %></div>
  <div class="field"><label for="reason-ai"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason-ai" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason_ai) { %><p class="field-error"><%= __(errors.reason_ai) %></p><% } %></div>
  <button type="submit" class="btn btn--success btn--large"><%= __("حفظ") %></button>
</form>

<form method="post" action="/admin/settings/analytics" class="form-card adm-settings" id="analytics" novalidate>
  <h2><%= __("شيفرة التحليلات (اختيارية)") %></h2>
  <p class="muted"><%= __("فارغة افتراضياً ولا تُحمَّل أي شيفرة تتبع. الصق وسم") %> <code dir="ltr">&lt;script src="https://..."&gt;&lt;/script&gt;</code> <%= __("واحداً فقط من مزوّد معروف") %> (<span dir="ltr">Google Tag Manager<%= __("، Google Analytics، Plausible، Fathom، Cloudflare، Umami،") %> Simple Analytics</span>). <%= __("تظهر في الصفحات العامة فقط، لا في صفحات المكاتب أو الإدارة.") %></p>
  <div class="field"><label for="snippet"><%= __("الوسم") %></label><textarea id="snippet" name="snippet" class="textarea" rows="3" dir="ltr" maxlength="1000"><%= __(analytics) %></textarea>
    <% if (errors.snippet) { %><p class="field-error"><%= __(errors.snippet) %></p><% } %></div>
  <div class="field"><label for="reason-analytics"><%= __("سبب الإجراء (يُسجَّل في سجل التدقيق)") %></label><input id="reason-analytics" name="reason" class="input" maxlength="200" required>
    <% if (errors.reason_analytics) { %><p class="field-error"><%= __(errors.reason_analytics) %></p><% } %></div>
  <button type="submit" class="btn btn--success btn--large"><%= __("حفظ") %></button>
</form>

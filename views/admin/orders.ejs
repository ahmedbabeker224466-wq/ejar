<div class="page-head"><h1><%= __("الطلبات والمدفوعات") %></h1></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<form method="get" action="/admin/orders" class="adm-filters" novalidate>
  <div class="field"><label for="status"><%= __("الحالة") %></label>
    <select id="status" name="status" class="select"><option value=""><%= __("الكل") %></option>
      <% statuses.forEach(function (s) { %><option value="<%= __(s) %>" <%= __(filters.status === s ? 'selected' : '') %>><%= __({ pending: __('معلّق'), paid: __('مدفوع'), failed: __('فشل'), expired: __('منتهي') }[s]) %></option><% }) %></select></div>
  <div class="field"><label for="method"><%= __("الطريقة") %></label>
    <select id="method" name="method" class="select"><option value=""><%= __("الكل") %></option>
      <option value="moyasar" <%= __(filters.method === 'moyasar' ? 'selected' : '') %>><%= __("بطاقة") %></option>
      <option value="bank_transfer" <%= __(filters.method === 'bank_transfer' ? 'selected' : '') %>><%= __("حوالة") %></option></select></div>
  <label class="check"><input type="checkbox" name="suspicious" value="1" <%= __(filters.suspicious ? 'checked' : '') %>> <%= __("المشبوهة فقط") %></label>
  <button type="submit" class="btn btn--primary"><%= __("تصفية") %></button>
</form>

<section class="card detail-card">
  <h2><%= __("الطلبات") %> (<%= __(total) %>)</h2>
  <% const ost = { pending: __('معلّق'), paid: __('مدفوع'), failed: __('فشل'), expired: __('منتهي') }; const ocl = { pending: 'warning', paid: 'success', failed: 'danger', expired: 'info' }; %>
  <% if (rows.length) { %>
  <div class="table-wrap"><table class="table adm-table">
    <thead><tr><th><%= __("الطلب") %></th><th><%= __("المكتب") %></th><th><%= __("الباقة") %></th><th><%= __("الطريقة") %></th><th><%= __("المبلغ") %></th><th><%= __("الحالة") %></th><th><%= __("التاريخ") %></th></tr></thead>
    <tbody>
    <% rows.forEach(function (o) { %>
      <tr>
        <td dir="ltr">#<%= __(o.id) %></td>
        <td><a class="adm-strong" href="/admin/offices/<%= __(o.office_id) %>"><%= __(o.office_name) %></a></td>
        <td><%= __(o.plan_code) %><span class="adm-sub"><%= __(o.billing_interval === 'yearly' ? __('سنوي') : __('شهري')) %></span></td>
        <td><%= __(o.method === 'moyasar' ? __('بطاقة') : __('حوالة')) %></td>
        <td><%= __(fmtDec(o.total)) %> <%= __(o.currency) %><% if (o.promo_code) { %><span class="adm-sub"><%= __("خصم") %> <%= __(o.promo_code) %></span><% } %></td>
        <td><span class="badge badge--bill-<%= __(ocl[o.status] || 'info') %>"><%= __(ost[o.status]) %></span><% if (Number(o.suspicious)) { %> <span class="badge badge--bill-danger"><%= __("مشبوه:") %> <%= __(o.fail_reason) %></span><% } %></td>
        <td dir="ltr"><%= __(stamp(o.created_at)) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
  <% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد طلبات.") %></p><% } %>
  <% if (pages > 1) { %><nav class="pager"><% if (page > 1) { %><a href="/admin/orders?status=<%= __(filters.status) %>&amp;method=<%= __(filters.method) %>&amp;page=<%= __(page - 1) %>"><%= __("السابق") %></a><% } %> <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span> <% if (page < pages) { %><a href="/admin/orders?status=<%= __(filters.status) %>&amp;method=<%= __(filters.method) %>&amp;page=<%= __(page + 1) %>"><%= __("التالي") %></a><% } %></nav><% } %>
</section>

<section class="card detail-card">
  <h2><%= __("آخر المدفوعات") %></h2>
  <% if (payments.length) { %>
  <div class="table-wrap"><table class="table adm-table">
    <thead><tr><th><%= __("المكتب") %></th><th><%= __("المبلغ") %></th><th><%= __("المزوّد") %></th><th><%= __("المرجع") %></th><th><%= __("الحالة") %></th><th><%= __("التاريخ") %></th></tr></thead>
    <tbody>
    <% payments.forEach(function (p) { %>
      <tr>
        <td><a class="adm-strong" href="/admin/offices/<%= __(p.office_id) %>"><%= __(p.office_name) %></a></td>
        <td><%= __(fmtDec(p.amount)) %> <%= __(p.currency) %></td>
        <td><%= __(p.provider) %><%= __(p.card_last4 ? ' ****' + p.card_last4 : '') %></td>
        <td dir="ltr"><%= __(p.provider_ref) %></td>
        <td><span class="badge badge--role"><%= __({ paid: __("مدفوع"), refunded: __("مسترد"), failed: __("فشل"), pending: __("معلّق") }[p.status] || p.status) %></span></td>
        <td dir="ltr"><%= __(stamp(p.created_at)) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
  <% if (!payments.length) { %><p class="empty-state"><%= __("لا توجد مدفوعات.") %></p><% } %>
</section>

<section class="card detail-card">
  <h2><%= __("الفواتير والإشعارات الدائنة") %></h2>
  <ul class="item-list">
    <% invoices.forEach(function (i) { %>
      <li class="item">
        <div class="item__title"><a href="/admin/invoices/<%= __(i.id) %>"><strong dir="ltr"><%= __(i.invoice_no) %></strong></a> <%= __(i.doc_title) %>
          <% if (i.status === 'credited') { %><span class="badge badge--ended"><%= __("ملغاة بإشعار") %></span><% } %></div>
        <div class="item__meta"><a href="/admin/offices/<%= __(i.office_id) %>"><%= __(i.office_name) %></a> · <%= __(fmtDec(i.total)) %> <%= __(i.currency) %> · <span dir="ltr"><%= __(stamp(i.issued_at)) %></span></div>
        <% if (i.kind === 'invoice' && i.status === 'issued') { %>
          <details class="danger-zone"><summary><%= __("إصدار إشعار دائن (استرداد)") %></summary>
            <form method="post" action="/admin/invoices/<%= __(i.id) %>/credit-note" novalidate>
              <p class="muted"><%= __("يلغي الفاتورة بالكامل. لا يُرجع المبلغ تلقائياً: أرجعه من لوحة مزوّد الدفع أو البنك.") %></p>
              <div class="field"><label for="reason-<%= __(i.id) %>"><%= __("السبب") %></label><input id="reason-<%= __(i.id) %>" name="reason" class="input" maxlength="200" required></div>
              <button type="submit" class="btn btn--danger btn--small"><%= __("إصدار الإشعار") %></button>
            </form></details>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <% if (!invoices.length) { %><p class="empty-state"><%= __("لا توجد فواتير.") %></p><% } %>
</section>

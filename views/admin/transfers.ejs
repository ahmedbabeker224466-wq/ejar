<div class="page-head"><h1><%= __("الحوالات البنكية") %></h1></div>
<% if (done) { %><div class="flash flash--success" role="status"><%= __(done) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>
<nav class="tabs" aria-label="<%= __("التصفية") %>">
  <a href="/admin/transfers" <%- status === '' ? 'aria-current="page"' : '' %>><%= __("الكل") %></a>
  <a href="/admin/transfers?status=pending" <%- status === 'pending' ? 'aria-current="page"' : '' %>><%= __("بانتظار المراجعة") %></a>
  <a href="/admin/transfers?status=approved" <%- status === 'approved' ? 'aria-current="page"' : '' %>><%= __("مقبولة") %></a>
  <a href="/admin/transfers?status=rejected" <%- status === 'rejected' ? 'aria-current="page"' : '' %>><%= __("مرفوضة") %></a>
</nav>
<ul class="item-list">
  <% rows.forEach(function (t) { %>
    <li class="item">
      <div class="item__title"><strong><%= __("حوالة") %> #<%= __(t.id) %></strong> <a href="/admin/offices/<%= __(t.officeId) %>"><%= __(t.officeName) %></a>
        <span class="badge badge--bill-<%= __(t.status === 'approved' ? 'success' : t.status === 'rejected' ? 'danger' : 'info') %>"><%= __({ pending: __('بانتظار المراجعة'), approved: __('مقبولة'), rejected: __('مرفوضة') }[t.status]) %></span></div>
      <div class="item__meta"><%= __("طلب") %> <%= __(t.orderId) %> · <%= __(t.planCode) %> · <%= __(t.interval === 'yearly' ? __('سنوي') : __('شهري')) %> · <%= __("المبلغ") %> <%= __(fmt(t.total)) %> <%= __(t.currency) %> · <%= __("المرجع:") %> <strong dir="ltr"><%= __(t.reference) %></strong> · <span dir="ltr"><%= __(stamp(t.createdAt)) %></span></div>
      <% if (t.hasReceipt) { %><p><a href="/admin/transfers/<%= __(t.id) %>/receipt" target="_blank" rel="noopener noreferrer"><%= __("عرض صورة الإيصال") %></a></p><% } %>
      <% if (t.note) { %><p class="muted"><%= __("ملاحظة:") %> <%= __(t.note) %></p><% } %>
      <% if (t.status === 'pending') { %>
        <div class="button-row">
          <details class="danger-zone"><summary><%= __("قبول وتفعيل الباقة") %></summary>
            <form method="post" action="/admin/transfers/<%= __(t.id) %>/approve" novalidate>
              <div class="field"><label for="ok-<%= __(t.id) %>"><%= __("سبب القبول (مثل: وصلت الحوالة في الكشف)") %></label><input id="ok-<%= __(t.id) %>" name="reason" class="input" maxlength="200" required></div>
              <button type="submit" class="btn btn--primary btn--small"><%= __("قبول") %></button>
            </form></details>
          <details class="danger-zone"><summary><%= __("رفض") %></summary>
            <form method="post" action="/admin/transfers/<%= __(t.id) %>/reject" novalidate>
              <div class="field"><label for="reason-<%= __(t.id) %>"><%= __("سبب الرفض (يصل للمكتب)") %></label><input id="reason-<%= __(t.id) %>" name="reason" class="input" maxlength="200" required></div>
              <button type="submit" class="btn btn--danger btn--small"><%= __("رفض الحوالة") %></button>
            </form></details>
        </div>
      <% } %>
    </li>
  <% }) %>
</ul>
<% if (!rows.length) { %><p class="empty-state"><%= __("لا توجد حوالات.") %></p><% } %>

<% const t = summary.totals; const period = summary.period; %>
<div class="page-head ac-head">
  <div>
    <h1>المحاسبة</h1>
    <p class="muted">المبالغ بالريال السعودي. ميعاد يسجّل الحركات ولا ينقل أي مال.</p>
  </div>
  <div class="ac-actions">
    <a class="btn btn--secondary" href="/office/accounting/owners?month=<%= period %>">حسابات الملّاك</a>
    <a class="btn btn--primary" href="/office/accounting/new">+ قيد جديد</a>
  </div>
</div>
<% if (message) { %><div class="flash flash--success" role="status"><%= message %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= error %></div><% } %>
<%- include('_monthnav', { navBase: '/office/accounting', period }) %>

<div class="ac-kpis">
  <div class="card ac-kpi"><span class="ac-kpi__label">الإيجارات المحصّلة</span><strong class="ac-num"><%= fmt(t.collected) %></strong><span class="ac-kpi__hint">من دفعات العقود المسجّلة</span></div>
  <div class="card ac-kpi"><span class="ac-kpi__label">المصروفات</span><strong class="ac-num"><%= fmt(t.expenses) %></strong><span class="ac-kpi__hint">على الملّاك <%= fmt(t.ownerExpenses) %> · على المكتب <%= fmt(t.officeExpenses) %></span></div>
  <div class="card ac-kpi"><span class="ac-kpi__label">دخل المكتب</span><strong class="ac-num"><%= fmt(t.officeIncome) %></strong><span class="ac-kpi__hint">عمولة <%= percent %>% وإيرادات أخرى</span></div>
  <div class="card ac-kpi ac-kpi--dark"><span class="ac-kpi__label">صافي الملّاك لهذا الشهر</span><strong class="ac-num"><%= fmt(t.ownersNet) %></strong><span class="ac-kpi__hint">حُوِّل لهم <%= fmt(t.payouts) %></span></div>
</div>

<div class="ac-grid">
  <section class="card">
    <h2 class="ac-title">الإيرادات والمصروفات <span class="muted">آخر 6 أشهر</span></h2>
    <div class="ac-chart" role="img" aria-label="رسم للإيرادات والمصروفات في آخر ستة أشهر">
      <% summary.trend.forEach(function (m) { %>
        <div class="ac-chart__month">
          <div class="ac-chart__bars"><i class="ac-h<%= Math.round(m.collectedPct / 5) * 5 %>" title="<%= fmt(m.collected) %>"></i><i class="ac-chart__out ac-h<%= Math.round(m.expensesPct / 5) * 5 %>" title="<%= fmt(m.expenses) %>"></i></div>
          <span><%= monthName(m.period) %></span>
        </div>
      <% }) %>
    </div>
    <p class="ac-legend"><span><i></i>الإيجارات المحصّلة</span><span><i class="ac-chart__out"></i>المصروفات</span></p>
  </section>
  <section class="card">
    <h2 class="ac-title">توزيع المصروفات</h2>
    <% if (summary.expenseRows.length === 0) { %><p class="empty-state">لا توجد مصروفات في هذا الشهر.</p><% } else { %>
      <ul class="ac-split">
        <% summary.expenseRows.forEach(function (r) { %>
          <li><div><span><%= r.label %></span><strong class="ac-num"><%= fmt(r.h) %></strong></div><span class="ac-bar"><i class="ac-w<%= Math.round(r.pct / 5) * 5 %>"></i></span></li>
        <% }) %>
      </ul>
    <% } %>
    <form class="ac-commission" method="post" action="/office/accounting/commission">
      <label for="percent">نسبة عمولة المكتب من الإيجار المحصّل</label>
      <div class="ac-inline"><input id="percent" name="percent" class="input" inputmode="decimal" value="<%= percent %>" maxlength="5"><span>%</span><button type="submit" class="btn btn--secondary btn--small">حفظ</button></div>
      <p class="muted">تُطبَّق النسبة الحالية على كل الأشهر في الكشوف.</p>
    </form>
  </section>
</div>

<section class="card">
  <div class="page-head"><h2 class="ac-title">حركات الشهر</h2><a class="btn btn--secondary btn--small" href="/office/accounting/csv?month=<%= period %>">تصدير CSV</a></div>
  <% if (rows.length === 0) { %><p class="empty-state">لا توجد حركات في هذا الشهر. سجّل دفعات العقود أو أضف قيداً جديداً.</p><% } else { %>
    <div class="table-wrap"><table class="table ac-table">
      <thead><tr><th>التاريخ</th><th>البيان</th><th class="ac-col-type">النوع</th><th class="ac-amount">المبلغ</th><th><span class="visually-hidden">إجراء</span></th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr class="<%= r.voided ? 'ac-voided' : '' %>">
            <td dir="ltr" class="ac-date"><%= r.day %></td>
            <td><% if (r.link) { %><a href="<%= r.link %>"><%= r.label %></a><% } else { %><%= r.label %><% } %><% if (r.description) { %><div class="muted"><%= r.description %></div><% } %><% if (r.voided) { %><div class="muted">ملغى: <%= r.voidReason %></div><% } %></td>
            <td class="ac-col-type"><span class="ac-pill ac-pill--<%= r.kind || 'rent' %>"><%= r.typeLabel %></span></td>
            <td class="ac-amount ac-num <%= r.tone === 'in' ? 'ac-in' : 'ac-out' %>"><%= r.tone === 'in' ? '+' : '-' %> <%= fmt(r.h) %></td>
            <td>
              <% if (r.source === 'ledger' && !r.voided) { %>
                <details class="ac-void"><summary>إلغاء</summary>
                  <form method="post" action="/office/accounting/<%= r.id %>/void">
                    <input type="hidden" name="month" value="<%= period %>">
                    <label for="reason-<%= r.id %>">سبب الإلغاء</label>
                    <input id="reason-<%= r.id %>" name="reason" class="input" minlength="3" maxlength="200" required>
                    <button type="submit" class="btn btn--danger btn--small">إلغاء القيد</button>
                  </form>
                </details>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (more) { %><p class="muted">عرضنا آخر 50 حركة. صدّر الملف لرؤية الكل.</p><% } %>
  <% } %>
</section>

<p class="back-link"><a href="<%= __(unit ? `/office/units/${unit.id}` : '/office/units') %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع") %></a></p>
<section class="card form-card">
  <h1><%= __(unit ? __('تعديل الوحدة') : __('إضافة وحدة')) %></h1>
  <%- include('_limit') %>

  <form method="post" action="<%= __(unit ? `/office/units/${unit.id}` : '/office/units') %>" novalidate>
    <%- include('_links') %>

    <div class="field">
      <label for="label"><%= __("اسم الوحدة") %></label>
      <input id="label" name="label" class="input" type="text" maxlength="120" required value="<%= __(values.label) %>" <%- errors.label ? 'aria-invalid="true"' : '' %>>
      <p class="field-hint"><%= __("مثال: شقة 3، محل 1") %></p>
      <% if (errors.label) { %><p class="field-error"><%= __(errors.label) %></p><% } %>
    </div>

    <div class="field">
      <label for="unit_type"><%= __("نوع الوحدة") %></label>
      <select id="unit_type" name="unit_type" class="select" <%- errors.unit_type ? 'aria-invalid="true"' : '' %>>
        <% Object.entries(unitTypes).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(values.unit_type === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
      </select>
      <% if (errors.unit_type) { %><p class="field-error"><%= __(errors.unit_type) %></p><% } %>
    </div>

    <div class="form-grid">
      <% [['rooms', __('عدد الغرف'), 'numeric'], ['bathrooms', __('دورات المياه'), 'numeric'], ['area_sqm', __('المساحة (م²)'), 'decimal'], ['floor_no', __('الدور'), 'numeric']].forEach(function ([name, label, mode]) { %>
        <div class="field">
          <label for="<%= __(name) %>"><%= __(label) %></label>
          <input id="<%= __(name) %>" name="<%= __(name) %>" class="input" type="text" inputmode="<%= __(mode) %>" dir="ltr" maxlength="12" value="<%= __(values[name]) %>" <%- errors[name] ? 'aria-invalid="true"' : '' %>>
          <% if (errors[name]) { %><p class="field-error"><%= __(errors[name]) %></p><% } %>
        </div>
      <% }) %>
    </div>

    <div class="field">
      <label for="base_rent"><%= __("الإيجار السنوي المعتاد (ريال)") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <input id="base_rent" name="base_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.base_rent) %>" <%- errors.base_rent ? 'aria-invalid="true"' : '' %>>
      <% if (errors.base_rent) { %><p class="field-error"><%= __(errors.base_rent) %></p><% } %>
    </div>

    <label class="check">
      <input type="checkbox" name="is_furnished" value="1" <%= __(values.is_furnished ? 'checked' : '') %>>
      <span><%= __("مفروشة") %></span>
    </label>

    <div class="field">
      <label for="district"><%= __("الحي") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <input id="district" name="district" class="input" type="text" maxlength="80" value="<%= __(values.district || '') %>" <%- errors.district ? 'aria-invalid="true"' : '' %>>
      <% if (errors.district) { %><p class="field-error"><%= __(errors.district) %></p><% } %>
    </div>

    <fieldset class="field checks">
      <legend><%= __("المزايا") %></legend>
      <% if (errors.amenities) { %><p class="field-error"><%= __(errors.amenities) %></p><% } %>
      <div class="checks__grid">
        <% Object.entries(amenityLabels).forEach(function ([key, label]) { %>
          <label class="check">
            <input type="checkbox" name="amenities" value="<%= __(key) %>" <%= __(values.amenities.includes(key) ? 'checked' : '') %>>
            <span><%= __(label) %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>

    <div class="field">
      <label for="notes"><%= __("ملاحظات") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <textarea id="notes" name="notes" class="textarea" maxlength="1000" <%- errors.notes ? 'aria-invalid="true"' : '' %>><%= __(values.notes) %></textarea>
      <% if (errors.notes) { %><p class="field-error"><%= __(errors.notes) %></p><% } %>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("حفظ") %></button>
  </form>
</section>
<script src="<%= assetUrl('/js/unitForm.js') %>" defer></script>

<p class="back-link"><a href="<%= unit ? `/office/units/${unit.id}` : '/office/units' %>">→ رجوع</a></p>
<section class="card form-card">
  <h1><%= unit ? 'تعديل الوحدة' : 'إضافة وحدة' %></h1>
  <%- include('_limit') %>

  <form method="post" action="<%= unit ? `/office/units/${unit.id}` : '/office/units' %>" novalidate>
    <%- include('_links') %>

    <div class="field">
      <label for="label">اسم الوحدة</label>
      <input id="label" name="label" class="input" type="text" maxlength="120" required value="<%= values.label %>" <%- errors.label ? 'aria-invalid="true"' : '' %>>
      <p class="field-hint">مثال: شقة 3، محل 1</p>
      <% if (errors.label) { %><p class="field-error"><%= errors.label %></p><% } %>
    </div>

    <div class="field">
      <label for="unit_type">نوع الوحدة</label>
      <select id="unit_type" name="unit_type" class="select" <%- errors.unit_type ? 'aria-invalid="true"' : '' %>>
        <% Object.entries(unitTypes).forEach(function ([key, label]) { %><option value="<%= key %>" <%= values.unit_type === key ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
      <% if (errors.unit_type) { %><p class="field-error"><%= errors.unit_type %></p><% } %>
    </div>

    <div class="form-grid">
      <% [['rooms', 'عدد الغرف', 'numeric'], ['bathrooms', 'دورات المياه', 'numeric'], ['area_sqm', 'المساحة (م²)', 'decimal'], ['floor_no', 'الدور', 'numeric']].forEach(function ([name, label, mode]) { %>
        <div class="field">
          <label for="<%= name %>"><%= label %></label>
          <input id="<%= name %>" name="<%= name %>" class="input" type="text" inputmode="<%= mode %>" dir="ltr" maxlength="12" value="<%= values[name] %>" <%- errors[name] ? 'aria-invalid="true"' : '' %>>
          <% if (errors[name]) { %><p class="field-error"><%= errors[name] %></p><% } %>
        </div>
      <% }) %>
    </div>

    <div class="field">
      <label for="base_rent">الإيجار السنوي المعتاد (ريال) <span class="muted">(اختياري)</span></label>
      <input id="base_rent" name="base_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= values.base_rent %>" <%- errors.base_rent ? 'aria-invalid="true"' : '' %>>
      <% if (errors.base_rent) { %><p class="field-error"><%= errors.base_rent %></p><% } %>
    </div>

    <label class="check">
      <input type="checkbox" name="is_furnished" value="1" <%= values.is_furnished ? 'checked' : '' %>>
      <span>مفروشة</span>
    </label>

    <div class="field">
      <label for="district">الحي <span class="muted">(اختياري)</span></label>
      <input id="district" name="district" class="input" type="text" maxlength="80" value="<%= values.district || '' %>" <%- errors.district ? 'aria-invalid="true"' : '' %>>
      <% if (errors.district) { %><p class="field-error"><%= errors.district %></p><% } %>
    </div>

    <fieldset class="field checks">
      <legend>المزايا</legend>
      <% if (errors.amenities) { %><p class="field-error"><%= errors.amenities %></p><% } %>
      <div class="checks__grid">
        <% Object.entries(amenityLabels).forEach(function ([key, label]) { %>
          <label class="check">
            <input type="checkbox" name="amenities" value="<%= key %>" <%= values.amenities.includes(key) ? 'checked' : '' %>>
            <span><%= label %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>

    <div class="field">
      <label for="notes">ملاحظات <span class="muted">(اختياري)</span></label>
      <textarea id="notes" name="notes" class="textarea" maxlength="1000" <%- errors.notes ? 'aria-invalid="true"' : '' %>><%= values.notes %></textarea>
      <% if (errors.notes) { %><p class="field-error"><%= errors.notes %></p><% } %>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--large">حفظ</button>
  </form>
</section>
<script src="<%= assetUrl('/js/unitForm.js') %>" defer></script>

<div class="page-head">
  <h1><%= __("العقارات والوحدات") %></h1>
  <% if (counts.usageText) { %><span class="badge badge--calm usage"><%= __(counts.usageText) %></span><% } %>
</div>

<nav class="tabs" aria-label="<%= __("أقسام الصفحة") %>">
  <a href="/office/units" <%- tab === 'units' ? 'aria-current="page"' : '' %>><%= __("الوحدات") %> (<%= __(counts.total) %>)</a>
  <a href="/office/units?tab=buildings" <%- tab === 'buildings' ? 'aria-current="page"' : '' %>><%= __("المباني") %> (<%= __(counts.buildings) %>)</a>
</nav>

<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<% if (landlords.length === 0 && counts.total === 0 && counts.buildings === 0) { %>
  <section class="card empty-card">
    <h2><%= __("أضف مالكاً أولاً") %></h2>
    <p class="lead"><%= __("كل مبنى وكل وحدة تتبع مالكاً. أضف أول مالك ثم ارجع هنا.") %></p>
    <a href="/office/landlords/new" class="btn btn--primary btn--large btn--block"><%= __("إضافة مالك") %></a>
  </section>
<% } else if (tab === 'buildings') { %>
  <div class="button-row">
    <a href="/office/units/buildings/new" class="btn btn--primary"><%= __("إضافة مبنى") %></a>
  </div>

  <form class="card filter-bar" method="get" action="/office/units" role="search">
    <input type="hidden" name="tab" value="buildings">
    <div class="field">
      <label for="q"><%= __("بحث باسم المبنى أو الحي") %></label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= __(q) %>">
    </div>
    <div class="field">
      <label for="landlord"><%= __("المالك") %></label>
      <select id="landlord" name="landlord" class="select">
        <option value=""><%= __("الكل") %></option>
        <% landlords.forEach(function (l) { %><option value="<%= __(l.id) %>" <%= __(landlordId === l.id ? 'selected' : '') %>><%= __(l.label) %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead"><%= __(filtered ? __('لا توجد نتائج تطابق البحث.') : __('لا توجد مبانٍ بعد. المبنى اختياري، ويمكنك إضافة وحدات بدون مبنى.')) %></p>
    </section>
  <% } else { %>
    <ul class="item-list">
      <% rows.forEach(function (b) { %>
        <li class="card item">
          <a class="item__title" href="/office/units/buildings/<%= __(b.id) %>/edit"><%= __(b.name) %></a>
          <p class="item__meta">
            <span><%= __(b.city) %><%= __(b.district ? ` · ${b.district}` : '') %></span>
            <span><%= __("المالك:") %> <%= __(b.landlord_label) %></span>
          </p>
          <p class="item__meta"><a href="/office/units?building=<%= __(b.id) %>"><%= countOf(b.units_count, 'وحدة', lang) %></a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } else { %>
  <section class="unit-stats" aria-label="<%= __("أرقام الوحدات") %>">
    <a class="card mini-stat" href="/office/units?status=vacant"><strong><%= __(counts.vacant) %></strong> <%= __("شاغرة") %></a>
    <a class="card mini-stat" href="/office/units?status=rented"><strong><%= __(counts.rented) %></strong> <%= __("مؤجرة") %></a>
    <a class="card mini-stat" href="/office/units?status=maintenance"><strong><%= __(counts.maintenance) %></strong> <%= __("تحت الصيانة") %></a>
  </section>

  <div class="button-row">
    <a href="/office/units/new" class="btn btn--primary"><%= __("إضافة وحدة") %></a>
    <a href="/office/units/bulk" class="btn btn--secondary"><%= __("إضافة عدة وحدات") %></a>
  </div>

  <form class="card filter-bar" method="get" action="/office/units" role="search">
    <div class="field">
      <label for="q"><%= __("بحث باسم الوحدة") %></label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= __(q) %>">
    </div>
    <div class="filter-grid">
      <div class="field">
        <label for="landlord"><%= __("المالك") %></label>
        <select id="landlord" name="landlord" class="select">
          <option value=""><%= __("الكل") %></option>
          <% landlords.forEach(function (l) { %><option value="<%= __(l.id) %>" <%= __(landlordId === l.id ? 'selected' : '') %>><%= __(l.label) %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="building"><%= __("المبنى") %></label>
        <select id="building" name="building" class="select">
          <option value=""><%= __("الكل") %></option>
          <% buildingOptions.forEach(function (b) { %><option value="<%= __(b.id) %>" <%= __(buildingId === b.id ? 'selected' : '') %>><%= __(b.name) %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="status"><%= __("الحالة") %></label>
        <select id="status" name="status" class="select">
          <option value=""><%= __("الكل") %></option>
          <% Object.entries(statusLabels).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(status === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="type"><%= __("النوع") %></label>
        <select id="type" name="type" class="select">
          <option value=""><%= __("الكل") %></option>
          <% Object.entries(unitTypes).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(unitType === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead"><%= __(filtered ? __('لا توجد نتائج تطابق البحث.') : __('لا توجد وحدات بعد.')) %></p>
    </section>
  <% } else { %>
    <p class="muted"><%= countOf(total, 'وحدة', lang) %></p>
    <ul class="item-list">
      <% rows.forEach(function (u) { %>
        <li class="card item">
          <a class="item__title" href="/office/units/<%= __(u.id) %>"><%= __(u.label) %></a>
          <div class="item__badges">
            <span class="badge badge--unit-<%= __(u.status) %>"><%= __(statusLabels[u.status]) %></span>
            <span class="badge badge--calm"><%= __(unitTypes[u.unit_type]) %></span>
          </div>
          <p class="item__meta">
            <span><%= __("المالك:") %> <%= __(u.landlord_label) %></span>
            <% if (u.building_name) { %><span><%= __(u.building_name) %></span><% } %>
            <span><%= __(u.city) %></span>
            <% if (u.base_rent !== null) { %><span><%= __(Number(u.base_rent).toLocaleString('en-US')) %> <%= __("ريال") %></span><% } %>
          </p>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } %>

<% if (typeof pages !== 'undefined' && pages > 1) { %>
  <nav class="pager" aria-label="<%= __("الصفحات") %>">
    <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= __(prevUrl) %>"><%= __("السابق") %></a><% } else { %><span></span><% } %>
    <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
    <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= __(nextUrl) %>"><%= __("التالي") %></a><% } else { %><span></span><% } %>
  </nav>
<% } %>

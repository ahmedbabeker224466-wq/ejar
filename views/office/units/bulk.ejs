<p class="back-link"><a href="/office/units"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع") %></a></p>
<section class="card form-card">
  <h1><%= __("إضافة عدة وحدات") %></h1>
  <p class="lead"><%= __("أنشئ حتى") %> <%= __(bulkMax) %> <%= __("وحدة مرة واحدة بنفس النوع والمبنى والإيجار. مثال:") %> "<%= __("شقة") %>" <%= __("و12 تبدأ من 1 تنشئ") %> "<%= __("شقة 1") %>" <%= __("حتى") %> "<%= __("شقة 12") %>".</p>
  <%- include('_limit') %>

  <form method="post" action="/office/units/bulk" novalidate>
    <%- include('_links') %>

    <div class="field">
      <label for="prefix"><%= __("بداية الاسم") %></label>
      <input id="prefix" name="prefix" class="input" type="text" maxlength="100" required value="<%= __(values.prefix) %>" <%- errors.prefix ? 'aria-invalid="true"' : '' %>>
      <% if (errors.prefix) { %><p class="field-error"><%= __(errors.prefix) %></p><% } %>
    </div>

    <div class="form-grid">
      <div class="field">
        <label for="count"><%= __("عدد الوحدات") %></label>
        <input id="count" name="count" class="input" type="text" inputmode="numeric" dir="ltr" maxlength="3" required value="<%= __(values.count) %>" <%- errors.count ? 'aria-invalid="true"' : '' %>>
        <% if (errors.count) { %><p class="field-error"><%= __(errors.count) %></p><% } %>
      </div>
      <div class="field">
        <label for="start"><%= __("يبدأ الترقيم من") %></label>
        <input id="start" name="start" class="input" type="text" inputmode="numeric" dir="ltr" maxlength="6" value="<%= __(values.start) %>" <%- errors.start ? 'aria-invalid="true"' : '' %>>
        <% if (errors.start) { %><p class="field-error"><%= __(errors.start) %></p><% } %>
      </div>
    </div>

    <div class="field">
      <label for="unit_type"><%= __("نوع الوحدات") %></label>
      <select id="unit_type" name="unit_type" class="select" <%- errors.unit_type ? 'aria-invalid="true"' : '' %>>
        <% Object.entries(unitTypes).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(values.unit_type === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
      </select>
    </div>

    <div class="field">
      <label for="base_rent"><%= __("الإيجار السنوي لكل وحدة (ريال)") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <input id="base_rent" name="base_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.base_rent) %>" <%- errors.base_rent ? 'aria-invalid="true"' : '' %>>
      <% if (errors.base_rent) { %><p class="field-error"><%= __(errors.base_rent) %></p><% } %>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("أنشئ الوحدات") %></button>
  </form>
</section>
<script src="<%= assetUrl('/js/unitForm.js') %>" defer></script>

<div class="page-head">
  <h1>المستأجرون</h1>
  <% if (canAddContract) { %><a href="/office/contracts/new" class="btn btn--primary">إضافة عقد</a><% } %>
</div>

<p class="muted">يظهر هنا كل مستأجر بالاسم المختصر المكتوب في عقده. لدعوة مستأجر افتح عقده وأنشئ له رمز دعوة.</p>

<% if (total === 0 && !filtered) { %>
  <section class="card empty-card">
    <h2>لا يوجد مستأجرون بعد</h2>
    <p class="lead">يظهر المستأجر هنا تلقائياً عند إضافة عقد له.</p>
    <% if (canAddContract) { %><a href="/office/contracts/new" class="btn btn--primary btn--large btn--block">إضافة عقد</a><% } %>
  </section>
<% } else { %>
  <form class="card filter-bar" method="get" action="/office/tenants" role="search">
    <div class="field">
      <label for="q">بحث بالاسم أو الوحدة أو رقم العقد</label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= q %>">
    </div>
    <div class="field">
      <label for="status">حالة الانضمام</label>
      <select id="status" name="status" class="select">
        <option value="">الكل</option>
        <% Object.entries(statusLabels).forEach(function ([key, label]) { %>
          <option value="<%= key %>" <%= status === key ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--secondary btn--block">عرض</button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead">لا توجد نتائج تطابق البحث.</p>
      <a href="/office/tenants" class="btn btn--secondary">عرض كل المستأجرين</a>
    </section>
  <% } else { %>
    <p class="muted"><%= total %> مستأجر</p>
    <ul class="item-list">
      <% rows.forEach(function (row) { %>
        <li class="card item">
          <a class="item__title" href="/office/contracts/<%= row.id %>"><%= row.tenantLabel || 'مستأجر بدون اسم مختصر' %></a>
          <div class="item__badges">
            <span class="badge badge--link-<%= row.joinStatus %>"><%= row.joinLabel %></span>
            <span class="badge badge--stage-<%= row.stage %>"><%= stageLabels[row.stage] || row.stage %></span>
          </div>
          <p class="item__meta">
            <% if (row.unitId) { %><span>الوحدة: <a href="/office/units/<%= row.unitId %>"><%= row.unitLabel %></a></span><% } else { %><span>بدون وحدة</span><% } %>
            <span>العقد: <a href="/office/contracts/<%= row.id %>"><% if (row.contractNumber) { %><bdi dir="ltr"><%= row.contractNumber %></bdi><% } else { %>رقم <%= row.id %><% } %></a></span>
          </p>
        </li>
      <% }) %>
    </ul>

    <% if (pages > 1) { %>
      <nav class="pager" aria-label="الصفحات">
        <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= prevUrl %>">السابق</a><% } else { %><span></span><% } %>
        <span>صفحة <%= page %> من <%= pages %></span>
        <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= nextUrl %>">التالي</a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } %>
<% } %>

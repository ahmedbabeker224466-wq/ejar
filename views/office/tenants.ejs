<div class="page-head">
  <h1><%= __("المستأجرون") %></h1>
  <% if (canAddContract) { %><a href="/office/contracts/new" class="btn btn--primary"><%= __("إضافة عقد") %></a><% } %>
</div>

<p class="muted"><%= __("يظهر هنا كل مستأجر بالاسم المختصر المكتوب في عقده. لدعوة مستأجر افتح عقده وأنشئ له رمز دعوة.") %></p>

<% if (total === 0 && !filtered) { %>
  <section class="card empty-card">
    <h2><%= __("لا يوجد مستأجرون بعد") %></h2>
    <p class="lead"><%= __("يظهر المستأجر هنا تلقائياً عند إضافة عقد له.") %></p>
    <% if (canAddContract) { %><a href="/office/contracts/new" class="btn btn--primary btn--large btn--block"><%= __("إضافة عقد") %></a><% } %>
  </section>
<% } else { %>
  <form class="card filter-bar" method="get" action="/office/tenants" role="search">
    <div class="field">
      <label for="q"><%= __("بحث بالاسم أو الوحدة أو رقم العقد") %></label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= __(q) %>">
    </div>
    <div class="field">
      <label for="status"><%= __("حالة الانضمام") %></label>
      <select id="status" name="status" class="select">
        <option value=""><%= __("الكل") %></option>
        <% Object.entries(statusLabels).forEach(function ([key, label]) { %>
          <option value="<%= __(key) %>" <%= __(status === key ? 'selected' : '') %>><%= __(label) %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead"><%= __("لا توجد نتائج تطابق البحث.") %></p>
      <a href="/office/tenants" class="btn btn--secondary"><%= __("عرض كل المستأجرين") %></a>
    </section>
  <% } else { %>
    <p class="muted"><%= countOf(total, 'مستأجر', lang) %></p>
    <ul class="item-list">
      <% rows.forEach(function (row) { %>
        <li class="card item">
          <a class="item__title" href="/office/contracts/<%= __(row.id) %>"><%= __(row.tenantLabel || __('مستأجر بدون اسم مختصر')) %></a>
          <div class="item__badges">
            <span class="badge badge--link-<%= __(row.joinStatus) %>"><%= __(row.joinLabel) %></span>
            <span class="badge badge--stage-<%= __(row.stage) %>"><%= __(stageLabels[row.stage] || row.stage) %></span>
          </div>
          <p class="item__meta">
            <% if (row.unitId) { %><span><%= __("الوحدة:") %> <a href="/office/units/<%= __(row.unitId) %>"><%= __(row.unitLabel) %></a></span><% } else { %><span><%= __("بدون وحدة") %></span><% } %>
            <span><%= __("العقد:") %> <a href="/office/contracts/<%= __(row.id) %>"><% if (row.contractNumber) { %><bdi dir="ltr"><%= __(row.contractNumber) %></bdi><% } else { %><%= __("رقم") %> <%= __(row.id) %><% } %></a></span>
          </p>
        </li>
      <% }) %>
    </ul>

    <% if (pages > 1) { %>
      <nav class="pager" aria-label="<%= __("الصفحات") %>">
        <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= __(prevUrl) %>"><%= __("السابق") %></a><% } else { %><span></span><% } %>
        <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
        <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= __(nextUrl) %>"><%= __("التالي") %></a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } %>
<% } %>

<h1 class="office-title">أهلاً بك في <%= office.name %></h1>

<section class="stats" aria-label="أرقام المكتب">
  <div class="stat card">
    <p class="stat__value"><%= counts.activeContracts %></p>
    <p class="stat__label">عقود سارية</p>
  </div>
  <div class="stat card">
    <p class="stat__value"><%= counts.expiring90 %></p>
    <p class="stat__label">تنتهي خلال 90 يوماً</p>
  </div>
  <div class="stat card">
    <p class="stat__value"><%= counts.overduePayments %></p>
    <p class="stat__label">دفعات متأخرة</p>
  </div>
  <div class="stat card">
    <p class="stat__value"><%= counts.openMaintenance %></p>
    <p class="stat__label">طلبات صيانة مفتوحة</p>
  </div>
  <% if (can('landlords')) { %>
    <a class="stat card stat--link" href="/office/landlords">
      <p class="stat__value"><%= counts.landlordsActive %></p>
      <p class="stat__label">الملّاك</p>
    </a>
  <% } %>
</section>

<% if (can('units')) { %>
  <section class="card office-section">
    <h2><a href="/office/units">الوحدات</a></h2>
    <div class="units-summary">
      <div class="mini-stat"><strong class="stat__units-total"><%= counts.units.total %></strong> كل الوحدات</div>
      <div class="mini-stat"><strong><%= counts.units.vacant %></strong> شاغرة</div>
      <div class="mini-stat"><strong><%= counts.units.rented %></strong> مؤجرة</div>
      <div class="mini-stat"><strong><%= counts.units.maintenance %></strong> تحت الصيانة</div>
    </div>
    <% if (counts.units.usageText) { %><p class="muted">حد الباقة: <%= counts.units.usageText %></p><% } %>
  </section>
<% } %>

<section class="card office-section">
  <h2>يحتاج إجراء</h2>
  <% if (needsAction.length) { %>
    <ul class="action-list">
      <% needsAction.forEach(function (item) { %>
        <li><a href="<%= item.href %>"><strong><%= item.count %></strong> <%= item.text %></a></li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="empty-state">لا يوجد ما يحتاج إجراءً الآن. سنعرض هنا العقود التي تقترب مواعيدها والدفعات المتأخرة.</p>
  <% } %>
</section>

<% if (setupSteps.length) { %>
  <section class="card office-section">
    <h2>ابدأ تجهيز مكتبك</h2>
    <ul class="checklist">
      <% setupSteps.forEach(function (step) { %>
        <li>
          <a href="<%= step.href %>"<%- step.done ? ' class="is-done"' : '' %>>
            <span class="checklist__box" aria-hidden="true"><%= step.done ? '✓' : '' %></span>
            <span><%= step.label %></span>
            <span class="visually-hidden"><%= step.done ? '(مكتمل)' : '(لم يكتمل)' %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="card office-locked">
  <% if (reason === 'admin_suspended') { %>
  <h1><%= __("حساب المكتب موقوف") %></h1>
  <p class="lead"><%= __("أوقفت إدارة ميعاد حساب المكتب مؤقتاً. تواصل معنا لمعرفة السبب وإعادة التفعيل.") %></p>
  <p class="muted"><%= __("بياناتك محفوظة ولم يُحذف منها شيء.") %></p>
  <a href="/contact" class="btn btn--primary btn--large btn--block"><%= __("تواصل معنا") %></a>
  <% } else { %>
  <h1><%= __(reason === 'read_only' ? __('وضع القراءة فقط') : __('اشتراكك منتهي')) %></h1>
  <p class="lead">
    <%= __(reason === 'trial_expired'
      ? __('انتهت التجربة المجانية لمكتبك. اشترك لتعود إلى العقود والتذكيرات.')
      : reason === 'read_only'
        ? __('انتهى اشتراك المكتب. يمكنك الاطلاع على بياناتك لكن لا يمكن التعديل أو الإضافة حتى يُجدَّد الاشتراك.')
        : __('حساب المكتب موقوف حالياً. اشترك أو جدّد الاشتراك لتعود إلى العقود والتذكيرات.')) %>
  </p>
  <p class="muted"><%= __("بياناتك محفوظة ولم يُحذف منها شيء.") %></p>
  <% if (can('billing')) { %>
    <a href="/office/billing" class="btn btn--primary btn--large btn--block"><%= __("الذهاب إلى الاشتراك") %></a>
  <% } else { %>
    <p class="lead"><%= __("تواصل مع مالك المكتب لتجديد الاشتراك.") %></p>
  <% } %>
  <% } %>
</section>

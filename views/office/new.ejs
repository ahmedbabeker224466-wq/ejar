<section class="card form-card">
  <h1><%= __("أنشئ مكتبك") %></h1>
  <p class="lead"><%= __("اكتب بيانات مكتبك. تبدأ تجربة مجانية لمدة 14 يوماً، دون بطاقة دفع.") %></p>
  <p class="flash flash--info"><%= __("مالك عقار أو مستأجر ووصلك رمز دعوة من مكتب؟") %> <a href="/join"><%= __("ادخل الرمز هنا") %></a> <%= __("بدلاً من إنشاء مكتب.") %></p>

  <% if (errors.form) { %>
    <div class="flash flash--danger" role="alert"><%= __(errors.form) %></div>
  <% } else if (Object.keys(errors).length) { %>
    <div class="flash flash--danger" role="alert"><%= __("راجع الحقول المظللة بالأحمر.") %></div>
  <% } %>

  <form method="post" action="/office/new" novalidate>
    <%- include('../partials/office-fields') %>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("أنشئ المكتب") %></button>
  </form>
</section>

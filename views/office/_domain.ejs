<section class="card form-card" id="domain">
  <h2><%= __("نطاق مكتبك") %></h2>
  <% if (domain.notice) { %><div class="flash flash--success" role="status"><%= __(domain.notice) %></div><% } %>
  <% if (domain.errors.form) { %><div class="flash flash--danger" role="alert"><%= __(domain.errors.form) %></div><% } %>

  <% if (domain.freeLink) { %>
    <p><%= __("رابطك المجاني يعمل دائماً، حتى مع النطاق الخاص:") %></p>
    <div class="invite-code office-link"><output id="domain-free-link" dir="ltr"><%= __(domain.freeLink) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-free-link" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
  <% } %>

  <% if (domain.activeDomain) { %>
    <p><%= __("نطاق مكتبك:") %> <a href="https://<%= __(domain.activeDomain) %>/" dir="ltr" target="_blank" rel="noopener noreferrer"><strong>https://<%= __(domain.activeDomain) %></strong></a> <span class="badge badge--domain-active"><%= __("فعّال") %></span></p>
    <p class="muted"><%= __("يعرض هذا العنوان صفحة مكتبك العامة وإعلاناتك. إذا لم يفتح بعد فقد يحتاج ساعات حتى تكتمل إعدادات الدومين. لتغيير النطاق تواصل مع الدعم.") %></p>
  <% } else if (domain.request && domain.request.open) { %>
    <% const r = domain.request; %>
    <div class="domain-status" id="domain-request">
      <p><%= __("طلبك:") %> <strong dir="ltr"><%= __(r.domain) %></strong>
        <span class="badge badge--domain-<%= __(r.status) %>"><%= __(r.statusLabel) %></span></p>
      <p class="muted"><%= __(r.type === 'own' ? __('لدي دومين') : __('احجز لي دوميناً')) %></p>

      <% if (r.type === 'own' && r.connection_method === 'nameservers') { %>
        <% if (r.assigned_ns_1 && r.assigned_ns_2) { %>
          <p><%= __("غيّر Nameservers الدومين عند مزودك إلى القيمتين التاليتين:") %></p>
          <div class="copy-box" dir="ltr">
            <div class="invite-code"><output id="domain-ns-1"><%= __(r.assigned_ns_1) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-ns-1" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
            <div class="invite-code"><output id="domain-ns-2"><%= __(r.assigned_ns_2) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-ns-2" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
          </div>
          <p class="muted"><%= __("قد يستغرق التغيير من ساعات إلى يومين حتى يظهر في كل مكان.") %></p>
        <% } else { %>
          <p class="muted"><%= __("سيرسل لك الدعم القيم قريباً.") %></p>
        <% } %>
      <% } else if (r.type === 'own') { %>
        <% if (domain.records.target || domain.records.ip) { %>
          <p><%= __("أضف السجلات التالية عند مزود الدومين:") %></p>
          <div class="copy-box" dir="ltr">
            <% if (domain.records.target) { %><div class="invite-code"><span>CNAME www <%= dir === 'rtl' ? '→' : '←' %></span><output id="domain-cname"><%= __(domain.records.target) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-cname" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div><% } %>
            <% if (domain.records.ip) { %><div class="invite-code"><span>A @ <%= dir === 'rtl' ? '→' : '←' %></span><output id="domain-a"><%= __(domain.records.ip) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-a" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div><% } %>
          </div>
        <% } else { %>
          <p class="muted"><%= __("سيرسل لك الدعم القيم قريباً.") %></p>
        <% } %>
      <% } else { %>
        <% if (r.alt_domains.length) { %><p><%= __("البدائل:") %> <% r.alt_domains.forEach(function (a, i) { %><span dir="ltr"><%= __(a) %></span><%= __(i < r.alt_domains.length - 1 ? __('، ') : '') %><% }) %></p><% } %>
        <p><%= __("تكلفة الدومين الفعلية + رسم خدمة") %> <%= __(domain.fmt(r.service_fee_halalas)) %> <%= __("ريال، ويُسجَّل باسم المكتب.") %></p>
        <% if (r.price_cost_halalas) { %><p><%= __("تكلفة الدومين حسب المراجعة:") %> <strong><%= __(domain.fmt(r.price_cost_halalas)) %> <%= __("ريال") %></strong> + <%= __("رسم الخدمة.") %></p><% } %>
        <p class="muted"><%= __("نتحقق من توفر الاسم بعد الطلب، ولا نضمن توفره قبل ذلك.") %></p>
      <% } %>

      <% if (domain.canRequest) { %>
        <form method="post" action="/office/settings/domain/<%= __(r.id) %>/cancel">
          <button type="submit" class="btn btn--secondary btn--block"><%= __("إلغاء الطلب") %></button>
        </form>
      <% } %>
    </div>
  <% } else if (domain.mode === 'none') { %>
    <div class="domain-locked">
      <p><strong>🔒 <%= __("النطاق الخاص غير متاح في باقتك الحالية.") %></strong></p>
      <p class="muted"><%= __("رقِّ باقتك لتربط مكتبك بنطاق خاص مثل myoffice.sa.") %></p>
      <% if (domain.canRequest) { %><a href="/office/billing" class="btn btn--primary"><%= __("ترقية الباقة") %></a><% } else { %><p class="muted"><%= __("الترقية متاحة لمالك المكتب.") %></p><% } %>
    </div>
  <% } else { %>
    <% if (domain.request && domain.request.status === 'rejected') { %><p class="muted"><%= __("طلبك السابق") %> (<span dir="ltr"><%= __(domain.request.domain) %></span>) <%= __("مرفوض. يمكنك تقديم طلب جديد.") %></p><% } %>
    <% if (domain.mode === 'addon' && domain.addonHalalas) { %>
      <p><%= __("النطاق الخاص إضافة اختيارية بـ") %> <strong><%= __(domain.fmt(domain.addonHalalas)) %> <%= __("ريال شهرياً") %></strong>. <%= __("لا تُخصم تلقائياً: نراجع الطلب ونتواصل معك قبل أي رسوم.") %></p>
    <% } else if (domain.mode === 'included') { %>
      <p><%= __("باقتك تشمل نطاقاً خاصاً واحداً.") %></p>
    <% } %>

    <% if (domain.canRequest) { %>
      <% const v = domain.values; const e = domain.errors; %>
      <form method="post" action="/office/settings/domain" novalidate class="domain-form">
        <fieldset class="field domain-choice">
          <legend><%= __("ماذا تريد؟") %></legend>
          <input type="radio" id="domain-type-own" name="type" value="own" class="choice-input" <%= __(v.type === 'own' ? 'checked' : '') %>>
          <label for="domain-type-own" class="choice"><%= __("لدي دومين") %></label>
          <input type="radio" id="domain-type-reserve" name="type" value="reserve" class="choice-input" <%= __(v.type === 'reserve' ? 'checked' : '') %>>
          <label for="domain-type-reserve" class="choice"><%= __("احجز لي دوميناً") %></label>
          <input type="radio" id="domain-type-none" name="type" value="none" class="choice-input" <%= __(v.type !== 'own' && v.type !== 'reserve' ? 'checked' : '') %>>
          <label for="domain-type-none" class="choice"><%= __("ليس الآن") %></label>

          <div class="domain-fields">
            <div class="field">
              <label for="domain-name"><%= __("اسم الدومين") %></label>
              <input id="domain-name" name="domain" class="input" type="text" dir="ltr" inputmode="url" autocapitalize="none" autocomplete="off" spellcheck="false" maxlength="253" placeholder="myoffice.sa" value="<%= __(v.domain || '') %>" <%= __(e.domain ? 'aria-invalid=true' : '') %>>
              <% if (e.domain) { %><p class="field-error" role="alert"><%= __(e.domain) %></p><% } %>
            </div>

            <div class="domain-own">
              <fieldset class="field">
                <legend><%= __("طريقة الربط") %></legend>
                <label class="check"><input type="radio" name="connection_method" value="nameservers" <%= __(v.connection_method !== 'records' ? 'checked' : '') %>> <%= __("تغيير Nameservers (الأسهل: نرسل لك قيمتين تضعهما عند مزودك)") %></label>
                <label class="check"><input type="radio" name="connection_method" value="records" <%= __(v.connection_method === 'records' ? 'checked' : '') %>> <%= __("إضافة سجلات DNS (CNAME و A) مع إبقاء Nameservers كما هي") %></label>
              </fieldset>
            </div>

            <div class="domain-reserve">
              <div class="field">
                <label for="domain-alt-1"><%= __("بديل أول (اختياري)") %></label>
                <input id="domain-alt-1" name="alt_1" class="input" type="text" dir="ltr" autocapitalize="none" autocomplete="off" spellcheck="false" maxlength="253" value="<%= __(v.alt_1 || '') %>" <%= __(e.alt_1 ? 'aria-invalid=true' : '') %>>
                <% if (e.alt_1) { %><p class="field-error" role="alert"><%= __(e.alt_1) %></p><% } %>
              </div>
              <div class="field">
                <label for="domain-alt-2"><%= __("بديل ثانٍ (اختياري)") %></label>
                <input id="domain-alt-2" name="alt_2" class="input" type="text" dir="ltr" autocapitalize="none" autocomplete="off" spellcheck="false" maxlength="253" value="<%= __(v.alt_2 || '') %>" <%= __(e.alt_2 ? 'aria-invalid=true' : '') %>>
                <% if (e.alt_2) { %><p class="field-error" role="alert"><%= __(e.alt_2) %></p><% } %>
              </div>
              <p><%= __("تكلفة الدومين الفعلية + رسم خدمة") %> <%= __(domain.fmt(domain.serviceFeeHalalas)) %> <%= __("ريال، ويُسجَّل باسم المكتب.") %></p>
              <p class="muted"><%= __("نتحقق من توفر الاسم بعد الطلب، ولا نضمن توفره قبل ذلك.") %></p>
            </div>

            <button type="submit" class="btn btn--primary btn--block"><%= __("إرسال الطلب") %></button>
          </div>
        </fieldset>
      </form>
    <% } else { %>
      <p class="muted"><%= __("طلب النطاق الخاص متاح لمالك المكتب فقط.") %></p>
    <% } %>
  <% } %>
</section>

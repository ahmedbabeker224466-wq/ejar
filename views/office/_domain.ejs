<section class="card form-card" id="domain">
  <h2><%= __("نطاق مكتبك") %></h2>
  <% if (domain.notice) { %><div class="flash flash--success" role="status"><%= __(domain.notice) %></div><% } %>
  <% if (domain.errors.form) { %><div class="flash flash--danger" role="alert"><%= __(domain.errors.form) %></div><% } %>

  <% if (domain.freeLink) { %>
    <p><%= __("رابطك المجاني يعمل دائماً، حتى مع النطاق الخاص:") %></p>
    <div class="invite-code office-link"><output id="domain-free-link" dir="ltr"><%= __(domain.freeLink) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-free-link" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
  <% } %>

  <% if (domain.activeDomain) { %>
    <p><%= __("نطاق مكتبك:") %> <a href="https://<%= __(domain.activeDomain) %>/" dir="ltr" target="_blank" rel="noopener noreferrer"><strong>https://<%= __(domain.activeDomain) %></strong></a> <span class="badge badge--domain-active"><%= __("مربوط") %></span></p>
    <p class="muted"><%= __("يعرض هذا العنوان صفحة مكتبك العامة وإعلاناتك. شهادة الأمان (https) تصدر تلقائياً خلال ساعة غالباً بعد الربط.") %></p>
    <% if (domain.canRequest) { %>
      <form method="post" action="/office/settings/domain/disconnect">
        <button type="submit" class="btn btn--danger"><%= __("إلغاء ربط الدومين") %></button>
      </form>
    <% } %>
  <% } else if (domain.request && domain.request.open) { %>
    <% const r = domain.request; %>
    <div class="domain-status" id="domain-request">
      <p><%= __("طلبك:") %> <strong dir="ltr"><%= __(r.domain) %></strong>
        <span class="badge badge--domain-<%= __(r.status) %>"><%= __(r.statusLabel) %></span></p>
      <% if (r.type !== 'own') { %><p class="muted"><%= __("احجز لي دوميناً") %></p><% } %>

      <% if (r.type === 'own' && r.connection_method === 'nameservers') { %>
        <% if (r.assigned_ns_1 && r.assigned_ns_2) { %>
          <p><%= __("غيّر Nameservers الدومين عند مزودك إلى القيمتين التاليتين:") %></p>
          <div class="copy-box" dir="ltr">
            <div class="invite-code"><output id="domain-ns-1"><%= __(r.assigned_ns_1) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-ns-1" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
            <div class="invite-code"><output id="domain-ns-2"><%= __(r.assigned_ns_2) %></output><button type="button" class="btn btn--secondary" data-copy="#domain-ns-2" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
          </div>
          <p class="muted"><%= __("قد يستغرق التغيير من ساعات إلى يومين حتى يظهر في كل مكان.") %></p>
        <% } else { %>
          <p class="muted"><%= __("سيرسل لك الدعم القيم قريباً.") %></p>
        <% } %>
      <% } else if (r.type === 'own') { %>
        <ol class="domain-steps">
          <li class="is-done"><strong><%= __("اشترِ الدومين") %></strong><span><%= __("من أي مزود، مثل Namecheap أو GoDaddy أو SaudiNIC.") %></span></li>
          <li>
            <strong><%= __("أضف سجلين في إعدادات DNS عند مزود الدومين") %></strong>
            <% if (domain.records.ip) { %>
              <div class="dns-table" dir="ltr" role="table" aria-label="<%= __("سجلات DNS") %>">
                <div class="dns-row dns-row--head" role="row"><span role="columnheader">Type</span><span role="columnheader">Host</span><span role="columnheader">Value</span><span></span></div>
                <div class="dns-row" role="row"><span role="cell">A</span><span role="cell">@</span><output id="domain-a" role="cell"><%= __(domain.records.ip) %></output><button type="button" class="btn btn--secondary btn--small" data-copy="#domain-a" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
                <div class="dns-row" role="row"><span role="cell">CNAME</span><span role="cell">www</span><output id="domain-cname" role="cell"><%= __(r.domain) %></output><button type="button" class="btn btn--secondary btn--small" data-copy="#domain-cname" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ") %></button></div>
              </div>
              <span class="muted"><%= __("احذف أي سجل A آخر للاسم @، فوجود سجلين يمنع الربط.") %></span>
            <% } else { %>
              <span class="muted"><%= __("سيرسل لك الدعم القيم قريباً.") %></span>
            <% } %>
          </li>
          <li>
            <strong><%= __("اضغط «ربط الدومين»") %></strong>
            <span><%= __("نتحقق من السجلات ونربط الدومين بصفحة مكتبك تلقائياً. قد يحتاج وصول السجلات من دقائق إلى 24 ساعة.") %></span>
            <% if (domain.connectError) { %>
              <div class="flash flash--danger" role="alert"><%= __(domain.connectError) %><% if (domain.found.length) { %> <%= __("العنوان الظاهر الآن:") %> <span dir="ltr"><%= __(domain.found.join(', ')) %></span><% } %></div>
            <% } %>
            <% if (domain.canRequest && domain.records.ip) { %>
              <form method="post" action="/office/settings/domain/<%= __(r.id) %>/connect">
                <button type="submit" class="btn btn--success btn--block"><%= __("ربط الدومين") %></button>
              </form>
            <% } %>
          </li>
        </ol>
      <% } else { %>
        <% if (r.alt_domains.length) { %><p><%= __("البدائل:") %> <% r.alt_domains.forEach(function (a, i) { %><span dir="ltr"><%= __(a) %></span><%= __(i < r.alt_domains.length - 1 ? __('، ') : '') %><% }) %></p><% } %>
        <p><%= __("تكلفة الدومين الفعلية + رسم خدمة") %> <%= __(domain.fmt(r.service_fee_halalas)) %> <%= __("ريال، ويُسجَّل باسم المكتب.") %></p>
        <% if (r.price_cost_halalas) { %><p><%= __("تكلفة الدومين حسب المراجعة:") %> <strong><%= __(domain.fmt(r.price_cost_halalas)) %> <%= __("ريال") %></strong> + <%= __("رسم الخدمة.") %></p><% } %>
        <p class="muted"><%= __("نتحقق من توفر الاسم بعد الطلب، ولا نضمن توفره قبل ذلك.") %></p>
      <% } %>

      <% if (domain.canRequest) { %>
        <form method="post" action="/office/settings/domain/<%= __(r.id) %>/cancel">
          <button type="submit" class="btn btn--link"><%= __("إلغاء وإدخال دومين آخر") %></button>
        </form>
      <% } %>
    </div>
  <% } else if (domain.mode === 'none') { %>
    <div class="domain-locked">
      <p><strong>🔒 <%= __("النطاق الخاص غير متاح في باقتك الحالية.") %></strong></p>
      <p class="muted"><%= __("رقِّ باقتك لتربط مكتبك بنطاق خاص مثل myoffice.sa.") %></p>
      <% if (domain.canRequest) { %><a href="/office/billing" class="btn btn--primary"><%= __("ترقية الباقة") %></a><% } else { %><p class="muted"><%= __("الترقية متاحة لمالك المكتب.") %></p><% } %>
    </div>
  <% } else { %>
    <% if (domain.request && domain.request.status === 'rejected') { %><p class="muted"><%= __("طلبك السابق") %> (<span dir="ltr"><%= __(domain.request.domain) %></span>) <%= __("مرفوض. يمكنك تقديم طلب جديد.") %></p><% } %>
    <p><%= __("اربط صفحة مكتبك بدومينك الخاص في ثلاث خطوات: تشتري الدومين، تضيف سجلين نعطيك قيمهما، ثم تضغط «ربط الدومين».") %></p>
    <% if (domain.mode === 'addon' && domain.addonHalalas) { %>
      <p><%= __("ربط الدومين إضافة بـ") %> <strong><%= __(domain.fmt(domain.addonHalalas)) %> <%= __("ريال شهرياً") %></strong>.</p>
    <% } %>

    <% if (domain.canRequest) { %>
      <% const v = domain.values; const e = domain.errors; %>
      <form method="post" action="/office/settings/domain" novalidate class="domain-form">
        <input type="hidden" name="type" value="own">
        <input type="hidden" name="connection_method" value="records">
        <div class="field">
          <label for="domain-name"><%= __("الدومين الذي اشتريته") %></label>
          <input id="domain-name" name="domain" class="input" type="text" dir="ltr" inputmode="url" autocapitalize="none" autocomplete="off" spellcheck="false" maxlength="253" placeholder="myoffice.sa" value="<%= __(v.domain || '') %>" <%= __(e.domain ? 'aria-invalid=true' : '') %>>
          <% if (e.domain) { %><p class="field-error" role="alert"><%= __(e.domain) %></p><% } %>
          <p class="field-hint"><%= __("اكتب اسم الدومين فقط، مثل:") %> <bdi dir="ltr">myoffice.sa</bdi></p>
        </div>
        <button type="submit" class="btn btn--primary"><%= __("متابعة") %></button>
      </form>
    <% } else { %>
      <p class="muted"><%= __("طلب النطاق الخاص متاح لمالك المكتب فقط.") %></p>
    <% } %>
  <% } %>
</section>

<p class="back-link"><a href="/office/contracts/<%= contract.id %>">→ رجوع للعقد</a></p>
<section class="card form-card">
  <h1>تجديد العقد</h1>
  <p class="lead">ينشئ التجديد عقداً جديداً للمدة التالية بنفس الطول، ويبقى العقد الحالي في السجل.</p>
  <% if (errors.form) { %><div class="flash flash--danger" role="alert"><%= errors.form %> <% if (/باقتك/.test(errors.form)) { %><a href="/office/billing">الاشتراك والباقات</a><% } %></div><% } %>
  <dl class="details">
    <dt>بداية المدة الجديدة</dt><dd dir="ltr"><%= defaults.start_date %></dd>
    <dt>نهاية المدة الجديدة</dt><dd dir="ltr"><%= defaults.end_date %></dd>
    <dt>الإيجار الحالي</dt><dd><%= Number(contract.annual_rent).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> ريال</dd>
  </dl>
  <% if (defaults.rentPolicy.reason === 'riyadh_freeze') { %>
    <p class="flash flash--warning">الإيجار مجمّد في الرياض حتى <span dir="ltr"><%= defaults.rentPolicy.freezeUntil %></span>: لا يمكن رفعه في هذا التجديد، ويمكن تخفيضه أو إبقاؤه كما هو.</p>
  <% } %>
  <form method="post" action="/office/contracts/<%= contract.id %>/renew" novalidate>
    <div class="field">
      <label for="annual_rent">الإيجار السنوي الجديد (ريال)</label>
      <input id="annual_rent" name="annual_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= values.annual_rent %>" <%- errors.annual_rent ? 'aria-invalid="true"' : '' %>>
      <% if (errors.annual_rent) { %><p class="field-error"><%= errors.annual_rent %></p><% } %>
    </div>
    <div class="field">
      <label for="payment_frequency">طريقة الدفع</label>
      <select id="payment_frequency" name="payment_frequency" class="select">
        <% Object.entries(frequencies).forEach(function ([key, label]) { %><option value="<%= key %>" <%= values.payment_frequency === key ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
      <% if (errors.payment_frequency) { %><p class="field-error"><%= errors.payment_frequency %></p><% } %>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large">إنشاء عقد التجديد</button>
  </form>
</section>

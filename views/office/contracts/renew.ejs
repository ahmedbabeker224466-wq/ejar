<p class="back-link"><a href="/office/contracts/<%= __(contract.id) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع للعقد") %></a></p>
<section class="card form-card">
  <h1><%= __("تجديد العقد") %></h1>
  <p class="lead"><%= __("ينشئ التجديد عقداً جديداً للمدة التالية بنفس الطول، ويبقى العقد الحالي في السجل.") %></p>
  <% if (errors.form) { %><div class="flash flash--danger" role="alert"><%= __(errors.form) %> <% if (/باقتك/.test(errors.form)) { %><a href="/office/billing"><%= __("الاشتراك والباقات") %></a><% } %></div><% } %>
  <dl class="details">
    <dt><%= __("بداية المدة الجديدة") %></dt><dd dir="ltr"><%= __(defaults.start_date) %></dd>
    <dt><%= __("نهاية المدة الجديدة") %></dt><dd dir="ltr"><%= __(defaults.end_date) %></dd>
    <dt><%= __("الإيجار الحالي") %></dt><dd><%= __(Number(contract.annual_rent).toLocaleString('en-US', { minimumFractionDigits: 2 })) %> <%= __("ريال") %></dd>
  </dl>
  <% if (defaults.rentPolicy.reason === 'riyadh_freeze') { %>
    <p class="flash flash--warning"><%= __("الإيجار مجمّد في الرياض حتى") %> <span dir="ltr"><%= __(defaults.rentPolicy.freezeUntil) %></span>: <%= __("لا يمكن رفعه في هذا التجديد، ويمكن تخفيضه أو إبقاؤه كما هو.") %></p>
  <% } %>
  <form method="post" action="/office/contracts/<%= __(contract.id) %>/renew" novalidate>
    <div class="field">
      <label for="annual_rent"><%= __("الإيجار السنوي الجديد (ريال)") %></label>
      <input id="annual_rent" name="annual_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.annual_rent) %>" <%- errors.annual_rent ? 'aria-invalid="true"' : '' %>>
      <% if (errors.annual_rent) { %><p class="field-error"><%= __(errors.annual_rent) %></p><% } %>
    </div>
    <div class="field">
      <label for="payment_frequency"><%= __("طريقة الدفع") %></label>
      <select id="payment_frequency" name="payment_frequency" class="select">
        <% Object.entries(frequencies).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(values.payment_frequency === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
      </select>
      <% if (errors.payment_frequency) { %><p class="field-error"><%= __(errors.payment_frequency) %></p><% } %>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("إنشاء عقد التجديد") %></button>
  </form>
</section>

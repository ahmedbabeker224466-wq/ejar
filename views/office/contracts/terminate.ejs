<p class="back-link"><a href="/office/contracts/<%= __(contract.id) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع للعقد") %></a></p>
<section class="card form-card">
  <h1><%= __("إنهاء العقد") %></h1>
  <p class="lead"><%= __("عند الإنهاء: تتوقف الدفعات القادمة، ويُلغى رمز دعوة المستأجر، وتعود الوحدة شاغرة إذا لم يكن عليها عقد آخر. لا يمكن التراجع عن الإنهاء.") %></p>
  <form method="post" action="/office/contracts/<%= __(contract.id) %>/terminate" novalidate>
    <div class="field">
      <label for="reason"><%= __("سبب الإنهاء") %></label>
      <textarea id="reason" name="reason" class="textarea" maxlength="255" required aria-describedby="reason-hint" <%- errors.reason ? 'aria-invalid="true"' : '' %>><%= __(values.reason) %></textarea>
      <p id="reason-hint" class="field-hint"><%= __("لا تكتب أسماء أو أرقام هوية") %></p>
      <% if (errors.reason) { %><p class="field-error"><%= __(errors.reason) %></p><% } %>
    </div>
    <label class="check"><input type="checkbox" name="confirm" value="1" <%- errors.confirm ? 'aria-invalid="true"' : '' %>><span><%= __("أؤكد إنهاء هذا العقد") %></span></label>
    <% if (errors.confirm) { %><p class="field-error"><%= __(errors.confirm) %></p><% } %>
    <button type="submit" class="btn btn--danger btn--block btn--large"><%= __("إنهاء العقد") %></button>
  </form>
</section>

<p class="back-link"><a href="/office/contracts/<%= __(contract.id) %>"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع للعقد") %></a></p>
<section class="card form-card">
  <h1><%= __("تعديل العقد") %></h1>
  <p class="flash flash--info"><%= __("لا يمكن تغيير التواريخ أو الإيجار أو الوحدة أو المالك بعد الحفظ، حتى تبقى المواعيد وجدول الدفعات صحيحة. لتغييرها أنهِ هذا العقد وأضف عقداً جديداً.") %></p>
  <% if (Object.keys(errors).length) { %><div class="flash flash--danger" role="alert"><%= __("راجع الحقول المظللة بالأحمر.") %></div><% } %>
  <form method="post" action="/office/contracts/<%= __(contract.id) %>/edit" novalidate>
    <div class="field">
      <label for="tenant_label"><%= __("اسم مختصر للمستأجر") %></label>
      <input id="tenant_label" name="tenant_label" class="input" type="text" maxlength="120" value="<%= __(values.tenant_label) %>" <%- errors.tenant_label ? 'aria-invalid="true"' : '' %>>
      <p class="field-hint"><%= __("اسم للتعريف فقط. لا تكتب الاسم الكامل أو رقم الهوية أو الحساب البنكي.") %></p>
      <% if (errors.tenant_label) { %><p class="field-error"><%= __(errors.tenant_label) %></p><% } %>
    </div>
    <div class="field">
      <label for="contract_number"><%= __("رقم العقد في إيجار") %></label>
      <input id="contract_number" name="contract_number" class="input" type="text" dir="ltr" maxlength="40" value="<%= __(values.contract_number) %>" <%- errors.contract_number ? 'aria-invalid="true"' : '' %>>
      <% if (errors.contract_number) { %><p class="field-error"><%= __(errors.contract_number) %></p><% } %>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="deposit"><%= __("التأمين (ريال)") %></label>
        <input id="deposit" name="deposit" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.deposit) %>" <%- errors.deposit ? 'aria-invalid="true"' : '' %>>
        <% if (errors.deposit) { %><p class="field-error"><%= __(errors.deposit) %></p><% } %>
      </div>
      <div class="field">
        <label for="commission"><%= __("العمولة (ريال)") %></label>
        <input id="commission" name="commission" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.commission) %>" <%- errors.commission ? 'aria-invalid="true"' : '' %>>
        <% if (errors.commission) { %><p class="field-error"><%= __(errors.commission) %></p><% } %>
      </div>
    </div>
    <label class="check"><input type="checkbox" name="auto_renew" value="1" <%= __(values.auto_renew ? 'checked' : '') %>><span><%= __("يتجدد تلقائياً") %></span></label>
    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("حفظ") %></button>
  </form>
</section>

<% if (list.rows.length) { %>
  <ul class="action-list">
    <% list.rows.forEach(function (c) { %>
      <li>
        <a href="/office/contracts/<%= __(c.id) %>">
          <span><%= __(c.unit_label || __('وحدة')) %><%= __(c.tenant_label ? ` · ${c.tenant_label}` : '') %> · <span dir="ltr"><%= __(c.start_date) %></span> <%= __("إلى") %> <span dir="ltr"><%= __(c.end_date) %></span></span>
          <span class="badge badge--stage-<%= __(c.status) %>"><%= __(stageLabels[c.status]) %></span>
        </a>
      </li>
    <% }) %>
  </ul>
  <% if (list.total > list.rows.length) { %><p><a href="<%= __(more) %>" class="btn btn--secondary btn--small"><%= __("عرض كل العقود") %></a></p><% } %>
<% } else { %>
  <p class="muted"><%= __("لا توجد عقود بعد.") %></p>
<% } %>

<p class="back-link"><a href="/office/contracts"><%= dir === 'rtl' ? '→' : '←' %> <%= __("كل العقود") %></a></p>
<% const isAi = (name) => aiFields.includes(name); %>
<section class="card form-card form-card--wide">
  <div class="page-head">
    <h1><%= __("إضافة عقد") %></h1>
    <% if (can('contracts.ai')) { %><a href="/office/contracts/new/ai" class="btn btn--secondary"><%= __("قراءة من ملف") %></a><% } %>
  </div>
  <p class="muted"><%= __("أدخل بيانات العقد كما في منصة إيجار. هذا التطبيق خاص ولا يتصل بمنصة إيجار.") %></p>
  <% if (fromAi) { %>
    <div class="flash flash--warning" role="status"><%= __("تمت القراءة بالذكاء الاصطناعي، راجع كل رقم قبل الحفظ") %></div>
    <p class="muted"><%= __("اختر المالك والوحدة واكتب اسماً مختصراً للمستأجر بنفسك. الحقول المقروءة آلياً عليها علامة") %> "<%= __("مقروء آلياً") %>".</p>
  <% } %>

  <% if (limit) { %>
    <div class="flash flash--danger" role="alert"><%= __(limit) %> <a href="/office/billing"><%= __("الاشتراك والباقات") %></a></div>
  <% } else if (Object.keys(errors).length) { %>
    <div class="flash flash--danger" role="alert">
      <% const general = Object.entries(errors).filter(([k]) => !['landlord_id','unit_id','contract_number','tenant_label','start_date','end_date','annual_rent','payment_frequency','deposit','commission','city','ack_warnings'].includes(k)); %>
      <%= __(general.length ? general.map(([, m]) => m).join(' ') : __('راجع الحقول المظللة بالأحمر.')) %>
    </div>
  <% } %>

  <form method="post" action="/office/contracts" novalidate id="contract-form">
    <% if (fromAi) { %><input type="hidden" name="source" value="ai"><% } %>
    <fieldset class="form-group">
      <legend><%= __("المالك والوحدة") %></legend>
      <div class="field">
        <label for="landlord_id"><%= __("المالك") %></label>
        <select id="landlord_id" name="landlord_id" class="select" required data-landlord-select <%- errors.landlord_id ? 'aria-invalid="true"' : '' %>>
          <option value=""><%= __("اختر المالك") %></option>
          <% landlords.forEach(function (l) { %><option value="<%= __(l.id) %>" <%= __(values.landlord_id === l.id ? 'selected' : '') %>><%= __(l.label) %></option><% }) %>
        </select>
        <% if (errors.landlord_id) { %><p class="field-error"><%= __(errors.landlord_id) %></p><% } %>
      </div>
      <div class="field">
        <label for="unit_id"><%= __("الوحدة (الشاغرة فقط)") %></label>
        <select id="unit_id" name="unit_id" class="select" required data-building-select <%- errors.unit_id ? 'aria-invalid="true"' : '' %>>
          <option value=""><%= __("اختر الوحدة") %></option>
          <% landlords.forEach(function (l) { const mine = units.filter((u) => u.landlord_id === l.id); if (!mine.length) return; %>
            <optgroup label="<%= __(l.label) %>">
              <% mine.forEach(function (u) { %><option value="<%= __(u.id) %>" data-landlord="<%= __(u.landlord_id) %>" data-city="<%= __(u.city) %>" <%= __(values.unit_id === u.id ? 'selected' : '') %>><%= __(u.label) %></option><% }) %>
            </optgroup>
          <% }) %>
        </select>
        <% if (errors.unit_id) { %><p class="field-error"><%= __(errors.unit_id) %></p><% } %>
        <% if (!units.length) { %><p class="field-hint"><%= __("لا توجد وحدات شاغرة.") %> <a href="/office/units/new"><%= __("أضف وحدة") %></a>.</p><% } %>
      </div>
      <div class="field">
        <label for="tenant_label"><%= __("اسم مختصر للمستأجر") %> <span class="muted">(<%= __("اختياري)") %></span></label>
        <input id="tenant_label" name="tenant_label" class="input" type="text" maxlength="120" value="<%= __(values.tenant_label) %>" aria-describedby="tenant-hint" <%- errors.tenant_label ? 'aria-invalid="true"' : '' %>>
        <p id="tenant-hint" class="field-hint"><%= __("اسم للتعريف فقط، مثل") %> "<%= __("مستأجر شقة 3") %>". <%= __("لا تكتب الاسم الكامل أو رقم الهوية أو الحساب البنكي.") %></p>
        <% if (errors.tenant_label) { %><p class="field-error"><%= __(errors.tenant_label) %></p><% } %>
      </div>
      <div class="field">
        <label for="contract_number"><%= __("رقم العقد في إيجار") %> <span class="muted">(<%= __("اختياري)") %></span><% if (isAi('contract_number')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
        <input id="contract_number" name="contract_number" class="input" type="text" dir="ltr" maxlength="40" value="<%= __(values.contract_number) %>" <%- errors.contract_number ? 'aria-invalid="true"' : '' %>>
        <% if (errors.contract_number) { %><p class="field-error"><%= __(errors.contract_number) %></p><% } %>
      </div>
    </fieldset>

    <fieldset class="form-group">
      <legend><%= __("مدة العقد") %></legend>
      <div class="form-grid">
        <div class="field">
          <label for="start_date"><%= __("تاريخ البداية (ميلادي)") %><% if (isAi('start_date')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
          <input id="start_date" name="start_date" class="input" type="date" required value="<%= __(values.start_date) %>" data-preview-input <%- errors.start_date ? 'aria-invalid="true"' : '' %>>
          <% if (errors.start_date) { %><p class="field-error"><%= __(errors.start_date) %></p><% } %>
        </div>
        <div class="field">
          <label for="end_date"><%= __("تاريخ النهاية (ميلادي)") %><% if (isAi('end_date')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
          <input id="end_date" name="end_date" class="input" type="date" required value="<%= __(values.end_date) %>" data-preview-input <%- errors.end_date ? 'aria-invalid="true"' : '' %>>
          <% if (errors.end_date) { %><p class="field-error"><%= __(errors.end_date) %></p><% } %>
        </div>
      </div>
    </fieldset>

    <fieldset class="form-group">
      <legend><%= __("المبالغ") %></legend>
      <div class="field">
        <label for="annual_rent"><%= __("الإيجار السنوي (ريال)") %><% if (isAi('annual_rent')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
        <input id="annual_rent" name="annual_rent" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" required value="<%= __(values.annual_rent) %>" data-preview-input <%- errors.annual_rent ? 'aria-invalid="true"' : '' %>>
        <% if (errors.annual_rent) { %><p class="field-error"><%= __(errors.annual_rent) %></p><% } %>
      </div>
      <div class="field">
        <label for="payment_frequency"><%= __("طريقة الدفع") %><% if (isAi('payment_frequency')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
        <select id="payment_frequency" name="payment_frequency" class="select" data-preview-input <%- errors.payment_frequency ? 'aria-invalid="true"' : '' %>>
          <% Object.entries(frequencies).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(values.payment_frequency === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
        </select>
        <% if (errors.payment_frequency) { %><p class="field-error"><%= __(errors.payment_frequency) %></p><% } %>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="deposit"><%= __("التأمين") %> <span class="muted">(<%= __("اختياري)") %></span></label>
          <input id="deposit" name="deposit" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.deposit) %>" data-preview-input <%- errors.deposit ? 'aria-invalid="true"' : '' %>>
          <% if (errors.deposit) { %><p class="field-error"><%= __(errors.deposit) %></p><% } %>
        </div>
        <div class="field">
          <label for="commission"><%= __("العمولة") %> <span class="muted">(<%= __("اختياري)") %></span></label>
          <input id="commission" name="commission" class="input" type="text" inputmode="decimal" dir="ltr" maxlength="20" value="<%= __(values.commission) %>" <%- errors.commission ? 'aria-invalid="true"' : '' %>>
          <% if (errors.commission) { %><p class="field-error"><%= __(errors.commission) %></p><% } %>
        </div>
      </div>
      <div class="field">
        <label for="city"><%= __("المدينة") %><% if (isAi('city')) { %> <span class="badge badge--ai"><%= __("مقروء آلياً") %></span><% } %></label>
        <select id="city" name="city" class="select" data-city-select data-preview-input <%- errors.city ? 'aria-invalid="true"' : '' %>>
          <option value=""><%= __("مدينة الوحدة") %></option>
          <% cities.forEach(function (city) { %><option value="<%= __(city) %>" <%= __(values.city === city ? 'selected' : '') %>><%= __(city) %></option><% }) %>
        </select>
        <% if (errors.city) { %><p class="field-error"><%= __(errors.city) %></p><% } %>
      </div>
      <label class="check">
        <input type="checkbox" name="auto_renew" value="1" <%= __(values.auto_renew ? 'checked' : '') %>>
        <span><%= __("يتجدد تلقائياً إذا لم يُرسل إشعار عدم التجديد") %></span>
      </label>
    </fieldset>

    <%- include('_preview') %>

    <label class="check ack" id="ack-box" <%- needsAck ? '' : 'hidden' %>>
      <input type="checkbox" name="ack_warnings" value="1" <%= __(values.ack_warnings ? 'checked' : '') %> <%- errors.ack_warnings ? 'aria-invalid="true"' : '' %>>
      <span><%= __("راجعت التنبيهات وأريد المتابعة") %></span>
    </label>
    <% if (errors.ack_warnings) { %><p class="field-error"><%= __(errors.ack_warnings) %></p><% } %>

    <div class="button-row">
      <button type="submit" class="btn btn--primary btn--large"><%= __("حفظ العقد") %></button>
      <button type="submit" name="intent" value="preview" class="btn btn--secondary" data-preview-button><%= __("معاينة المواعيد") %></button>
    </div>
      </form>
</section>
<script src="<%= assetUrl('/js/unitForm.js') %>" defer></script>
<script src="<%= assetUrl('/js/contractForm.js') %>" defer></script>

<%# The preview panel. Rendered by the server after a submit, and refilled by
    contractForm.js from POST /office/contracts/preview. Same markup both ways. %>
<section class="card preview" id="contract-preview" aria-live="polite" <%- preview ? '' : 'hidden' %>>
  <h2><%= __("ملخص العقد") %></h2>
  <dl class="details">
    <dt><%= __("المدة") %></dt><dd data-preview="termMonths"><%= __(preview ? `${preview.termMonths} شهراً` : '') %></dd>
    <dt><%= __("البداية (هجري تقريبي)") %></dt><dd class="nowrap" data-preview="startHijri"><%= __(preview ? preview.startHijri : '') %></dd>
    <dt><%= __("النهاية (هجري تقريبي)") %></dt><dd class="nowrap" data-preview="endHijri"><%= __(preview ? preview.endHijri : '') %></dd>
    <dt><%= __("آخر موعد لإشعار عدم التجديد") %></dt><dd><span dir="ltr" data-preview="noticeDeadline"><%= __(preview ? preview.noticeDeadline : '') %></span></dd>
    <dt><%= __("آخر موعد لطلب تغيير الإيجار") %></dt><dd><span dir="ltr" data-preview="rentChangeDeadline"><%= __(preview ? preview.rentChangeDeadline : '') %></span></dd>
    <dt><%= __("المرحلة الآن") %></dt><dd data-preview="stageLabel"><%= __(preview ? preview.stageLabel : '') %></dd>
  </dl>
  <p class="flash flash--warning" data-preview="freeze" <%- preview && preview.rentPolicy.reason === 'riyadh_freeze' ? '' : 'hidden' %>>
    <%= __("الإيجار مجمّد في الرياض حتى") %> <span dir="ltr" data-preview="freezeUntil"><%= __(preview && preview.rentPolicy.freezeUntil ? preview.rentPolicy.freezeUntil : '') %></span>: <%= __("عند التجديد لا يمكن رفع الإيجار، ويمكن فقط طلب تخفيضه.") %>
  </p>
  <h3><%= __("أول الدفعات") %></h3>
  <ul class="schedule" data-preview="schedule">
    <% if (preview) { preview.schedule.forEach(function (p) { %>
      <li><span dir="ltr"><%= __(p.due_date) %></span><strong><%= __(p.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })) %> <%= __("ريال") %></strong></li>
    <% }) } %>
  </ul>
  <p class="muted" data-preview="scheduleSummary"><%= __(preview ? `${preview.scheduleCount} دفعة، المجموع ${Number(preview.scheduleTotal).toLocaleString('en-US', { minimumFractionDigits: 2 })} ريال` : '') %></p>
</section>

<div class="flash flash--warning" id="contract-warnings" <%- warnings.length ? '' : 'hidden' %>>
  <strong><%= __("تنبيهات للمراجعة:") %></strong>
  <ul data-preview="warnings">
    <% warnings.forEach(function (w) { %><li><%= __(w.message_ar) %></li><% }) %>
  </ul>
</div>

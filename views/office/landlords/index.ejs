<div class="page-head">
  <h1>الملّاك</h1>
  <a href="/office/landlords/new" class="btn btn--primary">إضافة مالك</a>
</div>

<% if (message) { %><div class="flash flash--success" role="status"><%= message %></div><% } %>

<% if (total === 0 && !filtered) { %>
  <section class="card empty-card">
    <h2>لا يوجد ملاك بعد</h2>
    <p class="lead">أضف ملاك العقارات الذين يتعامل معهم مكتبك، ثم أرسل لكل مالك رمز دعوة ليتابع عقاراته.</p>
    <a href="/office/landlords/new" class="btn btn--primary btn--large btn--block">إضافة مالك</a>
  </section>
<% } else { %>
  <form class="card filter-bar" method="get" action="/office/landlords" role="search">
    <div class="field">
      <label for="q">بحث بالاسم أو الجوال</label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= q %>">
    </div>
    <div class="field">
      <label for="status">الحالة</label>
      <select id="status" name="status" class="select">
        <option value="">الكل</option>
        <% Object.entries(statusLabels).forEach(function ([key, label]) { %>
          <option value="<%= key %>" <%= status === key ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--secondary btn--block">عرض</button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead">لا توجد نتائج تطابق البحث.</p>
      <a href="/office/landlords" class="btn btn--secondary">عرض كل الملاك</a>
    </section>
  <% } else { %>
    <p class="muted"><%= total %> مالك</p>
    <ul class="item-list">
      <% rows.forEach(function (row) { %>
        <li class="card item<%= row.is_active ? '' : ' item--inactive' %>">
          <a class="item__title" href="/office/landlords/<%= row.id %>"><%= row.label %></a>
          <div class="item__badges">
            <span class="badge badge--link-<%= row.status %>"><%= row.statusLabel %></span>
            <% if (!row.is_active) { %><span class="badge badge--ended">موقوف</span><% } %>
          </div>
          <p class="item__meta">
            <% if (row.city) { %><span><%= row.city %></span><% } %>
            <% if (row.phoneLocal) { %><span dir="ltr"><%= row.phoneLocal %></span><% } %>
            <span><%= row.units_count %> وحدة</span>
          </p>
        </li>
      <% }) %>
    </ul>

    <% if (pages > 1) { %>
      <nav class="pager" aria-label="الصفحات">
        <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= prevUrl %>">السابق</a><% } else { %><span></span><% } %>
        <span>صفحة <%= page %> من <%= pages %></span>
        <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= nextUrl %>">التالي</a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } %>
<% } %>

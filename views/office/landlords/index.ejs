<div class="page-head">
  <h1><%= __("الملّاك") %></h1>
  <a href="/office/landlords/new" class="btn btn--primary"><%= __("إضافة مالك") %></a>
</div>

<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<% if (total === 0 && !filtered) { %>
  <section class="card empty-card">
    <h2><%= __("لا يوجد ملاك بعد") %></h2>
    <p class="lead"><%= __("أضف ملاك العقارات الذين يتعامل معهم مكتبك، ثم أرسل لكل مالك رمز دعوة ليتابع عقاراته.") %></p>
    <a href="/office/landlords/new" class="btn btn--primary btn--large btn--block"><%= __("إضافة مالك") %></a>
  </section>
<% } else { %>
  <form class="card filter-bar" method="get" action="/office/landlords" role="search">
    <div class="field">
      <label for="q"><%= __("بحث بالاسم أو الجوال") %></label>
      <input id="q" name="q" class="input" type="search" maxlength="60" value="<%= __(q) %>">
    </div>
    <div class="field">
      <label for="status"><%= __("الحالة") %></label>
      <select id="status" name="status" class="select">
        <option value=""><%= __("الكل") %></option>
        <% Object.entries(statusLabels).forEach(function ([key, label]) { %>
          <option value="<%= __(key) %>" <%= __(status === key ? 'selected' : '') %>><%= __(label) %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
  </form>

  <% if (rows.length === 0) { %>
    <section class="card empty-card">
      <p class="lead"><%= __("لا توجد نتائج تطابق البحث.") %></p>
      <a href="/office/landlords" class="btn btn--secondary"><%= __("عرض كل الملاك") %></a>
    </section>
  <% } else { %>
    <p class="muted"><%= countOf(total, 'مالك', lang) %></p>
    <ul class="item-list">
      <% rows.forEach(function (row) { %>
        <li class="card item<%= __(row.is_active ? '' : ' item--inactive') %>">
          <a class="item__title" href="/office/landlords/<%= __(row.id) %>"><%= __(row.label) %></a>
          <div class="item__badges">
            <span class="badge badge--link-<%= __(row.status) %>"><%= __(row.statusLabel) %></span>
            <% if (!row.is_active) { %><span class="badge badge--ended"><%= __("موقوف") %></span><% } %>
          </div>
          <p class="item__meta">
            <% if (row.city) { %><span><%= __(row.city) %></span><% } %>
            <% if (row.phoneLocal) { %><span dir="ltr"><%= __(row.phoneLocal) %></span><% } %>
            <span><%= countOf(row.units_count, 'وحدة', lang) %></span>
          </p>
        </li>
      <% }) %>
    </ul>

    <% if (pages > 1) { %>
      <nav class="pager" aria-label="<%= __("الصفحات") %>">
        <% if (prevUrl) { %><a class="btn btn--secondary" href="<%= __(prevUrl) %>"><%= __("السابق") %></a><% } else { %><span></span><% } %>
        <span><%= __("صفحة") %> <%= __(page) %> <%= __("من") %> <%= __(pages) %></span>
        <% if (nextUrl) { %><a class="btn btn--secondary" href="<%= __(nextUrl) %>"><%= __("التالي") %></a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } %>
<% } %>

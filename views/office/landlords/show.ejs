<p class="back-link"><a href="/office/landlords"><%= dir === 'rtl' ? '→' : '←' %> <%= __("كل الملاك") %></a></p>

<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card detail-card">
  <div class="page-head">
    <h1><%= __(landlord.label) %></h1>
    <div class="item__badges">
      <span class="badge badge--link-<%= __(landlord.status) %>"><%= __(statusLabel) %></span>
      <% if (!landlord.is_active) { %><span class="badge badge--ended"><%= __("موقوف") %></span><% } %>
    </div>
  </div>
  <dl class="details">
    <dt><%= __("المدينة") %></dt><dd><%= __(landlord.city || '—') %></dd>
    <dt><%= __("الجوال") %></dt><dd dir="ltr"><%= __(landlord.phoneLocal || '—') %></dd>
    <dt><%= __("الوحدات") %></dt><dd><%= __(landlord.units_count) %></dd>
    <% if (landlord.notes) { %><dt><%= __("ملاحظات") %></dt><dd class="pre-line"><%= __(landlord.notes) %></dd><% } %>
  </dl>
  <div class="button-row">
    <a href="/office/landlords/<%= __(landlord.id) %>/edit" class="btn btn--secondary"><%= __("تعديل") %></a>
    <% if (landlord.is_active) { %>
      <form method="post" action="/office/landlords/<%= __(landlord.id) %>/deactivate">
        <button type="submit" class="btn btn--secondary"><%= __("إيقاف المالك") %></button>
      </form>
    <% } else { %>
      <form method="post" action="/office/landlords/<%= __(landlord.id) %>/activate">
        <button type="submit" class="btn btn--secondary"><%= __("إعادة التفعيل") %></button>
      </form>
    <% } %>
  </div>
  <% if (canDelete) { %>
    <details class="danger-zone">
      <summary><%= __("حذف المالك") %></summary>
      <p><%= __("الحذف نهائي ولا يمكن التراجع عنه. إن أردت إخفاءه فقط فاستخدم") %> "<%= __("إيقاف المالك") %>".</p>
      <form method="post" action="/office/landlords/<%= __(landlord.id) %>/delete">
        <button type="submit" class="btn btn--danger btn--block"><%= __("نعم، احذف المالك نهائياً") %></button>
      </form>
    </details>
  <% } %>
</section>

<section class="card detail-card" id="invite">
  <h2><%= __("رمز الدعوة") %></h2>
  <% if (landlord.user_id) { %>
    <p class="lead"><%= __("انضم المالك إلى التطبيق، ولا يحتاج إلى رمز دعوة.") %></p>
  <% } else { %>
    <% if (invite && invite.code) { %>
      <p class="muted"><%= __("أرسل هذا الرمز للمالك ليدخل به إلى التطبيق. يُستخدم مرة واحدة فقط.") %></p>
      <div class="invite-code">
        <output id="invite-code" dir="ltr"><%= __(invite.code) %></output>
        <button type="button" class="btn btn--secondary" data-copy="#invite-code" data-copied="<%= __("تم النسخ") %>"><%= __("نسخ الرمز") %></button>
      </div>
      <p class="muted"><%= __("الحالة:") %> <span class="badge badge--calm"><%= __(invite.label) %></span> · <%= __("صالح حتى") %> <span dir="ltr"><%= __(invite.expiresOn) %></span></p>
      <div class="button-row">
        <a href="<%= __(invite.shareLink) %>" class="btn btn--primary" target="_blank" rel="noopener noreferrer"><%= __("إرسال عبر واتساب") %></a>
        <form method="post" action="/office/landlords/<%= __(landlord.id) %>/invite/revoke">
          <button type="submit" class="btn btn--secondary"><%= __("إلغاء الرمز") %></button>
        </form>
        <% if (landlord.is_active) { %>
          <form method="post" action="/office/landlords/<%= __(landlord.id) %>/invite">
            <button type="submit" class="btn btn--secondary"><%= __("إنشاء رمز جديد") %></button>
          </form>
        <% } %>
      </div>
    <% } else { %>
      <% if (invite) { %>
        <p><%= __("آخر رمز:") %> <span class="badge badge--ended"><%= __(invite.label) %></span>
          <% if (invite.usedBy) { %> <%= __("بواسطة") %> <span dir="ltr"><%= __(invite.usedBy) %></span><% } %>
        </p>
      <% } else { %>
        <p class="muted"><%= __("لم يُنشأ رمز دعوة لهذا المالك بعد.") %></p>
      <% } %>
      <% if (landlord.is_active) { %>
        <form method="post" action="/office/landlords/<%= __(landlord.id) %>/invite">
          <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("إنشاء رمز دعوة") %></button>
        </form>
      <% } else { %>
        <p class="muted"><%= __("أعد تفعيل المالك لإنشاء رمز دعوة.") %></p>
      <% } %>
    <% } %>
  <% } %>
</section>

<section class="card detail-card" id="units">
  <h2><%= __("الوحدات") %> (<%= __(units.total) %>)</h2>
  <% if (units.rows.length) { %>
    <ul class="action-list">
      <% units.rows.forEach(function (u) { %>
        <li>
          <a href="/office/units/<%= __(u.id) %>">
            <span><%= __(u.label) %><%= __(u.building_name ? ` · ${u.building_name}` : '') %></span>
            <span class="badge badge--unit-<%= __(u.status) %>"><%= __(unitStatusLabels[u.status]) %></span>
          </a>
        </li>
      <% }) %>
    </ul>
    <% if (units.total > units.rows.length) { %>
      <p><a href="/office/units?landlord=<%= __(landlord.id) %>" class="btn btn--secondary btn--small"><%= __("عرض كل الوحدات") %></a></p>
    <% } %>
  <% } else { %>
    <p class="muted"><%= __("لا توجد وحدات لهذا المالك بعد.") %></p>
  <% } %>
  <% if (landlord.is_active) { %>
    <div class="button-row">
      <a href="/office/units/new?landlord=<%= __(landlord.id) %>" class="btn btn--primary"><%= __("إضافة وحدة") %></a>
      <a href="/office/units/bulk?landlord=<%= __(landlord.id) %>" class="btn btn--secondary"><%= __("إضافة عدة وحدات") %></a>
    </div>
  <% } %>
</section>

<section class="card detail-card" id="contracts">
  <h2><%= __("العقود") %> (<%= __(contracts.total) %>)</h2>
  <%- include('../contracts/_mini-list', { list: contracts, stageLabels, more: `/office/contracts?landlord=${landlord.id}` }) %>
</section>

<script src="<%= assetUrl('/js/copy.js') %>" defer></script>

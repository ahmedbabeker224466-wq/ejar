<section class="card form-card">
  <h1><%= __(landlord ? __('تعديل بيانات المالك') : __('إضافة مالك')) %></h1>

  <% if (Object.keys(errors).length) { %>
    <div class="flash flash--danger" role="alert"><%= __("راجع الحقول المظللة بالأحمر.") %></div>
  <% } %>

  <form method="post" action="<%= __(landlord ? `/office/landlords/${landlord.id}` : '/office/landlords') %>" novalidate>
    <div class="field">
      <label for="label"><%= __("اسم المالك المختصر") %></label>
      <input id="label" name="label" class="input" type="text" maxlength="120" required value="<%= __(values.label) %>"
             aria-describedby="label-hint<%= __(errors.label ? ' label-error' : '') %>" <%- errors.label ? 'aria-invalid="true"' : '' %>>
      <p id="label-hint" class="field-hint"><%= __("اكتب اسماً مختصراً للتعريف فقط، لا تكتب الهوية أو الحساب البنكي") %></p>
      <% if (errors.label) { %><p id="label-error" class="field-error"><%= __(errors.label) %></p><% } %>
    </div>

    <div class="field">
      <label for="city"><%= __("المدينة") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <select id="city" name="city" class="select" <%- errors.city ? 'aria-invalid="true"' : '' %>>
        <option value=""><%= __("اختر المدينة") %></option>
        <%- include('../../partials/city-options', { selected: values.city }) %>
      </select>
      <% if (errors.city) { %><p class="field-error"><%= __(errors.city) %></p><% } %>
    </div>

    <div class="field">
      <label for="phone"><%= __("جوال المالك") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <input id="phone" name="phone" class="input" type="tel" inputmode="tel" dir="ltr" maxlength="20" value="<%= __(values.phone) %>"
             <%- errors.phone ? 'aria-invalid="true" aria-describedby="phone-error"' : '' %>>
      <% if (errors.phone) { %><p id="phone-error" class="field-error"><%= __(errors.phone) %></p><% } else { %>
        <p class="field-hint"><%= __("نستخدمه لإرسال رمز الدعوة عبر واتساب. مثال: 0512345678") %></p>
      <% } %>
    </div>

    <div class="field">
      <label for="notes"><%= __("ملاحظات") %> <span class="muted">(<%= __("اختياري)") %></span></label>
      <textarea id="notes" name="notes" class="textarea" maxlength="1000"
                <%- errors.notes ? 'aria-invalid="true" aria-describedby="notes-error"' : '' %>><%= __(values.notes) %></textarea>
      <% if (errors.notes) { %><p id="notes-error" class="field-error"><%= __(errors.notes) %></p><% } %>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--large"><%= __("حفظ") %></button>
    <a href="<%= __(landlord ? `/office/landlords/${landlord.id}` : '/office/landlords') %>" class="btn btn--secondary btn--block form-cancel"><%= __("إلغاء") %></a>
  </form>
</section>

<p class="back-link"><a href="/office/billing"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع إلى الاشتراك") %></a></p>
<div class="page-head"><h1><%= __("مراجعة الطلب") %></h1></div>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card detail-card">
  <h2><%= __("باقة") %> <%= __(plan.name_ar) %> (<%= __(intervalLabel) %>)</h2>
  <p><a class="btn btn--secondary btn--small" href="/office/billing/checkout?plan=<%= __(plan.id) %>&amp;interval=<%= __(otherInterval) %>&amp;promo=<%= __(encodeURIComponent(promoCode)) %>"><%= __("التحويل إلى") %> <%= __(otherLabel) %></a></p>

  <form method="get" action="/office/billing/checkout" class="inline-form" novalidate>
    <input type="hidden" name="plan" value="<%= __(plan.id) %>">
    <input type="hidden" name="interval" value="<%= __(interval) %>">
    <div class="field">
      <label for="promo"><%= __("رمز الخصم (اختياري)") %></label>
      <input id="promo" name="promo" class="input" dir="ltr" maxlength="30" value="<%= __(promoCode) %>" autocomplete="off">
    </div>
    <button type="submit" class="btn btn--secondary"><%= __("تطبيق") %></button>
  </form>
  <% if (promoApplied) { %><p class="flash flash--success"><%= __("تم تطبيق رمز الخصم") %> <strong dir="ltr"><%= __(promoCode) %></strong>.</p><% } %>
  <% if (promoError) { %><p class="flash flash--warning"><%= __(promoError) %></p><% } %>

  <dl class="details quote">
    <dt><%= __("سعر الباقة (قبل الضريبة)") %></dt><dd><%= __(fmt(quote.subtotal)) %> <%= __("ريال") %></dd>
    <% if (quote.discount > 0) { %><dt><%= __("الخصم") %></dt><dd>- <%= __(fmt(quote.discount)) %> <%= __("ريال") %></dd>
    <dt><%= __("بعد الخصم") %></dt><dd><%= __(fmt(quote.net)) %> <%= __("ريال") %></dd><% } %>
    <dt><%= __("ضريبة القيمة المضافة") %> (<%= __(vatPercent) %>%)</dt><dd><%= __(fmt(quote.vat)) %> <%= __("ريال") %></dd>
    <dt class="quote__total"><%= __("الإجمالي المطلوب") %></dt><dd class="quote__total"><%= __(fmt(quote.total)) %> <%= __("ريال") %></dd>
  </dl>
</section>

<% if (!downgrade.ok) { %>
  <section class="card detail-card"><p class="flash flash--danger" role="alert"><%= __(downgrade.message) %></p></section>
<% } else { %>
  <section class="card detail-card">
    <h2><%= __("طريقة الدفع") %></h2>
    <% if (!online) { %><p class="flash flash--info"><%= __("الدفع الإلكتروني غير مفعّل.") %></p><% } %>
    <form method="post" action="/office/billing/orders" class="button-row">
      <input type="hidden" name="plan" value="<%= __(plan.id) %>">
      <input type="hidden" name="interval" value="<%= __(interval) %>">
      <input type="hidden" name="promo" value="<%= __(promoApplied ? promoCode : '') %>">
      <% if (online) { %><button type="submit" name="method" value="moyasar" class="btn btn--primary btn--large btn--block"><%= __(quote.total === 0 ? __('تفعيل الباقة') : __('ادفع بالبطاقة')) %></button><% } %>
      <button type="submit" name="method" value="bank_transfer" class="btn btn--secondary btn--large btn--block"><%= __(quote.total === 0 ? __('تفعيل الباقة') : __('الدفع بالحوالة البنكية')) %></button>
    </form>
    <p class="muted"><%= __("لا نحفظ بيانات بطاقتك: تُدخَل في نموذج الدفع الآمن لدى مزوّد الدفع.") %></p>
  </section>
<% } %>

<p class="back-link"><a href="/office/billing"><%= dir === 'rtl' ? '→' : '←' %> <%= __("رجوع إلى الاشتراك") %></a></p>
<div class="page-head"><h1><%= __("الدفع بالحوالة البنكية") %></h1></div>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>
<section class="card detail-card">
  <p class="lead"><%= __("حوّل المبلغ") %> <strong><%= __(fmt(order.total)) %> <%= __("ريال") %></strong> (<%= __("شامل الضريبة) ثم أرسل لنا مرجع الحوالة. رقم طلبك:") %> <strong><%= __(order.id) %></strong>.</p>
  <% if (bank.iban || bank.name || bank.account_name) { %>
    <dl class="details">
      <% if (bank.name) { %><dt><%= __("البنك") %></dt><dd><%= __(bank.name) %></dd><% } %>
      <% if (bank.account_name) { %><dt><%= __("اسم الحساب") %></dt><dd><%= __(bank.account_name) %></dd><% } %>
      <% if (bank.iban) { %><dt><%= __("الآيبان") %></dt><dd dir="ltr"><%= __(bank.iban) %></dd><% } %>
    </dl>
  <% } else { %>
    <p class="flash flash--warning"><%= __("لم تُضبط بيانات الحساب البنكي بعد. تواصل مع الدعم") %><% if (support.phone || support.email) { %>: <span dir="ltr"><%= __(support.phone) %> <%= __(support.email) %></span><% } %>.</p>
  <% } %>
</section>
<section class="card detail-card">
  <h2><%= __("أرسل مرجع الحوالة") %></h2>
  <form method="post" action="/office/billing/orders/<%= __(order.id) %>/transfer" enctype="multipart/form-data" novalidate>
    <div class="field">
      <label for="reference"><%= __("رمز المرجع") %></label>
      <input id="reference" name="reference" class="input" dir="ltr" maxlength="40" required>
      <p class="field-hint"><%= __("رمز قصير تجده في إشعار البنك. لا تكتب رقم حساب أو آيبان.") %></p>
    </div>
    <div class="field">
      <label for="receipt"><%= __("صورة الإيصال (اختياري)") %></label>
      <input id="receipt" name="receipt" class="input input--file" type="file" accept="image/jpeg,image/png,image/webp">
      <p class="field-hint"><%= __("صورة JPG أو PNG أو WebP حتى 5 ميجابايت.") %></p>
    </div>
    <button type="submit" class="btn btn--primary btn--large btn--block"><%= __("إرسال للمراجعة") %></button>
  </form>
</section>

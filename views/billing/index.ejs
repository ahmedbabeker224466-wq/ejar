<div class="page-head"><h1><%= __("الاشتراك") %></h1></div>
<% if (notice) { %><div class="flash flash--<%= __(notice[0]) %>" role="<%= __(notice[0] === 'danger' ? 'alert' : 'status') %>"><%= __(notice[1]) %></div><% } %>
<% if (error) { %><div class="flash flash--danger" role="alert"><%= __(error) %></div><% } %>

<section class="card detail-card">
  <h2><%= __("باقتك الحالية") %></h2>
  <dl class="details">
    <dt><%= __("الباقة") %></dt><dd><%= __(plan ? plan.name_ar : __('غير محددة')) %></dd>
    <dt><%= __("الحالة") %></dt><dd><span class="badge badge--bill-<%= __(status.tone) %>"><%= __(status.label) %></span></dd>
    <% if (status.until) { %><dt><%= __("صالحة حتى") %></dt><dd dir="ltr"><%= __(status.until) %></dd><% } %>
    <% if (interval && !access.onTrial) { %><dt><%= __("نوع الاشتراك") %></dt><dd><%= __(interval === 'yearly' ? __('سنوي') : __('شهري')) %></dd><% } %>
  </dl>
  <% if (access.readOnly) { %>
    <p class="flash flash--danger"><%= __("انتهى الاشتراك: الحساب في وضع القراءة فقط لمدة") %> <%= __(access.graceDaysLeft) %> <%= __("يوم، ثم يُوقف. بياناتك محفوظة") %> <%= __(keepDays) %> <%= __("يوماً بعد الإيقاف.") %></p>
  <% } else if (access.locked) { %>
    <p class="flash flash--danger"><%= __("الحساب متوقف الآن. بياناتك محفوظة") %> <%= __(keepDays) %> <%= __("يوماً؛ جدّد الاشتراك لإعادة التشغيل.") %></p>
  <% } %>
  <% if (suspendedByAdmin) { %>
    <p class="flash flash--warning"><%= __("حساب المكتب موقوف من إدارة المنصة، ولا يمكن الدفع الآن.") %>
      <% if (support.phone || support.email) { %><%= __("للتواصل:") %> <span dir="ltr"><%= __(support.phone) %> <%= __(support.email) %></span><% } %></p>
  <% } %>
</section>



<% if (!suspendedByAdmin) { %>
<section class="card detail-card bill-plans">
  <div class="bill-plans__head">
    <div>
      <h2><%= __(access.onTrial || access.locked || access.readOnly ? __('اختر باقتك') : __('ترقية أو تجديد')) %></h2>
      <p class="muted"><%= __("الأسعار قبل ضريبة القيمة المضافة") %> (<%= __(vatPercent) %>%)<%= __("، وتظهر كاملة قبل الدفع.") %></p>
    </div>
  </div>
  <% if (!online) { %><p class="flash flash--info"><%= __("الدفع الإلكتروني غير مفعّل. يمكنك الدفع بالحوالة البنكية.") %></p><% } %>
  <input type="radio" name="bill-interval" id="bi-m" class="visually-hidden" checked>
  <input type="radio" name="bill-interval" id="bi-y" class="visually-hidden">
  <div class="bill-toggle" role="group" aria-label="<%= __("مدة الاشتراك") %>">
    <label for="bi-m"><%= __("شهري") %></label>
    <label for="bi-y"><%= __("سنوي") %> <span><%= __("شهران مجاناً") %></span></label>
  </div>
  <ul class="plan-grid bill-grid">
    <% cards.forEach(function (c) { %>
      <li class="bill-card<%= __(c.current ? ' is-current' : '') %><%= __(c.code === 'pro' ? ' is-featured' : '') %>">
        <% if (c.current) { %><span class="bill-card__tag bill-card__tag--current"><%= __("باقتك الحالية") %></span><% } else if (c.code === 'pro') { %><span class="bill-card__tag"><%= __("الأكثر اختياراً") %></span><% } %>
        <h3><%= __(c.name) %></h3>
        <p class="bill-card__price when-m"><strong><%= __(fmt(c.monthly).replace(/\.00$/, '')) %></strong> <span><%= __("ريال شهرياً") %></span></p>
        <% if (c.yearly > 0) { %><p class="bill-card__price when-y"><strong><%= __(fmt(c.yearly).replace(/\.00$/, '')) %></strong> <span><%= __("ريال سنوياً") %></span></p><% } %>
        <%- include('../partials/plan-lines', { s: c.spec }) %>
        <div class="bill-card__cta">
          <a class="btn btn--success btn--block when-m" href="/office/billing/checkout?plan=<%= __(c.id) %>&amp;interval=monthly"><%= __(c.current ? __('تجديد شهري') : __('اشتراك شهري')) %></a>
          <% if (c.yearly > 0) { %><a class="btn btn--success btn--block when-y" href="/office/billing/checkout?plan=<%= __(c.id) %>&amp;interval=yearly"><%= __(c.current ? __('تجديد سنوي') : __('اشتراك سنوي')) %></a><% } %>
        </div>
      </li>
    <% }) %>
  </ul>
  <% if (!cards.length) { %><p class="empty-state"><%= __("لا توجد باقات متاحة للشراء الآن.") %></p><% } %>
</section>
<% } %>

<section class="card detail-card">
  <h2><%= __("الاستخدام") %></h2>
  <ul class="usage-grid">
    <% usage.forEach(function (u) { const pct = u.limit ? Math.min(100, Math.round(u.used / u.limit * 100)) : 0; const tone = pct >= 90 ? 'danger' : pct >= 70 ? 'warn' : 'ok'; %>
      <li class="usage-item">
        <span class="usage-item__label"><%= __(u.label) %></span>
        <% if (u.limit === null) { %>
          <strong class="usage-item__value"><%= __(u.used) %> <span><%= __("بلا حد") %></span></strong>
        <% } else { %>
          <strong class="usage-item__value"><%= __(u.used) %> <span><%= __("من") %> <%= __(u.limit) %></span></strong>
          <span class="usage-bar usage-bar--<%= tone %>" role="meter" aria-valuemin="0" aria-valuemax="<%= __(u.limit) %>" aria-valuenow="<%= __(Math.min(u.used, u.limit)) %>"><span class="pct-<%= Math.round(pct / 5) * 5 %>"></span></span>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>

<% if (transfers.length) { %>
  <section class="card detail-card">
    <h2><%= __("حوالات بنكية مفتوحة") %></h2>
    <ul class="item-list">
      <% transfers.forEach(function (t) { %>
        <li class="item">
          <div class="item__title"><strong><%= __("طلب رقم") %> <%= __(t.id) %></strong> · <%= __(fmt(t.total)) %> <%= __("ريال") %>
            <span class="badge badge--bill-info"><%= __(t.transferStatus === 'pending' ? __('بانتظار المراجعة') : __('بانتظار إرسال المرجع')) %></span></div>
          <% if (!t.transferId) { %><a class="btn btn--primary btn--small" href="/office/billing/orders/<%= __(t.id) %>/transfer"><%= __("إرسال مرجع الحوالة") %></a><% } %>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>


<section class="card detail-card">
  <h2><%= __("الفواتير") %></h2>
  <% if (invoices.length) { %>
    <ul class="item-list">
      <% invoices.forEach(function (i) { %>
        <li class="item">
          <div class="item__title"><a href="/office/billing/invoices/<%= __(i.id) %>"><strong dir="ltr"><%= __(i.invoiceNo) %></strong></a>
            <span class="badge badge--bill-<%= __(i.kind === 'credit_note' ? 'danger' : 'success') %>"><%= __(i.title) %></span>
            <% if (i.status === 'credited') { %><span class="badge badge--ended"><%= __("ملغاة بإشعار") %></span><% } %></div>
          <div class="item__meta"><span dir="ltr"><%= __(i.issuedDay) %></span> · <%= __(fmt(i.total)) %> <%= __("ريال") %></div>
        </li>
      <% }) %>
    </ul>
  <% } else { %><p class="empty-state"><%= __("لا توجد فواتير بعد.") %></p><% } %>
</section>
<p class="muted"><%= __("الاشتراك لا يتجدد تلقائياً: ندعوك للتجديد قبل انتهائه بـ 7 و3 ويوم. بعد الانتهاء يبقى الحساب للقراءة فقط") %> <%= __(graceDays) %> <%= __("أيام ثم يُوقف.") %></p>

<%- include('../partials/area-nav') %>
<h1><%= __("صفحة المستأجر") %></h1>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<% if (!contracts.length) { %>
  <section class="card detail-card">
    <p class="empty-state"><%= __("لا يوجد عقد مرتبط بحسابك الآن. إذا وصلك رمز جديد من المكتب، أدخله من") %> <a href="/join"><%= __("صفحة الانضمام") %></a>.</p>
  </section>
<% } %>

<% contracts.forEach(function (view) { const c = view.contract; const d = view.described; %>
  <section class="card detail-card" id="contract-<%= __(c.id) %>">
    <div class="page-head">
      <h2><%= __(c.unit_label || __('عقد الإيجار')) %></h2>
      <span class="badge badge--stage-<%= __(d.stage) %>"><%= __(stageLabels[d.stage]) %></span>
    </div>
    <p class="muted"><%= __("المكتب:") %> <%= __(view.link.office_name) %></p>

    <% if (d.live) { %>
      <p class="lead"><%= __(d.daysToEnd >= 0 ? `باقي ${d.daysToEnd} يوم على نهاية العقد` : __('انتهى العقد')) %></p>
    <% } %>
    <% if (d.notStarted) { %><p class="muted"><%= __("لم يبدأ العقد بعد.") %></p><% } %>

    <dl class="details">
      <dt><%= __("البداية") %></dt><dd><span dir="ltr"><%= __(c.start_date) %></span> <span class="muted nowrap">(<%= __(d.hijri.start) %> <%= __("تقريبي)") %></span></dd>
      <dt><%= __("النهاية") %></dt><dd><span dir="ltr"><%= __(c.end_date) %></span> <span class="muted nowrap">(<%= __(d.hijri.end) %> <%= __("تقريبي)") %></span></dd>
      <dt><%= __("الإيجار السنوي") %></dt><dd><%= __(Number(c.annual_rent).toLocaleString('en-US', { minimumFractionDigits: 2 })) %> <%= __("ريال") %></dd>
      <dt><%= __("طريقة الدفع") %></dt><dd><%= __(frequencyLabels[c.payment_frequency] || '—') %></dd>
    </dl>

    <% if (d.live) { %>
      <ul class="deadlines">
        <li><span><%= __("آخر موعد لإبلاغ المكتب بقرار التجديد") %></span><strong dir="ltr"><%= __(d.noticeDeadline) %></strong><span class="muted"><%= __(d.daysToNotice >= 0 ? `باقي ${d.daysToNotice} يوم` : `فات منذ ${-d.daysToNotice} يوم`) %></span></li>
      </ul>
      <% if (d.policy.reason === 'riyadh_freeze') { %>
        <p class="flash flash--info"><%= __("الإيجار مجمّد في الرياض حتى") %> <span dir="ltr"><%= __(d.policy.freezeUntil) %></span>: <%= __("لا يمكن رفع إيجارك عند التجديد.") %></p>
      <% } %>
    <% } %>

    <div class="page-head"><h3><%= __("الدفعات") %></h3><a href="/tenant/contracts/<%= __(c.id) %>/receipt" class="btn btn--secondary btn--small"><%= __("كشف الدفعات") %></a></div>
    <% if (view.upcoming.length) { %>
      <ul class="payments">
        <% view.upcoming.forEach(function (p, i) { %>
          <li class="payment">
            <%- include('_payment', { p: p, index: i, paymentLabels: paymentLabels }) %>
            <% if (['due', 'late'].includes(p.status)) { %>
              <form method="post" action="/tenant/contracts/<%= __(c.id) %>/payments/<%= __(p.id) %>/report">
                <button type="submit" class="btn btn--secondary btn--small"><%= __("دفعت هذه الدفعة") %></button>
              </form>
            <% } else if (p.status === 'tenant_reported') { %>
              <p class="muted"><%= __("بانتظار تأكيد المكتب أو المالك.") %></p>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-state"><%= __("لا توجد دفعات مسجلة لهذا العقد.") %></p>
    <% } %>

    <% if (view.reduction.allowed && !view.pendingRequest) { %>
      <details class="payment__edit">
        <summary><%= __("طلب تخفيض الإيجار عند التجديد") %></summary>
        <form method="post" action="/tenant/contracts/<%= __(c.id) %>/requests">
          <input type="hidden" name="request_type" value="rent_reduction">
          <div class="field">
            <label for="note-<%= __(c.id) %>"><%= __("سبب الطلب (اختياري)") %></label>
            <textarea id="note-<%= __(c.id) %>" name="note" class="textarea" rows="3" maxlength="<%= __(noteMax) %>"></textarea>
            <p class="field-hint"><%= __("حتى") %> <%= __(noteMax) %> <%= __("حرف. يصل الطلب للمكتب ليتواصل معك.") %></p>
          </div>
          <button type="submit" class="btn btn--primary btn--block"><%= __("إرسال الطلب") %></button>
        </form>
      </details>
    <% } %>
    <% if (view.requests.length) { %>
      <h3><%= __("طلباتك") %></h3>
      <ul class="item-list">
        <% view.requests.forEach(function (r) { %>
          <li class="item"><%= __(requestTypes[r.request_type]) %> · <span class="badge badge--calm"><%= __(requestStatuses[r.status]) %></span> <span class="muted" dir="ltr"><%= __(r.createdOn) %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% }) %>

<%- include('../partials/area-nav') %>
<h1><%= __("عقاراتك وعقودك") %></h1>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<section class="card detail-card">
  <h2><%= __("يحتاج إجراء") %></h2>
  <% if (actions.length) { %>
    <ul class="board">
      <% actions.forEach(function (a) { %>
        <li class="board__row">
          <div>
            <strong><%= __(a.contract.unit_label || __('وحدة')) %></strong>
            <% if (a.type === 'decision') { %>
              <span class="badge badge--stage-<%= __(a.contract.described.stage) %>"><%= __(stageLabels[a.contract.described.stage]) %></span>
              <p class="muted board__days"><%= __(a.days >= 0 ? `باقي ${a.days} يوم على آخر موعد لقرار التجديد` : `فات موعد قرار التجديد منذ ${-a.days} يوم`) %></p>
            <% } else if (a.type === 'reported') { %>
              <span class="badge badge--pay-tenant_reported"><%= __(paymentLabels.tenant_reported) %></span>
              <p class="muted board__days"><%= __("دفعة") %> <span dir="ltr"><%= __(a.payment.due_date) %></span>: <%= __("أكّد الاستلام أو ارفضه") %></p>
            <% } else { %>
              <span class="badge badge--pay-late"><%= __(paymentLabels.late) %></span>
              <p class="muted board__days"><%= __("دفعة") %> <span dir="ltr"><%= __(a.payment.due_date) %></span> <%= __(`متأخرة منذ ${-a.days} يوم`) %></p>
            <% } %>
            <p class="muted"><%= __("المكتب:") %> <%= __(a.office.office_name) %></p>
          </div>
          <a class="btn btn--secondary btn--small" href="/landlord/contracts/<%= __(a.contract.id) %>"><%= __("فتح العقد") %></a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="empty-state"><%= __("لا يوجد ما يحتاج قراراً منك الآن. سنعرض هنا العقود التي يقترب موعد قرارها والدفعات التي تحتاج تأكيدك.") %></p>
  <% } %>
</section>

<% offices.forEach(function (office) { %>
  <section class="card detail-card">
    <h2><%= __("عقاراتك مع") %> <%= __(office.office_name) %></h2>
    <p class="muted"><%= __("اسمك لدى المكتب:") %> <%= __(office.label) %></p>

    <h3><%= __("العقود السارية") %> (<%= __(office.contracts.length) %>)</h3>
    <% if (office.contracts.length) { %>
      <ul class="item-list">
        <% office.contracts.forEach(function (c) { const d = c.described; %>
          <li class="item">
            <div class="item__title">
              <a href="/landlord/contracts/<%= __(c.id) %>"><%= __(c.unit_label || __('وحدة')) %></a>
              <span class="badge badge--stage-<%= __(d.stage) %>"><%= __(stageLabels[d.stage]) %></span>
            </div>
            <ul class="deadlines">
              <li><span><%= __("نهاية العقد") %></span><strong dir="ltr"><%= __(c.end_date) %></strong><span class="muted"><%= __(d.daysToEnd >= 0 ? `باقي ${d.daysToEnd} يوم` : __('انتهى')) %> · <%= __(d.hijri.end) %> <%= __("تقريبي") %></span></li>
              <li><span><%= __("آخر موعد لقرار التجديد") %></span><strong dir="ltr"><%= __(d.noticeDeadline) %></strong><span class="muted"><%= __(d.daysToNotice >= 0 ? `باقي ${d.daysToNotice} يوم` : `فات منذ ${-d.daysToNotice} يوم`) %></span></li>
              <li><span><%= __("آخر موعد لطلب تغيير الإيجار") %></span><strong dir="ltr"><%= __(d.rentChangeDeadline) %></strong><span class="muted"><%= __(d.daysToRentChange >= 0 ? `باقي ${d.daysToRentChange} يوم` : `فات منذ ${-d.daysToRentChange} يوم`) %></span></li>
            </ul>
            <% if (d.policy.reason === 'riyadh_freeze') { %>
              <p class="flash flash--warning"><%= __("الإيجار مجمّد في الرياض حتى") %> <span dir="ltr"><%= __(d.policy.freezeUntil) %></span>: <%= __("لا يمكن رفع الإيجار عند التجديد.") %></p>
            <% } %>
            <p class="item__meta">
              <%= __("الدفعات:") %> <%= __(c.payments.counts.paid) %> <%= __("مدفوعة") %> · <%= __(c.payments.counts.due) %> <%= __("مستحقة") %> · <%= __(c.payments.counts.late) %> <%= __("متأخرة") %><% if (c.payments.counts.tenant_reported) { %> · <%= __(c.payments.counts.tenant_reported) %> <%= __("بانتظار تأكيدك") %><% } %>
            </p>
            <p class="item__meta"><%= __("قرارك:") %> <%= __(c.decision ? decisionLabels[c.decision.decision] : __('لم تسجل قراراً بعد')) %></p>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-state"><%= __("لا توجد عقود سارية الآن.") %></p>
    <% } %>

    <h3><%= __("الوحدات") %> (<%= __(office.units.length) %>)</h3>
    <% if (office.units.length) { %>
      <ul class="item-list">
        <% office.units.forEach(function (u) { %>
          <li class="item">
            <div class="item__title"><%= __(u.label) %> <span class="badge badge--unit-<%= __(u.status) %>"><%= __(unitStatusLabels[u.status]) %></span></div>
            <p class="item__meta"><%= __(u.building_name ? `${u.building_name} · ` : '') %><%= __(u.city) %></p>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-state"><%= __("لم يضف المكتب وحدات باسمك بعد.") %></p>
    <% } %>
  </section>
<% }) %>

<p class="muted"><%= __("هذه الصفحة للاطلاع فقط. لأي تعديل تواصل مع المكتب.") %></p>

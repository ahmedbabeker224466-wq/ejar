<%- include('../partials/area-nav') %>
<p class="back-link"><a href="/landlord"><%= dir === 'rtl' ? '→' : '←' %> <%= __("صفحة المالك") %></a></p>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<section class="card detail-card">
  <div class="page-head">
    <h1><%= __(contract.unit_label || __('وحدة')) %></h1>
    <span class="badge badge--stage-<%= __(described.stage) %>"><%= __(stageLabels[described.stage]) %></span>
  </div>
  <dl class="details">
    <dt><%= __("المكتب") %></dt><dd><%= __(link.office_name) %></dd>
    <% if (contract.building_name) { %><dt><%= __("المبنى") %></dt><dd><%= __(contract.building_name) %></dd><% } %>
    <dt><%= __("البداية") %></dt><dd><span dir="ltr"><%= __(contract.start_date) %></span> <span class="muted nowrap">(<%= __(described.hijri.start) %> <%= __("تقريبي)") %></span></dd>
    <dt><%= __("النهاية") %></dt><dd><span dir="ltr"><%= __(contract.end_date) %></span> <span class="muted nowrap">(<%= __(described.hijri.end) %> <%= __("تقريبي)") %></span></dd>
    <dt><%= __("الإيجار السنوي") %></dt><dd><%= __(Number(contract.annual_rent).toLocaleString('en-US', { minimumFractionDigits: 2 })) %> <%= __("ريال") %></dd>
    <dt><%= __("طريقة الدفع") %></dt><dd><%= __(frequencyLabels[contract.payment_frequency] || '—') %></dd>
  </dl>
  <% if (described.notStarted) { %><p class="muted"><%= __("لم يبدأ العقد بعد.") %></p><% } %>
</section>

<section class="card detail-card">
  <h2><%= __("المواعيد") %></h2>
  <ul class="deadlines">
    <li><span><%= __("آخر موعد لقرار التجديد") %></span><strong dir="ltr"><%= __(described.noticeDeadline) %></strong><span class="muted"><%= __(described.live ? (described.daysToNotice >= 0 ? `باقي ${described.daysToNotice} يوم` : `فات منذ ${-described.daysToNotice} يوم`) : '') %></span></li>
    <li><span><%= __("آخر موعد لطلب تغيير الإيجار") %></span><strong dir="ltr"><%= __(described.rentChangeDeadline) %></strong><span class="muted"><%= __(described.live ? (described.daysToRentChange >= 0 ? `باقي ${described.daysToRentChange} يوم` : `فات منذ ${-described.daysToRentChange} يوم`) : '') %></span></li>
    <li><span><%= __("نهاية العقد") %></span><strong dir="ltr"><%= __(contract.end_date) %></strong><span class="muted"><%= __(described.daysToEnd >= 0 ? `باقي ${described.daysToEnd} يوم` : __('انتهى')) %></span></li>
  </ul>
  <% if (described.policy.reason === 'riyadh_freeze') { %>
    <p class="flash flash--warning"><%= __("الإيجار مجمّد في الرياض حتى") %> <span dir="ltr"><%= __(described.policy.freezeUntil) %></span>: <%= __("لا يمكن رفع الإيجار عند التجديد، ويمكن فقط تخفيضه.") %></p>
  <% } %>
</section>

<section class="card detail-card" id="decision">
  <h2><%= __("قرارك بشأن التجديد") %></h2>
  <% if (decisions.length) { %>
    <p><%= __("آخر قرار:") %> <strong><%= __(decisionLabels[decisions[0].decision]) %></strong> <span class="muted" dir="ltr"><%= __(decisions[0].createdOn) %></span></p>
    <% if (decisions[0].note) { %><p class="pre-line muted"><%= __(decisions[0].note) %></p><% } %>
  <% } else { %>
    <p class="empty-state"><%= __("لم تسجل قراراً بعد. اختر قرارك ليعرفه المكتب قبل الموعد.") %></p>
  <% } %>
  <% if (described.live) { %>
    <form method="post" action="/landlord/contracts/<%= __(contract.id) %>/decision" novalidate>
      <div class="field">
        <label for="decision"><%= __("القرار") %></label>
        <select id="decision" name="decision" class="select" <%= __(errors.decision ? 'aria-invalid=true' : '') %>>
          <option value=""><%= __("اختر") %></option>
          <% Object.entries(decisionLabels).forEach(function ([key, label]) { %><option value="<%= __(key) %>" <%= __(values.decision === key ? 'selected' : '') %>><%= __(label) %></option><% }) %>
        </select>
        <% if (errors.decision) { %><p class="field-error"><%= __(errors.decision) %></p><% } %>
      </div>
      <div class="field">
        <label for="note"><%= __("ملاحظة للمكتب (اختياري)") %></label>
        <textarea id="note" name="note" class="textarea" maxlength="<%= __(noteMax) %>" rows="3" <%= __(errors.note ? 'aria-invalid=true' : '') %>><%= __(values.note) %></textarea>
        <p class="field-hint"><%= __("حتى") %> <%= __(noteMax) %> <%= __("حرفاً. لا تكتب أرقام هوية أو حسابات.") %></p>
        <% if (errors.note) { %><p class="field-error"><%= __(errors.note) %></p><% } %>
      </div>
      <button type="submit" class="btn btn--primary btn--block"><%= __("حفظ القرار") %></button>
    </form>
  <% } %>
</section>

<section class="card detail-card" id="payments">
  <div class="page-head">
    <h2><%= __("الدفعات") %> (<%= __(payments.length) %>)</h2>
    <a href="/landlord/contracts/<%= __(contract.id) %>/receipt" class="btn btn--secondary btn--small"><%= __("كشف قابل للطباعة") %></a>
  </div>
  <% if (payments.length) { %>
    <ul class="payments">
      <% payments.forEach(function (p, i) { %>
        <li class="payment">
          <%- include('_payment', { p: p, index: i, paymentLabels: paymentLabels }) %>
          <%- include('../partials/payment-entries', { p: p, base: `/landlord/contracts/${contract.id}/payments/${p.id}`, canRecord: true, undoable: undoable, fmt: fmt, methods: entryMethods, roleLabels: entryRoleLabels, today: today }) %>
          <% if (p.status === 'tenant_reported') { %>
            <p class="muted"><%= __("أبلغ المستأجر أنه دفع. هل وصلك المبلغ؟") %></p>
            <div class="button-row">
              <form method="post" action="/landlord/contracts/<%= __(contract.id) %>/payments/<%= __(p.id) %>/confirm"><button type="submit" class="btn btn--primary"><%= __("نعم، وصلني") %></button></form>
              <form method="post" action="/landlord/contracts/<%= __(contract.id) %>/payments/<%= __(p.id) %>/reject"><button type="submit" class="btn btn--secondary"><%= __("لم يصلني") %></button></form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="empty-state"><%= __("لا توجد دفعات لهذا العقد.") %></p>
  <% } %>
</section>

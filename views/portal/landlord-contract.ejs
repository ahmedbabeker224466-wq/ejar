<%- include('../partials/area-nav') %>
<p class="back-link"><a href="/landlord">→ صفحة المالك</a></p>
<% if (message) { %><div class="flash flash--success" role="status"><%= message %></div><% } %>

<section class="card detail-card">
  <div class="page-head">
    <h1><%= contract.unit_label || 'وحدة' %></h1>
    <span class="badge badge--stage-<%= described.stage %>"><%= stageLabels[described.stage] %></span>
  </div>
  <dl class="details">
    <dt>المكتب</dt><dd><%= link.office_name %></dd>
    <% if (contract.building_name) { %><dt>المبنى</dt><dd><%= contract.building_name %></dd><% } %>
    <dt>البداية</dt><dd><span dir="ltr"><%= contract.start_date %></span> <span class="muted nowrap">(<%= described.hijri.start %> تقريبي)</span></dd>
    <dt>النهاية</dt><dd><span dir="ltr"><%= contract.end_date %></span> <span class="muted nowrap">(<%= described.hijri.end %> تقريبي)</span></dd>
    <dt>الإيجار السنوي</dt><dd><%= Number(contract.annual_rent).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> ريال</dd>
    <dt>طريقة الدفع</dt><dd><%= frequencyLabels[contract.payment_frequency] || '—' %></dd>
  </dl>
  <% if (described.notStarted) { %><p class="muted">لم يبدأ العقد بعد.</p><% } %>
</section>

<section class="card detail-card">
  <h2>المواعيد</h2>
  <ul class="deadlines">
    <li><span>آخر موعد لقرار التجديد</span><strong dir="ltr"><%= described.noticeDeadline %></strong><span class="muted"><%= described.live ? (described.daysToNotice >= 0 ? `باقي ${described.daysToNotice} يوم` : `فات منذ ${-described.daysToNotice} يوم`) : '' %></span></li>
    <li><span>آخر موعد لطلب تغيير الإيجار</span><strong dir="ltr"><%= described.rentChangeDeadline %></strong><span class="muted"><%= described.live ? (described.daysToRentChange >= 0 ? `باقي ${described.daysToRentChange} يوم` : `فات منذ ${-described.daysToRentChange} يوم`) : '' %></span></li>
    <li><span>نهاية العقد</span><strong dir="ltr"><%= contract.end_date %></strong><span class="muted"><%= described.daysToEnd >= 0 ? `باقي ${described.daysToEnd} يوم` : 'انتهى' %></span></li>
  </ul>
  <% if (described.policy.reason === 'riyadh_freeze') { %>
    <p class="flash flash--warning">الإيجار مجمّد في الرياض حتى <span dir="ltr"><%= described.policy.freezeUntil %></span>: لا يمكن رفع الإيجار عند التجديد، ويمكن فقط تخفيضه.</p>
  <% } %>
</section>

<section class="card detail-card" id="decision">
  <h2>قرارك بشأن التجديد</h2>
  <% if (decisions.length) { %>
    <p>آخر قرار: <strong><%= decisionLabels[decisions[0].decision] %></strong> <span class="muted" dir="ltr"><%= decisions[0].createdOn %></span></p>
    <% if (decisions[0].note) { %><p class="pre-line muted"><%= decisions[0].note %></p><% } %>
  <% } else { %>
    <p class="empty-state">لم تسجل قراراً بعد. اختر قرارك ليعرفه المكتب قبل الموعد.</p>
  <% } %>
  <% if (described.live) { %>
    <form method="post" action="/landlord/contracts/<%= contract.id %>/decision" novalidate>
      <div class="field">
        <label for="decision">القرار</label>
        <select id="decision" name="decision" class="select" <%= errors.decision ? 'aria-invalid=true' : '' %>>
          <option value="">اختر</option>
          <% Object.entries(decisionLabels).forEach(function ([key, label]) { %><option value="<%= key %>" <%= values.decision === key ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
        <% if (errors.decision) { %><p class="field-error"><%= errors.decision %></p><% } %>
      </div>
      <div class="field">
        <label for="note">ملاحظة للمكتب (اختياري)</label>
        <textarea id="note" name="note" class="textarea" maxlength="<%= noteMax %>" rows="3" <%= errors.note ? 'aria-invalid=true' : '' %>><%= values.note %></textarea>
        <p class="field-hint">حتى <%= noteMax %> حرفاً. لا تكتب أرقام هوية أو حسابات.</p>
        <% if (errors.note) { %><p class="field-error"><%= errors.note %></p><% } %>
      </div>
      <button type="submit" class="btn btn--primary btn--block">حفظ القرار</button>
    </form>
  <% } %>
</section>

<section class="card detail-card" id="payments">
  <div class="page-head">
    <h2>الدفعات (<%= payments.length %>)</h2>
    <a href="/landlord/contracts/<%= contract.id %>/receipt" class="btn btn--secondary btn--small">كشف قابل للطباعة</a>
  </div>
  <% if (payments.length) { %>
    <ul class="payments">
      <% payments.forEach(function (p, i) { %>
        <li class="payment">
          <%- include('_payment', { p: p, index: i, paymentLabels: paymentLabels }) %>
          <%- include('../partials/payment-entries', { p: p, base: `/landlord/contracts/${contract.id}/payments/${p.id}`, canRecord: true, undoable: undoable, fmt: fmt, methods: entryMethods, roleLabels: entryRoleLabels, today: today }) %>
          <% if (p.status === 'tenant_reported') { %>
            <p class="muted">أبلغ المستأجر أنه دفع. هل وصلك المبلغ؟</p>
            <div class="button-row">
              <form method="post" action="/landlord/contracts/<%= contract.id %>/payments/<%= p.id %>/confirm"><button type="submit" class="btn btn--primary">نعم، وصلني</button></form>
              <form method="post" action="/landlord/contracts/<%= contract.id %>/payments/<%= p.id %>/reject"><button type="submit" class="btn btn--secondary">لم يصلني</button></form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="empty-state">لا توجد دفعات لهذا العقد.</p>
  <% } %>
</section>

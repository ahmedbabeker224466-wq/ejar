<div class="page-head">
  <h1>مهام المكتب</h1>
  <a href="/office/tasks<%= assignee === 'me' ? '' : '?assignee=me' %>" class="btn btn--secondary btn--small"><%= assignee === 'me' ? 'عرض الكل' : 'مهامي فقط' %></a>
</div>
<% if (message) { %><div class="flash flash--success" role="status"><%= message %></div><% } %>

<details class="card detail-card" <%= Object.keys(errors).length ? 'open' : '' %>>
  <summary><strong>إضافة مهمة</strong></summary>
  <%- include('../partials/task-form', { action: '/office/tasks', values: values, errors: errors, members: members, linkTypes: linkTypes, limits: limits, submit: 'حفظ المهمة' }) %>
</details>

<div class="kanban">
  <% ['todo', 'doing', 'done'].forEach(function (col) { %>
    <section class="kanban__col card" aria-labelledby="col-<%= col %>">
      <h2 id="col-<%= col %>"><%= statuses[col] %> <span class="badge badge--calm"><%= columns[col].length %></span></h2>
      <% if (columns[col].length === 0) { %>
        <p class="empty-state"><%= col === 'todo' ? 'لا توجد مهام. أضف أول مهمة.' : 'لا شيء هنا.' %></p>
      <% } else { %>
        <ul class="item-list">
          <% columns[col].forEach(function (t) { %>
            <li class="item">
              <div class="item__title">
                <a href="/office/tasks/<%= t.id %>"><%= t.title %></a>
                <% if (t.overdue) { %><span class="badge badge--prio-high">متأخرة</span><% } %>
              </div>
              <p class="item__meta">
                <%= t.assigneeLabel ? `المسؤول: ${t.assigneeLabel}` : 'بدون مسؤول' %>
                <% if (t.due) { %> · الاستحقاق <span dir="ltr"><%= t.due %></span><% } %>
                <% if (t.linkLabel) { %> · <a href="<%= t.linkUrl %>"><%= t.linkLabel %> <%= t.entity_id %></a><% } %>
              </p>
              <div class="button-row">
                <% next[col].forEach(function (n) { %>
                  <form method="post" action="/office/tasks/<%= t.id %>/status"><input type="hidden" name="status" value="<%= n[0] %>"><button type="submit" class="btn btn--secondary btn--small"><%= n[1] %></button></form>
                <% }) %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
</div>

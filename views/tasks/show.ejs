<p class="back-link"><a href="/office/tasks"><%= dir === 'rtl' ? '→' : '←' %> <%= __("كل المهام") %></a></p>
<% if (message) { %><div class="flash flash--success" role="status"><%= __(message) %></div><% } %>

<section class="card detail-card">
  <div class="page-head">
    <h1><%= __("مهمة رقم") %> <%= __(task.id) %></h1>
    <span class="badge badge--maint-<%= __(task.status === 'done' ? 'done' : task.status === 'doing' ? 'in_progress' : 'new') %>"><%= __(task.statusLabel) %></span>
  </div>
  <dl class="details">
    <dt><%= __("المسؤول") %></dt><dd><%= __(task.assigneeLabel || __('بدون مسؤول')) %></dd>
    <dt><%= __("الاستحقاق") %></dt><dd><% if (task.due) { %><span dir="ltr"><%= __(task.due) %></span><% if (task.overdue) { %> <span class="badge badge--prio-high"><%= __("متأخرة") %></span><% } %><% } else { %>—<% } %></dd>
    <% if (task.linkLabel) { %><dt><%= __("مرتبطة بـ") %></dt><dd><a href="<%= __(task.linkUrl) %>"><%= __(task.linkLabel) %> <%= __(task.entity_id) %></a></dd><% } %>
    <% if (task.creatorLabel) { %><dt><%= __("أنشأها") %></dt><dd><%= __(task.creatorLabel) %></dd><% } %>
  </dl>
  <div class="button-row">
    <% next[task.status].forEach(function (n) { %>
      <form method="post" action="/office/tasks/<%= __(task.id) %>/status"><input type="hidden" name="status" value="<%= __(n[0]) %>"><input type="hidden" name="back" value="task"><button type="submit" class="btn btn--secondary"><%= __(n[1]) %></button></form>
    <% }) %>
  </div>
</section>

<section class="card detail-card">
  <h2><%= __("تعديل المهمة") %></h2>
  <%- include('../partials/task-form', { action: '/office/tasks/' + task.id, values: values, errors: errors, members: members, linkTypes: linkTypes, limits: limits, submit: __('حفظ التعديلات') }) %>
</section>

<section class="card detail-card" id="comments">
  <h2><%= __("التعليقات") %></h2>
  <% if (comments.length) { %>
    <ul class="thread">
      <% comments.forEach(function (c) { %>
        <li class="thread__item"><p class="thread__head"><strong><%= __(c.author) %></strong> <span class="muted" dir="ltr"><%= __(c.at) %></span></p><p class="pre-line"><%= __(c.body) %></p></li>
      <% }) %>
    </ul>
  <% } else { %><p class="empty-state"><%= __("لا توجد تعليقات بعد.") %></p><% } %>
  <form method="post" action="/office/tasks/<%= __(task.id) %>/comments" novalidate>
    <div class="field">
      <label for="body"><%= __("تعليق") %></label>
      <textarea id="body" name="body" class="textarea" rows="3" maxlength="<%= __(limits.comment) %>" required></textarea>
      <% if (commentError) { %><p class="field-error"><%= __(commentError) %></p><% } %>
    </div>
    <button type="submit" class="btn btn--primary btn--block"><%= __("إضافة التعليق") %></button>
  </form>
</section>

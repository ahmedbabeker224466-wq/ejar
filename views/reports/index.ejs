<div class="page-head"><h1><%= __("التقارير") %></h1></div>
<% if (range.error) { %><div class="flash flash--danger" role="alert"><%= __(range.error) %> <%= __("عرضنا المدة الافتراضية.") %></div><% } %>

<form class="card filter-bar" method="get" action="/office/reports">
  <p class="muted"><%= __("تنطبق المدة على: المتأخرات والمحصّل والصيانة وعبء العمل.") %></p>
  <div class="filter-grid">
    <div class="field"><label for="from"><%= __("من") %></label><input id="from" name="from" class="input" type="date" value="<%= __(range.from) %>" max="<%= __(today) %>"></div>
    <div class="field"><label for="to"><%= __("إلى") %></label><input id="to" name="to" class="input" type="date" value="<%= __(range.to) %>"></div>
  </div>
  <button type="submit" class="btn btn--secondary btn--block"><%= __("عرض") %></button>
</form>

<%# 1. occupancy %>
<section class="card detail-card" id="occupancy">
  <div class="page-head"><h2><%= __(meta.occupancy.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/occupancy?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const occ = results.occupancy; %>
  <% if (occ.data.length === 0) { %><p class="empty-state"><%= __("لا توجد وحدات بعد.") %></p><% } else { %>
    <p class="lead"><%= __("نسبة الإشغال العامة") %> <strong><%= __(occ.totals.percent) %>%</strong> (<%= __(occ.totals.rented) %> <%= __("من") %> <%= __(occ.totals.total) %> <%= __("وحدة)") %></p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= __("المبنى") %></th><th><%= __("الوحدات") %></th><th><%= __("مؤجرة") %></th><th><%= __("شاغرة") %></th><th><%= __("صيانة") %></th><th><%= __("الإشغال") %></th></tr></thead>
      <tbody><% occ.data.forEach(function (r) { %><tr><td><%= __(r.building) %></td><td><%= __(r.total) %></td><td><%= __(r.rented) %></td><td><%= __(r.vacant) %></td><td><%= __(r.maintenance) %></td><td><%= __(r.percent) %>%</td></tr><% }) %></tbody>
    </table></div>
  <% } %>
</section>

<%# 2. expiring %>
<section class="card detail-card" id="expiring">
  <div class="page-head"><h2><%= __(meta.expiring.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/expiring?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const exp = results.expiring; %>
  <div class="units-summary">
    <% buckets.forEach(function (b) { %><div class="mini-stat"><strong><%= __(exp.counts[b.key]) %></strong> <%= __(b.label) %></div><% }) %>
  </div>
  <% if (exp.data.length === 0) { %><p class="empty-state"><%= __("لا توجد عقود تنتهي خلال 90 يوماً.") %></p><% } else { %>
    <ul class="item-list">
      <% exp.data.forEach(function (r) { %>
        <li class="item"><div class="item__title"><a href="/office/contracts/<%= __(r.id) %>"><%= __(r.unit || __('وحدة')) %></a> <span class="badge badge--stage-<%= __(r.bucket === 30 ? 'urgent' : r.bucket === 60 ? 'soon' : 'calm') %>"><%= __("باقي") %> <%= __(r.days) %> <%= __("يوم") %></span></div><p class="item__meta"><%= __("المالك:") %> <%= __(r.landlord || '—') %> · <%= __("النهاية") %> <span dir="ltr"><%= __(r.end) %></span></p></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%# 3. overdue %>
<section class="card detail-card" id="overdue">
  <div class="page-head"><h2><%= __(meta.overdue.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/overdue?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const od = results.overdue; %>
  <% if (od.data.length === 0) { %><p class="empty-state"><%= __("لا توجد دفعات متأخرة في هذه المدة.") %></p><% } else { %>
    <p class="lead"><strong><%= __(od.totals.count) %></strong> <%= __("دفعة متأخرة، المتبقي") %> <strong><%= __(fmt(od.totals.remaining)) %></strong> <%= __("ريال.") %></p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= __("الوحدة") %></th><th><%= __("الاستحقاق") %></th><th><%= __("التأخر") %></th><th><%= __("المتبقي") %></th></tr></thead>
      <tbody><% od.data.slice(0, 20).forEach(function (r) { %><tr><td><%= __(r.unit_label || '—') %></td><td dir="ltr"><%= __(String(r.due_date).slice(0, 10)) %></td><td><%= __(r.daysOverdue) %> <%= __("يوم") %></td><td><%= __(fmt(r.remainingHalalas)) %></td></tr><% }) %></tbody>
    </table></div>
    <% if (od.data.length > 20) { %><p class="muted"><%= __("عرضنا أول 20.") %> <a href="/office/payments"><%= __("كل المتأخرات") %></a> <%= __("أو صدّر الملف.") %></p><% } %>
  <% } %>
</section>

<%# 4. collections %>
<section class="card detail-card" id="collections">
  <div class="page-head"><h2><%= __(meta.collections.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/collections?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const col = results.collections; %>
  <% if (col.data.length === 0) { %><p class="empty-state"><%= __("لا توجد دفعات في هذه المدة.") %></p><% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= __("الشهر") %></th><th><%= __("المتوقع") %></th><th><%= __("المحصّل") %></th><th><%= __("النسبة") %></th></tr></thead>
      <tbody><% col.data.forEach(function (m) { %><tr><td dir="ltr"><%= __(m.month) %></td><td><%= __(fmt(m.expected)) %></td><td><%= __(fmt(m.collected)) %></td><td><%= __(m.percent === null ? '—' : m.percent + '%') %></td></tr><% }) %></tbody>
      <tfoot><tr><th><%= __("المجموع") %></th><th><%= __(fmt(col.totals.expected)) %></th><th><%= __(fmt(col.totals.collected)) %></th><th></th></tr></tfoot>
    </table></div>
    <p class="muted"><%= __("المبالغ بالريال. المتوقع حسب تاريخ الاستحقاق، والمحصّل حسب تاريخ الدفع.") %></p>
  <% } %>
</section>

<%# 5. maintenance %>
<section class="card detail-card" id="maintenance">
  <div class="page-head"><h2><%= __(meta.maintenance.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/maintenance?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const mt = results.maintenance; %>
  <% if (mt.total === 0) { %><p class="empty-state"><%= __("لا توجد طلبات صيانة في هذه المدة.") %></p><% } else { %>
    <p class="lead"><strong><%= __(mt.total) %></strong> <%= __("طلب في هذه المدة.") %></p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= __("الحالة") %></th><% Object.values(categories).forEach(function (c) { %><th><%= __(c) %></th><% }) %></tr></thead>
      <tbody><% Object.entries(statuses).forEach(function ([status, label]) { %><tr><td><%= __(label) %></td><% Object.keys(categories).forEach(function (c) { %><td><%= __(mt.data[status][c]) %></td><% }) %></tr><% }) %></tbody>
    </table></div>
  <% } %>
</section>

<%# 6. workload %>
<section class="card detail-card" id="workload">
  <div class="page-head"><h2><%= __(meta.workload.title) %></h2><a class="btn btn--secondary btn--small" href="/office/reports/csv/workload?<%= __(csvQuery) %>"><%= __("تصدير") %> CSV</a></div>
  <% const wl = results.workload; %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><%= __("العضو") %></th><th><%= __("صيانة مفتوحة") %></th><th><%= __("صيانة أُنجزت") %></th><th><%= __("مهام مفتوحة") %></th><th><%= __("متأخرة") %></th><th><%= __("أُنجزت") %></th></tr></thead>
    <tbody><% wl.data.forEach(function (r) { %><tr><td><%= __(r.name) %> <span class="muted">(<%= __(r.role) %>)</span></td><td><%= __(r.maintOpen) %></td><td><%= __(r.maintDone) %></td><td><%= __(r.tasksOpen) %></td><td><%= __(r.tasksOverdue) %></td><td><%= __(r.tasksDone) %></td></tr><% }) %></tbody>
  </table></div>
</section>

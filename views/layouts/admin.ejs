<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> | إدارة المنصة | عقدي</title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0f766e">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
  <script src="<%= assetUrl('/js/office.js') %>" defer></script>
</head>
<body class="office-body">
  <%- include('../partials/platform-banner') %>
  <header class="office-top">
    <button type="button" class="office-menu-btn" id="office-menu-toggle" aria-controls="office-nav" aria-expanded="false">
      <span class="office-menu-btn__bars" aria-hidden="true"></span>
      <span class="visually-hidden">القائمة</span>
    </button>
    <div class="office-top__title">
      <a href="/admin" class="office-top__name">إدارة المنصة</a>
      <div class="office-top__user"><span class="office-top__user-name" dir="auto"><%= userDisplay %></span></div>
    </div>
    <%- include('../partials/bell') %>
    <a href="/logout" class="btn btn--secondary btn--small">خروج</a>
  </header>
  <div class="office-shell">
    <nav id="office-nav" class="office-nav" aria-label="قائمة الإدارة">
      <ul>
        <% adminNav.forEach(function (item) { %>
          <li><a href="<%= item.href %>" <%- item.current ? 'aria-current="page"' : '' %>><%= item.label %></a></li>
        <% }) %>
      </ul>
    </nav>
    <div class="office-backdrop" id="office-backdrop" hidden></div>
    <main class="office-main">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
  <footer class="office-footer"><p class="disclaimer">تطبيق خاص غير تابع لمنصة إيجار، والتواريخ للتذكير فقط</p></footer>
</body>
</html>

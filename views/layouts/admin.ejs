<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= __(title) %> | <%= __("إدارة المنصة") %> | <%= __("ميعاد") %></title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0f1b3d">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@800&text=miaad&display=swap">
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
  <script src="<%= assetUrl('/js/office.js') %>" defer></script>
  <script src="<%= assetUrl('/js/admin.js') %>" defer></script>
</head>
<body class="office-body">
  <%- include('../partials/platform-banner') %>
  <header class="office-top">
    <button type="button" class="office-menu-btn" id="office-menu-toggle" aria-controls="office-nav" aria-expanded="false">
      <span class="office-menu-btn__bars" aria-hidden="true"></span>
      <span class="visually-hidden"><%= __("القائمة") %></span>
    </button>
    <div class="office-top__title">
      <a href="/admin" class="office-top__name"><%= __("إدارة المنصة") %></a>
      <div class="office-top__user"><span class="office-top__user-name" dir="auto"><%= __(userDisplay) %></span></div>
    </div>
    <%- include('../partials/lang-switch') %>
    <%- include('../partials/bell') %>
    <a href="/logout" class="btn btn--secondary btn--small"><%= __("خروج") %></a>
  </header>
  <div class="office-shell">
    <nav id="office-nav" class="office-nav" aria-label="<%= __("قائمة الإدارة") %>">
      <div class="office-nav__brand"><span class="office-nav__mark" aria-hidden="true"><%- include('../partials/brand-mark', { bid: 'adm' }) %></span><span class="brand-word" lang="en" dir="ltr">miaad</span></div>
      <% const navIcons = {
        dashboard:'<rect x="3" y="3" width="7.5" height="9" rx="2"/><rect x="13.5" y="3" width="7.5" height="5.5" rx="2"/><rect x="13.5" y="11.5" width="7.5" height="9.5" rx="2"/><rect x="3" y="15" width="7.5" height="6" rx="2"/>',
        offices:'<path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16M16 9h3a2 2 0 0 1 2 2v10"/><path d="M8.5 7h3M8.5 11h3M8.5 15h3"/>',
        transfers:'<path d="M3 10h18M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 21h18M12 3l9 5H3z"/>',
        reports:'<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>',
        messages:'<path d="M4 5h16v11H9l-5 4z"/>',
        domains:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
        orders:'<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M7 15h3"/>',
        plans:'<path d="M12 3 3 7.5 12 12l9-4.5z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/>',
        promos:'<path d="M20.5 13.5 13.5 20.5a2 2 0 0 1-2.8 0L3 12.8V3h9.8l7.7 7.7a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
        blog:'<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>',
        settings:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',
        launch:'<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M14 4c3-1 6-1 6-1s0 3-1 6l-7 7-5-5z"/><circle cx="15" cy="9" r="1.5"/>',
        ops:'<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
        audit:'<path d="M9 3h6l1 2h3v16H5V5h3z"/><path d="M9 11h6M9 15h4"/>',
        staff:'<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 11l2 2 4-4"/>',
        security:'<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="M9 12l2 2 4-4"/>'
      }; %>
      <% adminNavGroups.forEach(function (group) { %>
        <% if (group.title) { %><p class="adm-nav__group"><%= __(group.title) %></p><% } %>
        <ul>
          <% group.items.forEach(function (item) { %>
            <li><a href="<%= __(item.href) %>" <%- item.current ? 'aria-current="page"' : '' %>><svg class="office-nav__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- navIcons[item.key] || '' %></svg><span><%= __(item.label) %></span><% if (item.pending) { %><span class="adm-nav__count" aria-label="<%= __("بانتظار الإجراء") %>"><%= __(item.pending) %></span><% } %></a></li>
          <% }) %>
        </ul>
      <% }) %>
    </nav>
    <div class="office-backdrop" id="office-backdrop" hidden></div>
    <main class="office-main">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
</body>
</html>

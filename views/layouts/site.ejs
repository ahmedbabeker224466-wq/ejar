<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const pageTitle = locals.metaTitle || title; const brand = t('brand'); const pageDescription = locals.metaDescription || t('meta.homeDescription'); %>
  <title><%= pageTitle %><%= pageTitle.indexOf(brand) === 0 ? '' : ' | ' + brand %></title>
  <meta name="description" content="<%= pageDescription %>">
  <meta name="robots" content="<%= locals.indexable ? 'index,follow' : 'noindex,nofollow' %>">
  <meta name="theme-color" content="#1b6af5">
  <% if (locals.canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>
  <% if (locals.hreflang && locals.canonicalUrl) { const origin = canonicalUrl.replace(/^(https?:\/\/[^\/]+).*$/, '$1'); %>
  <link rel="alternate" hreflang="ar" href="<%= origin + hreflang.ar %>">
  <link rel="alternate" hreflang="en" href="<%= origin + hreflang.en %>">
  <link rel="alternate" hreflang="x-default" href="<%= origin + hreflang.ar %>">
  <% } %>
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'ar_SA' %>">
  <meta property="og:site_name" content="<%= brand %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <% if (locals.canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <meta name="twitter:card" content="<%= locals.ogImage ? 'summary_large_image' : 'summary' %>">
  <% if (locals.rssUrl) { %><link rel="alternate" type="application/rss+xml" title="<%= t('footer.blog') %>" href="<%= rssUrl %>"><% } %>
  <% if (locals.jsonLd) { %><script type="application/ld+json"><%- jsonLd %></script><% } %>
  <link rel="icon" href="<%= assetUrl('/favicon.svg') %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap">
  <% if (locals.mkStd) { %><link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>"><% } %>
  <link rel="stylesheet" href="<%= assetUrl('/css/site.css') %>">
  <% if (locals.indexable && locals.analyticsSnippet) { %><%- analyticsSnippet %><% } %>
</head>
<body class="mk">
  <%- include('../partials/platform-banner') %>
  <%- include('../site/_mk-header') %>
  <main id="main">
    <% if (locals.mkStd) { %>
    <div class="mk-std"><div class="mk-wrap mk-std__inner">
      <%- include('../partials/flash') %>
      <%- body %>
    </div></div>
    <% } else { %>
    <%- include('../partials/flash') %>
    <%- body %>
    <% } %>
  </main>
  <%- include('../site/_mk-footer') %>
</body>
</html>

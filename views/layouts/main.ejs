<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const pageTitle = locals.metaTitle || title; const pageDescription = locals.metaDescription || __('منصة ميعاد لمكاتب العقار: متابعة عقود الإيجار ومواعيدها وتذكير الملاك والمستأجرين.'); %>
  <title><%= __(pageTitle) %><%= __(pageTitle === 'ميعاد' ? '' : __(' | ميعاد')) %></title>
  <meta name="description" content="<%= __(pageDescription) %>">
  <meta name="robots" content="<%= __(locals.indexable ? 'index,follow' : 'noindex,nofollow') %>">
  <meta name="theme-color" content="#0f766e">
  <% if (locals.canonicalUrl) { %><link rel="canonical" href="<%= __(canonicalUrl) %>"><% } %>

  <meta property="og:type" content="<%= __(locals.ogType || 'website') %>">
  <meta property="og:locale" content="ar_SA">
  <meta property="og:site_name" content="<%= __("ميعاد") %>">
  <meta property="og:title" content="<%= __(pageTitle) %>">
  <meta property="og:description" content="<%= __(pageDescription) %>">
  <% if (locals.canonicalUrl) { %><meta property="og:url" content="<%= __(canonicalUrl) %>"><% } %>
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= __(ogImage) %>"><% } %>
  <meta name="twitter:card" content="<%= __(locals.ogImage ? 'summary_large_image' : 'summary') %>">
  <% if (locals.rssUrl) { %><link rel="alternate" type="application/rss+xml" title="<%= __("مدونة ميعاد") %>" href="<%= __(rssUrl) %>"><% } %>
  <% if (locals.jsonLd) { %><script type="application/ld+json"><%- jsonLd %></script><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@800&text=miaad&display=swap">
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
  <% if (locals.indexable && locals.analyticsSnippet) { %><%- analyticsSnippet %><% } %>
</head>
<body class="app-body">
  <%- include('../partials/platform-banner') %>
  <%- include('../partials/header') %>
  <main class="container page">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>

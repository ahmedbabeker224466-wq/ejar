<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %><%= title === 'عقدي' ? '' : ' | عقدي' %></title>
  <meta name="description" content="منصة عقدي لمكاتب العقار: متابعة عقود الإيجار ومواعيدها وتذكير الملاك والمستأجرين.">
  <meta name="theme-color" content="#0f766e">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="ar_SA">
  <meta property="og:site_name" content="عقدي">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="منصة عقدي لمكاتب العقار: متابعة عقود الإيجار ومواعيدها وتذكير الملاك والمستأجرين.">
  <% if (appUrl) { %><meta property="og:url" content="<%= appUrl + currentPath %>"><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container page">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>

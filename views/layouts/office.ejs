<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= __(title) %> | <%= __(office.name) %> | <%= __("ميعاد") %></title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0f1d45">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@800&text=miaad&display=swap">
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
  <script src="<%= assetUrl('/js/office.js') %>" defer></script>
</head>
<body class="office-body">
  <%- include('../partials/platform-banner') %>
  <header class="office-top">
    <button type="button" class="office-menu-btn" id="office-menu-toggle" aria-controls="office-nav" aria-expanded="false">
      <span class="office-menu-btn__bars" aria-hidden="true"></span>
      <span class="visually-hidden"><%= __("القائمة") %></span>
    </button>
    <div class="office-top__title">
      <a href="/office" class="office-top__name"><bdi><%= __(office.name) %></bdi></a>
      <div class="office-top__user">
        <span class="office-top__user-name" dir="auto"><%= __(userDisplay) %></span>
        <span class="badge badge--role"><%= __(roleLabel) %></span>
      </div>
    </div>
    <%- include('../partials/lang-switch') %>
    <%- include('../partials/bell') %>
    <a href="/logout" class="btn btn--secondary btn--small"><%= __("خروج") %></a>
  </header>

  <% if (access.onTrial) { %>
    <div class="office-banner office-banner--info" role="status">
      <%= __(access.trialDaysLeft === 0 ? __('تجربتك المجانية تنتهي اليوم') : `تجربتك المجانية تنتهي بعد ${access.trialDaysLeft} يوم`) %>
      <% if (can('billing')) { %><a href="/office/billing"><%= __("اشترك الآن") %></a><% } %>
    </div>
  <% } else if (access.readOnly) { %>
    <div class="office-banner office-banner--danger" role="alert">
      <%= __("انتهى اشتراك المكتب: الحساب في وضع القراءة فقط وسيتوقف بعد") %> <%= __(access.graceDaysLeft) %> <%= __("يوم.") %>
      <% if (can('billing')) { %><a href="/office/billing"><%= __("جدّد الاشتراك") %></a><% } %>
    </div>
  <% } else if (access.pastDue) { %>
    <div class="office-banner office-banner--danger" role="alert">
      <%= __("لم يُسدَّد اشتراك المكتب. سدّد الاشتراك حتى لا يتوقف الحساب.") %>
      <% if (can('billing')) { %><a href="/office/billing"><%= __("سداد الاشتراك") %></a><% } %>
    </div>
  <% } %>

  <div class="office-shell">
    <% const navIcons = {home:'<path d="M3 11 12 4l9 7v9H5v-9"/>',contracts:'<rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/>',landlords:'<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/>',units:'<path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M10 21v-5h4v5"/>',tenants:'<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5"/>',payments:'<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M7 15h3"/>',accounting:'<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',leads:'<path d="M3 5h18l-7 8v6l-4 2v-8z"/>',maintenance:'<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>',listings:'<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',reports:'<path d="M21 12a9 9 0 1 1-9-9v9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>',messages:'<path d="M4 5h16v11H9l-5 4z"/>',tasks:'<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/>',team:'<circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M2.5 19a5.5 5.5 0 0 1 11 0M10.5 19a5.5 5.5 0 0 1 11 0"/>',audit:'<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="M9 12l2 2 4-4"/>',settings:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',billing:'<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/>'}; const newItems = ['accounting', 'leads']; %>
    <nav id="office-nav" class="office-nav" aria-label="<%= __("قائمة المكتب") %>">
      <div class="office-nav__brand"><span class="office-nav__mark" aria-hidden="true"><%- include('../partials/brand-mark', { bid: 'o' }) %></span><span class="brand-word" lang="en" dir="ltr">miaad</span></div>
      <ul>
        <% officeNav.forEach(function (item) { %>
          <li><a href="<%= __(item.href) %>" <%- item.current ? 'aria-current="page"' : '' %>><svg class="office-nav__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- navIcons[item.key] || '' %></svg><span><%= __(item.label) %></span><% if (newItems.includes(item.key)) { %><span class="office-nav__new"><%= __("جديد") %></span><% } %></a></li>
        <% }) %>
      </ul>
    </nav>
    <div class="office-backdrop" id="office-backdrop" hidden></div>
    <main class="office-main">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>

  <footer class="office-footer">
    <p class="disclaimer"><%= __("تطبيق خاص غير تابع لمنصة إيجار، والتواريخ للتذكير فقط") %></p>
  </footer>
</body>
</html>
